<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Waypoint.MapViewer</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <!-- Built from the selected checkout into Waypoint's cache; no server project or game data ships with Waypoint. -->
    <Reference Include="$(MapGeneratorDirectory)/*.dll" />
    <Compile Include="MapViewer.cs;MapSpawnCatalog.cs" />
  </ItemGroup>
  <Target Name="CheckMapGenerator" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(MapGeneratorDirectory)/GameServer.Data.dll')" Text="MapGeneratorDirectory must point to the selected checkout's built GameServer.Data library." />
  </Target>
</Project>
