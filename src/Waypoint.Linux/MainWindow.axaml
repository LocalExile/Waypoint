<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:l="clr-namespace:Waypoint"
        x:Class="Waypoint.MainWindow" Title="Waypoint" Width="1180" Height="760" MinWidth="820" MinHeight="520">
  <Grid ColumnDefinitions="210,*">
    <Border Background="{DynamicResource Shell.Sidebar}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Waypoint" FontSize="21" FontWeight="Bold" Margin="16,14,0,12" Foreground="{DynamicResource Shell.SidebarStrong}" />
        <!-- The LocalExile folder everything below works on, and the way to the others (FolderPicker). -->
        <l:FolderPicker x:Name="Folders" DockPanel.Dock="Top" Margin="10,0,10,10" />
        <TextBlock x:Name="VersionText" DockPanel.Dock="Bottom" Margin="16,0,0,10" FontSize="11" Foreground="{DynamicResource Shell.SidebarText}" />
        <Border x:Name="ModeSwitch" DockPanel.Dock="Bottom" Margin="12,0,12,10" IsVisible="False">
          <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
            <RadioButton x:Name="SimpleMode" GroupName="Mode" Foreground="{DynamicResource Shell.SidebarText}" IsCheckedChanged="ModeChosen" />
            <RadioButton x:Name="AdvancedMode" GroupName="Mode" Foreground="{DynamicResource Shell.SidebarText}" IsCheckedChanged="ModeChosen" />
          </StackPanel>
        </Border>
        <ListBox x:Name="Sections" Classes="sections" Background="Transparent" Margin="6,0" SelectionChanged="SectionChanged">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <icons:MaterialIcon Kind="{Binding Icon}" Width="18" Height="18" />
                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
    <DockPanel Grid.Column="1">
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="22,16,22,10">
        <TextBlock x:Name="SectionTitle" FontSize="20" FontWeight="SemiBold" />
        <Border x:Name="BranchChip" Grid.Column="1" Background="{DynamicResource Shell.Cell}" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
          <TextBlock x:Name="BranchName" FontSize="12" Foreground="{DynamicResource Shell.TextSecondary}" />
        </Border>
      </Grid>
      <Border x:Name="StatusStrip" DockPanel.Dock="Bottom" Background="{DynamicResource Shell.Panel}" Padding="14,6">
        <DockPanel>
          <ItemsControl x:Name="Lights">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="14" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding Shown}" ToolTip.Tip="{Binding Tip}">
                  <Ellipse Width="9" Height="9" Fill="{Binding Lamp}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Name}" FontSize="12" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock x:Name="StatusText" HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource Shell.TextSecondary}" />
        </DockPanel>
      </Border>
      <Panel x:Name="SectionHost" Margin="22,0,22,14" />
    </DockPanel>
    <!-- A newer release: cards floating over the bottom of the whole window, as on Windows (Updates.cs for Waypoint, whose
         AppImage replaces itself, LocalExileReleases for a release install). -->
    <StackPanel Grid.ColumnSpan="2" VerticalAlignment="Bottom">
    <Border x:Name="ExileUpdateBar" Margin="14,0,14,14" IsVisible="False" Background="{DynamicResource Shell.UpdateBack}" BorderBrush="{DynamicResource Shell.UpdateBorder}"
            BorderThickness="1" CornerRadius="8" Padding="16,12" BoxShadow="0 3 18 0 #4C000000">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button x:Name="ExileUpdateNow" Click="ExileUpdateClicked" Background="{DynamicResource Shell.UpdateAccent}" Foreground="White">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <icons:MaterialIcon Kind="Download" Width="16" Height="16" />
              <TextBlock Text="{l:Loc 'Update now'}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Content="{l:Loc 'What\'s new'}" Click="ExilePageClicked" Foreground="{DynamicResource Shell.UpdateText}" />
          <Button x:Name="ExileLater" Content="{l:Loc 'Later'}" Click="ExileLaterClicked" Foreground="{DynamicResource Shell.UpdateText}" />
        </StackPanel>
        <Grid DockPanel.Dock="Left" Width="34" Height="34" Margin="0,0,12,0" VerticalAlignment="Center">
          <Ellipse Fill="{DynamicResource Shell.UpdateAccent}" />
          <icons:MaterialIcon Kind="ArrowUpBold" Width="20" Height="20" Foreground="White" />
        </Grid>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{l:Loc 'A new version of LocalExile is ready'}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Shell.UpdateText}" />
          <TextBlock x:Name="ExileUpdateText" TextWrapping="Wrap" Opacity="0.85" Margin="0,1,0,0" Foreground="{DynamicResource Shell.UpdateText}" />
        </StackPanel>
      </DockPanel>
    </Border>
    <Border x:Name="UpdateBar" Margin="14,0,14,14" IsVisible="False" Background="{DynamicResource Shell.UpdateBack}" BorderBrush="{DynamicResource Shell.UpdateBorder}"
            BorderThickness="1" CornerRadius="8" Padding="16,12" BoxShadow="0 3 18 0 #4C000000">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button x:Name="UpdateNow" Click="UpdateClicked" Background="{DynamicResource Shell.UpdateAccent}" Foreground="White">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <icons:MaterialIcon Kind="Download" Width="16" Height="16" />
              <TextBlock Text="{l:Loc 'Update now'}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Content="{l:Loc 'What\'s new'}" Click="ReleasePageClicked" Foreground="{DynamicResource Shell.UpdateText}" />
          <Button x:Name="UpdateLater" Content="{l:Loc 'Later'}" Click="LaterClicked" Foreground="{DynamicResource Shell.UpdateText}" />
        </StackPanel>
        <Grid DockPanel.Dock="Left" Width="34" Height="34" Margin="0,0,12,0" VerticalAlignment="Center">
          <Ellipse Fill="{DynamicResource Shell.UpdateAccent}" />
          <icons:MaterialIcon Kind="ArrowUpBold" Width="20" Height="20" Foreground="White" />
        </Grid>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{l:Loc 'A new version of Waypoint is ready'}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Shell.UpdateText}" />
          <TextBlock x:Name="UpdateText" TextWrapping="Wrap" Opacity="0.85" Margin="0,1,0,0" Foreground="{DynamicResource Shell.UpdateText}" />
        </StackPanel>
      </DockPanel>
    </Border>
    </StackPanel>
  </Grid>
</Window>
