<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:l="clr-namespace:Waypoint"
             x:Class="Waypoint.ToolsTab">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
      <WrapPanel>
        <Border Classes="card" Width="340" Margin="0,0,14,14">
          <DockPanel>
            <Button x:Name="MapButton" Classes="accent" DockPanel.Dock="Bottom" HorizontalAlignment="Left" Margin="0,12,0,0" Click="OpenMapViewer"
                    Content="{l:Loc 'Open map viewer'}" ToolTip.ShowOnDisabled="True" />
            <icons:MaterialIcon DockPanel.Dock="Left" Kind="MapOutline" Width="36" Height="36" Margin="0,0,14,0" VerticalAlignment="Top"
                                Foreground="{DynamicResource Shell.Accent}" />
            <StackPanel>
              <TextBlock Text="{l:Loc 'Map viewer'}" FontSize="15" FontWeight="SemiBold" />
              <TextBlock Classes="note" Margin="0,4,0,0" Text="{l:Loc 'Inspect generated maps, tiles, walkability and points of interest.'}" />
            </StackPanel>
          </DockPanel>
        </Border>
        <!-- One card per tool. -->
        <Border Classes="card" Width="340" Margin="0,0,14,14">
          <DockPanel>
            <Button x:Name="CrafterButton" Classes="accent" DockPanel.Dock="Bottom" HorizontalAlignment="Left" Margin="0,12,0,0" Click="OpenItemCrafter" />
            <icons:MaterialIcon DockPanel.Dock="Left" Kind="Anvil" Width="36" Height="36" Margin="0,0,14,0" VerticalAlignment="Top"
                                Foreground="{DynamicResource Shell.Accent}" />
            <StackPanel>
              <TextBlock x:Name="CrafterTitle" FontSize="15" FontWeight="SemiBold" />
              <TextBlock x:Name="CrafterText" Classes="note" Margin="0,4,0,0" />
            </StackPanel>
          </DockPanel>
        </Border>
        <Border Classes="card" Width="340" Margin="0,0,14,14">
          <DockPanel>
            <Button Classes="accent" DockPanel.Dock="Bottom" HorizontalAlignment="Left" Margin="0,12,0,0" Click="OpenLabLayout"
                    Content="{l:Loc 'Open lab layout'}" />
            <icons:MaterialIcon DockPanel.Dock="Left" Kind="Sitemap" Width="36" Height="36" Margin="0,0,14,0" VerticalAlignment="Top"
                                Foreground="{DynamicResource Shell.Accent}" />
            <StackPanel>
              <TextBlock Text="{l:Loc 'Lab layout'}" FontSize="15" FontWeight="SemiBold" />
              <TextBlock Classes="note" Margin="0,4,0,0"
                         Text="{l:Loc 'The day\'s Labyrinth of every tier as a map: its rooms, the shortest way to Izaro, gauntlets, puzzles, Darkshrines, keys and doors.'}" />
            </StackPanel>
          </DockPanel>
        </Border>
        <!-- Simple mode's list has neither Console nor Logs: they open from here. Advanced mode lists both. -->
        <Border x:Name="ConsoleCard" Classes="card" IsVisible="False" Width="340" Margin="0,0,14,14">
          <DockPanel>
            <Button x:Name="ConsoleButton" DockPanel.Dock="Bottom" HorizontalAlignment="Left" Margin="0,12,0,0" Click="OpenConsole" />
            <icons:MaterialIcon DockPanel.Dock="Left" Kind="Console" Width="36" Height="36" Margin="0,0,14,0" VerticalAlignment="Top"
                                Foreground="{DynamicResource Shell.Accent}" />
            <StackPanel>
              <TextBlock x:Name="ConsoleTitle" FontSize="15" FontWeight="SemiBold" />
              <TextBlock x:Name="ConsoleText" Classes="note" Margin="0,4,0,0" />
            </StackPanel>
          </DockPanel>
        </Border>
        <Border x:Name="LogsCard" Classes="card" IsVisible="False" Width="340" Margin="0,0,14,14">
          <DockPanel>
            <Button x:Name="LogsButton" DockPanel.Dock="Bottom" HorizontalAlignment="Left" Margin="0,12,0,0" Click="OpenLogs" />
            <icons:MaterialIcon DockPanel.Dock="Left" Kind="TextBoxOutline" Width="36" Height="36" Margin="0,0,14,0" VerticalAlignment="Top"
                                Foreground="{DynamicResource Shell.Accent}" />
            <StackPanel>
              <TextBlock x:Name="LogsTitle" FontSize="15" FontWeight="SemiBold" />
              <TextBlock x:Name="LogsText" Classes="note" Margin="0,4,0,0" />
            </StackPanel>
          </DockPanel>
        </Border>
      </WrapPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
