<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- The launcher's own tables (Shell.xaml on Windows): capitalised grey column titles, a ListBox of 44 px rows with every other
       one shaded and the hovered one tinted, no selection (a row acts through its buttons), and small rounded labels. -->
  <Style Selector="TextBlock.column">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Shell.TextSecondary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.cell">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="TextBlock.cell.muted">
    <Setter Property="Foreground" Value="{DynamicResource Shell.TextSecondary}" />
  </Style>
  <Style Selector="ListBox.table">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>
  <Style Selector="ListBox.table ListBoxItem">
    <Setter Property="Height" Value="44" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ListBox.table ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.table ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.table ListBoxItem:nth-child(odd) /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Shell.Panel}" />
  </Style>
  <Style Selector="ListBox.table ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Shell.Cell}" />
  </Style>
  <Style Selector="Border.badge">
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="7,0,7,1" />
    <Setter Property="Margin" Value="6,0,0,0" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="BorderBrush" Value="{DynamicResource Shell.Border}" />
  </Style>
  <Style Selector="Border.badge TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource Shell.TextSecondary}" />
  </Style>
  <Style Selector="Border.badge.accent">
    <Setter Property="BorderBrush" Value="{DynamicResource Shell.Accent}" />
  </Style>
  <Style Selector="Border.badge.accent TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Accent}" />
  </Style>
  <Style Selector="Border.badge.warning">
    <Setter Property="BorderBrush" Value="{DynamicResource Shell.Warning}" />
  </Style>
  <Style Selector="Border.badge.warning TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Warning}" />
  </Style>
</Styles>
