<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:l="clr-namespace:Waypoint"
             x:Class="Waypoint.ControlTab">
  <UserControl.Styles>
    <StyleInclude Source="avares://Waypoint/Views/ViewStyles.axaml" />
    <Style Selector="WrapPanel.setupButtons > Button">
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="WrapPanel.options > CheckBox">
      <Setter Property="Margin" Value="0,0,12,0" />
    </Style>
  </UserControl.Styles>
  <DockPanel>
    <!-- The toolbar: live.ps1's switches on the left, everything at once on the right. Disabled while live.ps1 runs. -->
    <Border x:Name="Toolbar" DockPanel.Dock="Top" Padding="0,4,0,8" BorderBrush="{DynamicResource Shell.Border}" BorderThickness="0,0,0,1">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
          <Button Click="StopAll" ToolTip.Tip="{l:Loc 'live.ps1 -Stop and the dev host: the game, the walk-map recorder, the servers and the account service'}">
            <StackPanel Orientation="Horizontal">
              <icons:MaterialIcon Kind="Stop" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource Shell.Error}" />
              <TextBlock Text="{l:Loc 'Stop all'}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="StopServersButton" Click="StopServers" ToolTip.Tip="{l:Loc 'live.ps1 -Stop -NoClient: the servers and the walk-map recorder; the client stays (back at the login screen)'}">
            <StackPanel Orientation="Horizontal">
              <icons:MaterialIcon Kind="Stop" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource Shell.Error}" />
              <TextBlock Text="{l:Loc 'Stop servers'}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="StartServersButton" Click="StartServers">
            <StackPanel Orientation="Horizontal">
              <icons:MaterialIcon x:Name="StartServersIcon" Kind="Play" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center"
                                  Foreground="{DynamicResource Shell.Good}" />
              <TextBlock x:Name="StartServersText" Text="{l:Loc 'Start servers'}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="PlayButton" Classes="accent" Click="Play"
                  ToolTip.Tip="{l:Loc 'live.ps1: builds and starts the servers, then the game (closes a running one)'}">
            <StackPanel Orientation="Horizontal">
              <icons:MaterialIcon Kind="Play" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" />
              <TextBlock Text="{l:Loc 'Play'}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
        <WrapPanel x:Name="RunOptions" Classes="options" VerticalAlignment="Center">
          <CheckBox x:Name="HotReload" Content="{l:Loc 'Hot reload'}"
                    ToolTip.Tip="{l:Loc 'The Gateway runs under dotnet watch, so saved code edits apply with the game still running; off passes -NoHotReload'}" />
          <CheckBox x:Name="NoBuild" Content="{l:Loc 'Skip build'}" ToolTip.Tip="-NoBuild" />
          <CheckBox x:Name="NoExtract" Content="{l:Loc 'Skip data check'}" ToolTip.Tip="-NoExtract" />
          <!-- live.ps1 refuses -Walkmaps on Linux: Frida's recorder cannot run there. Off and out of sight, so the logic stays as on Windows. -->
          <CheckBox x:Name="Walkmaps" Content="{l:Loc 'Walk maps'}" IsVisible="False" />
        </WrapPanel>
      </DockPanel>
    </Border>

    <!-- Below the table: live.ps1's output and the setup checks. -->
    <Grid DockPanel.Dock="Bottom" Height="230" Margin="0,8,0,0" ColumnDefinitions="3*,12,2*">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Classes="groupTitle" Text="{l:Loc 'live.ps1 output'}" />
        <Border Classes="group" Background="{DynamicResource Shell.Panel}">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="10,6,6,0">
              <Button DockPanel.Dock="Right" Content="{l:Loc 'Clear'}" Click="ClearOutput" Height="24" Padding="10,0" VerticalContentAlignment="Center" />
              <TextBlock x:Name="RunState" Text="{l:Loc 'Ready.'}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <TextBox x:Name="Output" Classes="output" Margin="8,2,8,6" />
          </DockPanel>
        </Border>
      </DockPanel>
      <DockPanel Grid.Column="2">
        <TextBlock DockPanel.Dock="Top" Classes="groupTitle" Text="{l:Loc 'Setup'}" />
        <Border Classes="group" Padding="10,8">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
              <Button DockPanel.Dock="Right" Content="{l:Loc 'Change…'}" Click="ChangeServer" Height="24" Padding="10,0" Margin="6,0,0,0" VerticalContentAlignment="Center"
                      ToolTip.Tip="{l:Loc 'Pick another LocalExile server checkout; the launcher starts again on it'}" />
              <TextBlock Text="{l:Loc 'Server  '}" Classes="note" VerticalAlignment="Center" />
              <TextBlock x:Name="ServerFolder" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <WrapPanel DockPanel.Dock="Bottom" Classes="setupButtons" Margin="0,6,0,-6">
              <Button Content="{l:Loc 'Guided setup'}" Click="OpenGuidedSetup"
                      ToolTip.Tip="{l:Loc 'The Setup section: every requirement with its next step'}" />
              <Button Content="{l:Loc 'Set up a new copy…'}" Click="NewCopyClicked"
                      ToolTip.Tip="{l:Loc 'Clones LocalExile with git into a folder you choose and sets it up, for branches and pull requests'}" />
              <Button x:Name="CheckAgainButton" Content="{l:Loc 'Check again'}" Click="CheckSetup" />
              <Button x:Name="GameDataButton" Content="{l:Loc 'Game data'}" Click="CheckData"
                      ToolTip.Tip="{l:Loc 'extract-data.ps1 -List: which extracted files are missing or stale'}" />
              <Button Content="{l:Loc 'Logs folder'}" Click="OpenLogs" />
            </WrapPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl x:Name="SetupList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <DockPanel Margin="0,1">
                      <icons:MaterialIcon Kind="{Binding Icon}" Foreground="{Binding Brush}" Width="15" Height="15" Margin="0,1,6,0" VerticalAlignment="Top" />
                      <TextBlock Text="{Binding Text}" TextWrapping="Wrap" ToolTip.Tip="{Binding Hint}" />
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </DockPanel>
    </Grid>

    <!-- The services as a table: one row each, with one Start/Stop button that follows its state. -->
    <Grid Margin="0,4,0,0" RowDefinitions="Auto,*">
      <Grid Height="34" Margin="10,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="240" />
          <ColumnDefinition Width="150" />
          <ColumnDefinition Width="90" />
          <ColumnDefinition Width="64" />
          <ColumnDefinition Width="72" />
          <ColumnDefinition Width="56" />
          <ColumnDefinition Width="72" />
          <ColumnDefinition Width="122" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{l:Loc 'SERVICE'}" Classes="columnHeader" />
        <TextBlock Grid.Column="1" Text="{l:Loc 'STATUS'}" Classes="columnHeader" />
        <TextBlock Grid.Column="2" Text="{l:Loc 'PORTS'}" Classes="columnHeader" />
        <TextBlock Grid.Column="3" Text="PID" Classes="columnHeader" />
        <TextBlock Grid.Column="4" Text="{l:Loc 'UPTIME'}" Classes="columnHeader" />
        <TextBlock Grid.Column="5" Text="{l:Loc 'CPU'}" Classes="columnHeader" />
        <TextBlock Grid.Column="6" Text="{l:Loc 'MEMORY'}" Classes="columnHeader" />
      </Grid>
      <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="ServiceList" Classes="table">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="row">
                <Grid VerticalAlignment="Center">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="240" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="122" />
                  </Grid.ColumnDefinitions>
                  <DockPanel ToolTip.Tip="{Binding Description}" Margin="0,0,12,0">
                    <icons:MaterialIcon DockPanel.Dock="Left" Kind="{Binding Icon}" Width="17" Height="17" Margin="0,0,10,0" VerticalAlignment="Center"
                                        Foreground="{DynamicResource Shell.TextSecondary}" />
                    <TextBlock DockPanel.Dock="Left" Text="{Binding DisplayName}" Classes="cell" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Description}" Classes="cell" Margin="10,0,0,0" Foreground="{DynamicResource Shell.TextSecondary}" />
                  </DockPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" ToolTip.Tip="{Binding StateTip}">
                    <Ellipse Width="8" Height="8" Fill="{Binding Lamp}" Margin="0,0,7,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding State}" Classes="cell" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding Ports}" Classes="cell" />
                  <TextBlock Grid.Column="3" Text="{Binding Pid}" Classes="cell" />
                  <TextBlock Grid.Column="4" Text="{Binding Uptime}" Classes="cell" />
                  <TextBlock Grid.Column="5" Text="{Binding Cpu}" Classes="cell" />
                  <TextBlock Grid.Column="6" Text="{Binding Memory}" Classes="cell" />
                  <StackPanel Grid.Column="7" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Width="84" Height="28" Padding="4,0" Click="Toggle" IsEnabled="{Binding CanAct}" IsVisible="{Binding ActionShown}" ToolTip.Tip="{Binding ActionTip}"
                            ToolTip.ShowOnDisabled="True" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                      <StackPanel Orientation="Horizontal">
                        <icons:MaterialIcon Kind="{Binding ActionIcon}" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{Binding ActionBrush}" />
                        <TextBlock Text="{Binding ActionText}" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                    <Button Width="28" Height="28" Padding="0" Margin="4,0,0,0" Background="Transparent" BorderThickness="0" Click="RowMenu"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="{l:Loc 'More: restart, log'}">
                      <icons:MaterialIcon Kind="DotsVertical" Width="16" Height="16" />
                      <Button.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="{l:Loc 'Restart'}" Click="RestartRow" IsEnabled="{Binding CanRestart}" />
                          <MenuItem Header="{l:Loc 'Show log'}" Click="ShowRowLog" />
                        </ContextMenu>
                      </Button.ContextMenu>
                    </Button>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
