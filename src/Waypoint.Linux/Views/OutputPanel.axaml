<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Waypoint"
             x:Class="Waypoint.OutputPanel">
  <UserControl.Styles>
    <StyleInclude Source="avares://Waypoint/Views/ViewStyles.axaml" />
  </UserControl.Styles>
  <!-- What an operation of the adapter is doing and printed: on every section that runs one. -->
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Classes="groupTitle" Text="{l:Loc 'Output'}" />
    <Border Classes="group" Background="{DynamicResource Shell.Panel}">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="10,6,6,0">
          <Button DockPanel.Dock="Right" Content="{l:Loc 'Clear'}" Click="ClearOutput" Height="24" Padding="10,0" VerticalContentAlignment="Center" />
          <TextBlock x:Name="RunState" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <TextBox x:Name="Output" Classes="output" Margin="8,2,8,6" />
      </DockPanel>
    </Border>
  </DockPanel>
</UserControl>
