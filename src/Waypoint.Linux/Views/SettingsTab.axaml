<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Waypoint"
             x:Class="Waypoint.SettingsTab">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="820" HorizontalAlignment="Left" Spacing="12" Margin="0,0,14,0">
      <Border Classes="card">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="{l:Loc 'Change appearance…'}" Click="ChangeAppearance" Margin="12,0,0,0" VerticalAlignment="Top" />
          <StackPanel Spacing="4">
            <TextBlock Text="{l:Loc 'Appearance'}" Classes="heading" />
            <TextBlock x:Name="AppearanceSummary" FontWeight="SemiBold" />
          </StackPanel>
        </DockPanel>
      </Border>
      <Border Classes="card">
        <StackPanel Spacing="6">
          <TextBlock x:Name="LanguageHeading" Classes="heading" />
          <!-- One choice per L.Languages, each named in its own language (SettingsTab.Attach). -->
          <WrapPanel x:Name="LanguageChoices" ItemSpacing="20" />
          <TextBlock x:Name="LanguageNote" Classes="note" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="4">
          <TextBlock x:Name="WindowHeading" Classes="heading" />
          <!-- The tray's choices, only where the desktop shows a tray (Tray.Available). -->
          <StackPanel x:Name="TrayChoices" Spacing="4">
            <TextBlock Text="{l:Loc 'When I close the window'}" FontWeight="SemiBold" Margin="0,2,0,2" />
            <RadioButton x:Name="KeepInTray" GroupName="WindowClose" Content="{l:Loc 'Keep Waypoint running in the tray'}" IsCheckedChanged="CloseChoiceChanged" />
            <TextBlock Text="{l:Loc 'Hide the window beside the clock. Waypoint, services and the game keep running.'}" Classes="note" Margin="27,0,0,4" />
            <RadioButton x:Name="ExitApplication" GroupName="WindowClose" Content="{l:Loc 'Exit Waypoint'}" IsCheckedChanged="CloseChoiceChanged" />
            <TextBlock Text="{l:Loc 'Close Waypoint completely.'}" Classes="note" Margin="27,0,0,4" />
          </StackPanel>
          <TextBlock x:Name="ExitHeading" FontWeight="SemiBold" Margin="0,2,0,2" />
          <RadioButton x:Name="LeaveServices" GroupName="ServiceExit" IsCheckedChanged="ServicesChanged" />
          <RadioButton x:Name="StopServices" GroupName="ServiceExit" IsCheckedChanged="ServicesChanged" />
          <TextBlock x:Name="ServicesHelp" Classes="note" Margin="0,0,0,6" />
          <Border Height="1" Background="{DynamicResource Shell.Border}" Margin="0,2,0,6" />
          <CheckBox x:Name="AlwaysAsk" IsCheckedChanged="AlwaysAskChanged" />
          <CheckBox x:Name="TrayWhileGame" Content="{l:Loc 'Tray while the game runs'}" IsCheckedChanged="TrayChanged"
                    ToolTip.Tip="{l:Loc 'Hide Waypoint in the tray when the game starts, and bring it back when the game closes'}" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <DockPanel>
          <Button x:Name="CheckUpdatesButton" DockPanel.Dock="Right" Click="CheckUpdates" Margin="12,0,0,0" VerticalAlignment="Top" />
          <StackPanel Spacing="4">
            <TextBlock x:Name="UpdatesHeading" Classes="heading" />
            <CheckBox x:Name="CheckAtStart" IsCheckedChanged="CheckAtStartChanged" />
            <CheckBox x:Name="KeepUpToDate" IsCheckedChanged="KeepUpToDateChanged" />
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- How a release moves to another version of the game from Steam (ClientVersionsWindow). -->
      <Border x:Name="ClientSwitchGroup" Classes="card">
        <StackPanel Spacing="4">
          <TextBlock Text="{l:Loc 'Game client versions'}" Classes="heading" />
          <TextBlock Text="{l:Loc 'When a LocalExile folder that has a game client gets another version from Steam:'}" TextWrapping="Wrap" Margin="0,0,0,2" />
          <RadioButton x:Name="SwitchAsk" GroupName="ClientSwitch" Content="{l:Loc 'Ask each time'}" IsCheckedChanged="ClientSwitchChanged" />
          <RadioButton x:Name="SwitchKeepBoth" GroupName="ClientSwitch" Content="{l:Loc 'Always keep both versions'}" IsCheckedChanged="ClientSwitchChanged"
                       ToolTip.Tip="{l:Loc 'The client in use is set aside and the other version is made beside it. It needs the room of both, and going back is instant.'}" />
          <RadioButton x:Name="SwitchInPlace" GroupName="ClientSwitch" Content="{l:Loc 'Always update the one client in place'}" IsCheckedChanged="ClientSwitchChanged"
                       ToolTip.Tip="{l:Loc 'The one client becomes the other version. Only what differs is downloaded and it needs no more room, but the version it was is gone.'}" />
          <TextBlock Text="{l:Loc 'A way the drive has no room for is asked about instead.'}" Classes="note" Margin="0,2,0,0" />
        </StackPanel>
      </Border>

      <Border x:Name="DeveloperGroup" Classes="card">
        <StackPanel Spacing="4">
          <TextBlock x:Name="DeveloperHeading" Classes="heading" />
          <CheckBox x:Name="DeveloperMode" IsCheckedChanged="DeveloperModeClicked" />
          <TextBlock x:Name="DeveloperNote" Classes="note" />
        </StackPanel>
      </Border>

      <Border x:Name="CheckoutGroup" Classes="card">
        <StackPanel Spacing="6">
          <TextBlock x:Name="CheckoutHeading" Classes="heading" />
          <TextBlock x:Name="ServerFolder" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <CheckBox x:Name="UseProfile" ToolTip.Tip="scripts/dev/live.local.ps1, config/runtime.local.ps1" IsCheckedChanged="ProfileChanged" />
          <WrapPanel ItemSpacing="6" LineSpacing="6">
            <Button x:Name="FindButton" Click="FindCheckout" />
            <Button x:Name="ChangeButton" Click="ChangeCheckout" />
            <Button x:Name="OpenDataButton" Click="OpenData" />
          </WrapPanel>
        </StackPanel>
      </Border>
      <!-- LocalExile's game settings: here the Wine prefix's, for everyone. -->
      <Border Classes="card">
        <StackPanel Spacing="6">
          <TextBlock x:Name="GameSettingsHeading" Classes="heading" />
          <StackPanel x:Name="GameSettingsRow" />
        </StackPanel>
      </Border>
      <!-- Opt-in NativeMods client script extender (OFF by default). -->
      <Border x:Name="NativeModsCard" Classes="card">
        <StackPanel Spacing="6">
          <TextBlock x:Name="NativeModsHeading" Classes="heading" />
          <CheckBox x:Name="NativeModsEnabled" IsCheckedChanged="NativeModsPreferenceChanged" />
          <TextBlock x:Name="NativeModsNote" Classes="note" TextWrapping="Wrap" />
          <WrapPanel ItemSpacing="18" LineSpacing="4">
            <RadioButton x:Name="NativeModsProxyMode" GroupName="NativeModsMode" IsCheckedChanged="NativeModsPreferenceChanged" />
            <RadioButton x:Name="NativeModsImportMode" GroupName="NativeModsMode" IsCheckedChanged="NativeModsPreferenceChanged" />
          </WrapPanel>
          <TextBlock x:Name="NativeModsStatus" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock x:Name="NativeModsDetails" Classes="note" TextWrapping="Wrap" IsVisible="False" />
          <WrapPanel ItemSpacing="6" LineSpacing="6">
            <Button x:Name="NativeModsGitHubButton" Click="InstallNativeModsGitHub" />
            <Button x:Name="NativeModsZipButton" Click="ImportNativeModsZip" />
            <Button x:Name="NativeModsFolderButton" Click="ImportNativeModsFolder" />
            <Button x:Name="NativeModsVerifyButton" Click="VerifyNativeMods" />
            <Button x:Name="NativeModsUninstallButton" Click="UninstallNativeMods" />
          </WrapPanel>
        </StackPanel>
      </Border>
      <!-- Where Waypoint keeps its files and which programs it uses (PathChoices): rows made in code, as on Windows. Shown with
           Developer Mode, and whenever something there is chosen or cannot be used. -->
      <Border x:Name="PathsCard" Classes="card">
        <StackPanel Spacing="6">
          <TextBlock x:Name="PathsHeading" Classes="heading" />
          <TextBlock x:Name="PathsNote" Classes="note" TextWrapping="Wrap" />
          <StackPanel x:Name="PathRows" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
