<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Waypoint"
             x:Class="Waypoint.PlayTab">
  <UserControl.Styles>
    <StyleInclude Source="avares://Waypoint/Views/ViewStyles.axaml" />
    <Style Selector="Button#RunSetupLink:disabled">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
  </UserControl.Styles>
  <!-- Simple mode's home: one sentence, one button. Everything else appears only when there is something to say. -->
  <Grid>
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
      <l:EditionSwitch x:Name="Edition" />
      <!-- Latest behind LocalExile's main: how far, and the update without waiting for tomorrow's Play. -->
      <StackPanel x:Name="BehindPanel" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,-16,0,24" IsVisible="False">
        <TextBlock x:Name="BehindText" Classes="note" VerticalAlignment="Center" />
        <Button x:Name="UpdateNowLink" Classes="quiet" Content="{l:Loc 'Update now'}" Click="UpdateNowClicked" />
      </StackPanel>
      <TextBlock x:Name="Headline" FontSize="24" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,24" />
      <Button x:Name="MainButton" Classes="accent" Click="MainClicked" HorizontalAlignment="Center" Height="52" MinWidth="200" Padding="40,0" FontSize="18"
              HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
      <ProgressBar x:Name="Working" Height="4" Width="260" HorizontalAlignment="Center" IsIndeterminate="True" IsVisible="False" />
      <TextBlock x:Name="Note" Classes="note" TextAlignment="Center" Margin="0,18,0,0" IsVisible="False" />
      <Button x:Name="DetailsLink" Classes="quiet" Content="{l:Loc 'See what happened'}" Margin="0,8,0,0" Click="DetailsClicked" IsVisible="False" />
      <Button x:Name="StopLink" Classes="quiet" Content="{l:Loc 'Stop playing'}" Margin="0,18,0,0" Click="StopClicked" IsVisible="False" />
      <Button x:Name="GoBackLink" Classes="quiet" Content="{l:Loc 'Go back to the version you had'}" Margin="0,18,0,0" Click="GoBackClicked" IsVisible="False" />
      <!-- Simple mode on a source copy: in place of Play, the release or Advanced mode (Editions.MustChoose). -->
      <Border x:Name="LatestCard" IsVisible="False" Margin="0,18,0,0" Padding="14,10" CornerRadius="6" BorderThickness="1"
              Background="{DynamicResource Shell.Panel}" BorderBrush="{DynamicResource Shell.Border}">
        <StackPanel>
          <TextBlock TextAlignment="Center" TextWrapping="Wrap"
                     Text="{l:Loc 'This folder is Latest: LocalExile\'s newest changes, from its source. Switch to the release to keep Simple mode, or use Advanced mode to play this copy and pick branches and pull requests.'}" />
          <WrapPanel HorizontalAlignment="Center" Margin="0,10,0,0" ItemSpacing="8" LineSpacing="6">
            <Button Content="{l:Loc 'Switch to the release…'}" Click="GuideReleaseClicked"
                    ToolTip.Tip="{l:Loc 'Sets up or opens LocalExile\'s published release. It has its own characters; the ones you have here stay in this folder.'}" />
            <Button Content="{l:Loc 'Use Advanced mode'}" Click="GuideAdvancedClicked"
                    ToolTip.Tip="{l:Loc 'Shows this copy in Advanced mode: every section, with branches and pull requests under Versions. A release keeps the mode you chose there.'}" />
          </WrapPanel>
        </StackPanel>
      </Border>
      <TextBlock x:Name="FolderText" Classes="note" TextAlignment="Center" Margin="0,24,0,0" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16" Margin="0,4,0,0">
        <Button Classes="quiet" Content="{l:Loc 'Change folder…'}" Click="ChangeFolderClicked" />
        <Button x:Name="NewCopyLink" Classes="quiet" Content="{l:Loc 'Set up a new copy…'}" Click="NewCopyClicked"
                ToolTip.Tip="{l:Loc 'Clones LocalExile with git into a folder you choose and sets it up, for branches and pull requests'}" />
      </StackPanel>
      <Button x:Name="RunSetupLink" Classes="quiet" FontSize="12.5" Margin="0,10,0,0"
              Content="{l:Loc 'Run setup guide…'}" Click="RunSetupClicked"
              ToolTip.Tip="{l:Loc 'Recheck requirements and refresh this setup, including client preparation. Close the game and stop servers first.'}" />
    </StackPanel>
  </Grid>
</UserControl>
