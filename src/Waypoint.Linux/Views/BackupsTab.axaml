<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Waypoint"
             x:Class="Waypoint.BackupsTab">
  <UserControl.Styles>
    <Style Selector="ListBox">
      <Setter Property="Background" Value="{DynamicResource Shell.Panel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Shell.Border}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </UserControl.Styles>
  <DockPanel>
    <Border x:Name="Toolbar" DockPanel.Dock="Top" Padding="0,0,0,8" BorderBrush="{DynamicResource Shell.Border}" BorderThickness="0,0,0,1">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
          <Button x:Name="OpenFolderButton" Click="OpenFolder" />
          <Button x:Name="RefreshButton" Click="RefreshClicked" />
          <Button x:Name="BackUpButton" Classes="accent" Click="BackUpNow" />
        </StackPanel>
        <CheckBox x:Name="AutoBackup" DockPanel.Dock="Left" IsCheckedChanged="BackupChanged" />
        <TextBlock x:Name="Status" Classes="note" Margin="4,0,12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
      </DockPanel>
    </Border>

    <l:OutputPanel x:Name="OutputView" DockPanel.Dock="Bottom" Height="170" Margin="0,8,0,0" />

    <Grid Margin="0,10,0,0" ColumnDefinitions="2*,12,3*">
      <Grid>
        <ListBox x:Name="BackupList" SelectionChanged="SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="2">
                <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Identity}" Classes="note" FontSize="11.5" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="Empty" Classes="note" IsHitTestVisible="False" TextAlignment="Center"
                   VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="240" Margin="16" />
      </Grid>
      <Border Grid.Column="2" Classes="card">
        <DockPanel>
          <TextBlock x:Name="SelectedHeading" Classes="heading" DockPanel.Dock="Top" Margin="0,0,0,10" />
          <WrapPanel DockPanel.Dock="Top" ItemSpacing="6" LineSpacing="6" Margin="0,0,0,6">
            <Button x:Name="RestoreButton" Click="Restore" IsEnabled="False" />
            <Button x:Name="RestoreModsButton" Click="RestoreMods" IsEnabled="False" />
            <Button x:Name="DeleteButton" Click="Delete" IsEnabled="False" Foreground="{DynamicResource Shell.Error}" />
          </WrapPanel>
          <TextBlock x:Name="Hint" DockPanel.Dock="Top" Classes="note" FontSize="11.5" Margin="0,0,0,8" />
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <TextBlock x:Name="Details" TextWrapping="Wrap" FontFamily="monospace" FontSize="12" />
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
