<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Waypoint"
             x:Class="Waypoint.TimingsTab">
  <UserControl.Styles>
    <Style Selector="ListBox#Table ListBoxItem">
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="Grid.columns TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
  </UserControl.Styles>
  <DockPanel>
    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
      <TextBlock x:Name="WindowLabel" VerticalAlignment="Center" Margin="0,0,6,0" />
      <ComboBox x:Name="WindowPicker" Width="100" SelectionChanged="Changed" Margin="0,0,20,0">
        <ComboBoxItem Tag="30" />
        <ComboBoxItem Tag="60" IsSelected="True" />
        <ComboBoxItem Tag="300" />
        <ComboBoxItem Tag="900" />
      </ComboBox>
      <TextBlock x:Name="ShowLabel" VerticalAlignment="Center" Margin="0,0,6,0" />
      <ComboBox x:Name="KindPicker" Width="160" SelectionChanged="Changed" Margin="0,0,12,0">
        <ComboBoxItem Tag="" IsSelected="True" />
        <ComboBoxItem Tag="Client messages" />
        <ComboBoxItem Tag="Server phases" />
        <ComboBoxItem Tag="Level generation" />
      </ComboBox>
      <TextBlock x:Name="State" VerticalAlignment="Center" Foreground="{DynamicResource Shell.TextSecondary}" />
    </WrapPanel>
    <Grid RowDefinitions="*,1.3*" ColumnDefinitions="*,*">
      <!-- The five operations with the most server time in the window, the same colour on both charts. -->
      <l:LineChart x:Name="SlowChart" Format="0.##" Margin="4" />
      <l:LineChart x:Name="LoadChart" Grid.Column="1" Format="0.#" Margin="4" />
      <!-- Windows' GridView: the same columns, a header row over the list. -->
      <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="4">
        <Grid x:Name="Header" Classes="columns" DockPanel.Dock="Top" ColumnDefinitions="200,120,80,80,80,80,90" Margin="6,0,6,4">
          <TextBlock x:Name="OperationHeader" Foreground="{DynamicResource Shell.TextSecondary}" />
          <TextBlock x:Name="KindHeader" Grid.Column="1" Foreground="{DynamicResource Shell.TextSecondary}" />
          <TextBlock x:Name="CallsHeader" Grid.Column="2" Foreground="{DynamicResource Shell.TextSecondary}" />
          <TextBlock x:Name="AverageHeader" Grid.Column="3" Foreground="{DynamicResource Shell.TextSecondary}" />
          <TextBlock x:Name="P95Header" Grid.Column="4" Foreground="{DynamicResource Shell.TextSecondary}" />
          <TextBlock x:Name="P99Header" Grid.Column="5" Foreground="{DynamicResource Shell.TextSecondary}" />
          <TextBlock x:Name="LoadHeader" Grid.Column="6" Foreground="{DynamicResource Shell.TextSecondary}" />
        </Grid>
        <ListBox x:Name="Table" Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Classes="columns" ColumnDefinitions="200,120,80,80,80,80,90">
                <TextBlock Text="{Binding Label}" />
                <TextBlock Grid.Column="1" Text="{Binding KindText}" />
                <TextBlock Grid.Column="2" Text="{Binding PerSecond, StringFormat='{}{0:0.##}'}" />
                <TextBlock Grid.Column="3" Text="{Binding Average, StringFormat='{}{0:0.###}'}" />
                <TextBlock Grid.Column="4" Text="{Binding P95, StringFormat='{}{0:0.###}'}" />
                <TextBlock Grid.Column="5" Text="{Binding P99, StringFormat='{}{0:0.###}'}" />
                <TextBlock Grid.Column="6" Text="{Binding MsPerSecond, StringFormat='{}{0:0.##}'}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Grid>
  </DockPanel>
</UserControl>
