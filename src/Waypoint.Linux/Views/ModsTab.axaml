<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:l="clr-namespace:Waypoint"
             x:Class="Waypoint.ModsTab">
  <UserControl.Styles>
    <Style Selector="ListBox.mods">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBox.mods ListBoxItem">
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="MinHeight" Value="60" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ListBox.mods ListBoxItem:nth-child(2n+1)">
      <Setter Property="Background" Value="{DynamicResource Shell.Panel}" />
    </Style>
    <Style Selector="Border.tile">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="{DynamicResource Shell.Panel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Shell.Border}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.tile TextBlock">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Shell.Accent}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.note.problem">
      <Setter Property="Foreground" Value="{DynamicResource Shell.Error}" />
    </Style>
    <Style Selector="TextBlock.column">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Shell.TextSecondary}" />
    </Style>
    <Style Selector="Border.tag">
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="7,0,7,1" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource Shell.Border}" />
    </Style>
  </UserControl.Styles>
  <DockPanel>
    <l:OutputPanel x:Name="OutputView" DockPanel.Dock="Bottom" Height="150" Margin="0,8,0,0" IsVisible="False" />

    <!-- Only the headers: what they show is below, so a mod's page can take the place of either list. -->
    <TabControl x:Name="Pages" DockPanel.Dock="Top" SelectionChanged="PageChanged">
      <TabItem x:Name="InstalledPage" />
      <TabItem x:Name="BrowsePage" />
    </TabControl>

    <Grid Margin="0,8,0,0">
      <!-- My Mods. -->
      <DockPanel x:Name="InstalledView">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
            <TextBox x:Name="Search" Width="220" VerticalAlignment="Center" TextChanged="SearchChanged">
              <TextBox.InnerLeftContent>
                <icons:MaterialIcon Kind="Magnify" Width="16" Height="16" Margin="8,0,0,0" Foreground="{DynamicResource Shell.TextSecondary}" />
              </TextBox.InnerLeftContent>
            </TextBox>
            <Button x:Name="OpenModsButton" Click="OpenMods" Background="Transparent">
              <icons:MaterialIcon Kind="FolderOpenOutline" Width="18" Height="18" />
            </Button>
            <Button x:Name="RefreshInstalledButton" Click="RefreshInstalled" Background="Transparent">
              <icons:MaterialIcon Kind="Refresh" Width="18" Height="18" />
            </Button>
            <Button x:Name="MoreButton" Background="Transparent">
              <icons:MaterialIcon Kind="DotsVertical" Width="18" Height="18" />
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                  <MenuItem x:Name="InstallFolderItem" Click="InstallFolder" />
                  <MenuItem x:Name="BuildAllItem" Click="BuildAll" />
                  <MenuItem x:Name="CheckModsItem" Click="CheckMods" />
                  <MenuItem x:Name="GatewayLogItem" Click="GatewayLog" />
                  <MenuItem x:Name="ShowLogItem" ToggleType="CheckBox" Click="ShowLogChanged" />
                  <Separator />
                  <MenuItem x:Name="AutoBackupItem" ToggleType="CheckBox" Click="BackupChanged" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
          <Button x:Name="UpdateAllButton" HorizontalAlignment="Left" Click="UpdateAll">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <icons:MaterialIcon Kind="Update" Width="16" Height="16" />
              <TextBlock x:Name="UpdateAllText" VerticalAlignment="Center" />
              <Border x:Name="UpdateCountBadge" CornerRadius="9" Padding="7,0,7,1" Background="{DynamicResource Shell.Accent}">
                <TextBlock x:Name="UpdateCount" FontSize="11" Foreground="White" />
              </Border>
            </StackPanel>
          </Button>
        </DockPanel>
        <TextBlock x:Name="Notice" DockPanel.Dock="Top" Classes="note" TextWrapping="Wrap" Margin="2,0,0,8" IsVisible="False" />
        <!-- Each heading sorts by its column; again, the other way. -->
        <Grid DockPanel.Dock="Top" Margin="10,0,10,4" ColumnDefinitions="72,52,*,120,130,150">
          <TextBlock x:Name="SortEnabled" Tag="Enabled" Classes="column" Cursor="Hand" Tapped="SortBy" />
          <TextBlock x:Name="NameHeader" Grid.Column="2" Tag="Name" Classes="column" Cursor="Hand" Tapped="SortBy" />
          <TextBlock x:Name="ActionHeader" Grid.Column="3" Tag="Action" Classes="column" Cursor="Hand" Tapped="SortBy" />
          <TextBlock x:Name="LatestHeader" Grid.Column="4" Tag="Latest" Classes="column" Cursor="Hand" Tapped="SortBy" />
          <TextBlock x:Name="AuthorHeader" Grid.Column="5" Tag="Author" Classes="column" Cursor="Hand" Tapped="SortBy" />
        </Grid>
        <Grid>
          <ListBox x:Name="ModList" Classes="mods" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="72,52,*,120,130,150" Background="Transparent" Tapped="RowTapped" ContextRequested="RowContextRequested">
                  <CheckBox HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="0" IsChecked="{Binding Enabled, Mode=OneWay}"
                            Click="ToggleFromList" ToolTip.Tip="{Binding EnabledTip}" />
                  <Border Grid.Column="1" Classes="tile">
                    <TextBlock Text="{Binding Initial}" />
                  </Border>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" Classes="note" Classes.problem="{Binding HasProblem}" ToolTip.Tip="{Binding ProblemTip}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                  </StackPanel>
                  <Button Grid.Column="3" Width="100" VerticalAlignment="Center" HorizontalContentAlignment="Center" Click="RowAction"
                          IsVisible="{Binding HasButton}" IsEnabled="{Binding CanAct}" Content="{Binding ActionText}" ToolTip.Tip="{Binding ActionTip}" />
                  <TextBlock Grid.Column="3" Text="{Binding ActionText}" Classes="note" VerticalAlignment="Center" IsVisible="{Binding UpToDate}" />
                  <Border Grid.Column="3" Width="100" Height="30" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="3" BorderThickness="1"
                          BorderBrush="{DynamicResource Shell.Accent}" ClipToBounds="True" IsVisible="{Binding HasJob}">
                    <Panel>
                      <ProgressBar Value="{Binding Job.Percent}" IsIndeterminate="{Binding Job.Indeterminate}" Minimum="0" Maximum="100" MinHeight="0" MinWidth="0"
                                   VerticalAlignment="Stretch" Background="Transparent" Foreground="{DynamicResource Shell.Accent}" Opacity="0.3" CornerRadius="0" />
                      <TextBlock Text="{Binding Job.Text}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="Medium" />
                    </Panel>
                  </Border>
                  <TextBlock Grid.Column="4" Text="{Binding Latest}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="5" Text="{Binding Author}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="Empty" Classes="note" IsHitTestVisible="False" TextAlignment="Center" TextWrapping="Wrap"
                     VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="320" Margin="16" />
        </Grid>
      </DockPanel>

      <!-- Browse. -->
      <DockPanel x:Name="BrowseView" IsVisible="False">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
            <TextBox x:Name="BrowseSearch" Width="220" VerticalAlignment="Center" TextChanged="BrowseSearchChanged">
              <TextBox.InnerLeftContent>
                <icons:MaterialIcon Kind="Magnify" Width="16" Height="16" Margin="8,0,0,0" Foreground="{DynamicResource Shell.TextSecondary}" />
              </TextBox.InnerLeftContent>
            </TextBox>
            <Button x:Name="RefreshButton" Click="RefreshBrowse" Background="Transparent">
              <icons:MaterialIcon Kind="Refresh" Width="18" Height="18" />
            </Button>
            <Button x:Name="BrowseMoreButton" Background="Transparent">
              <icons:MaterialIcon Kind="DotsVertical" Width="18" Height="18" />
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                  <MenuItem x:Name="AddRepositoryItem" Click="ShowAddRepository" />
                  <MenuItem x:Name="OpenRepositoryItem" Click="OpenRepository" />
                  <MenuItem x:Name="RemoveRepositoryItem" Click="RemoveRepository" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="12">
            <ComboBox x:Name="SourcePicker" MinWidth="260" VerticalAlignment="Center" SelectionChanged="SourceChanged" />
            <TextBlock x:Name="BrowseCount" Classes="note" VerticalAlignment="Center" />
          </StackPanel>
        </DockPanel>
        <DockPanel x:Name="AddRepositoryRow" DockPanel.Dock="Top" Margin="0,0,0,8" IsVisible="False">
          <Button x:Name="CancelRepositoryButton" DockPanel.Dock="Right" Margin="6,0,0,0" Click="HideAddRepository" />
          <Button x:Name="AddRepositoryButton" DockPanel.Dock="Right" Classes="accent" Margin="6,0,0,0" Click="AddRepository" />
          <TextBox x:Name="RepositoryUrl" KeyDown="RepositoryUrlKey" />
        </DockPanel>
        <TextBlock x:Name="BrowseStatus" DockPanel.Dock="Top" Classes="note" TextWrapping="Wrap" Margin="2,0,0,8" IsVisible="False" />
        <Grid DockPanel.Dock="Top" Margin="10,0,10,4" ColumnDefinitions="52,*,120,110,100,150">
          <TextBlock x:Name="BrowseNameHeader" Grid.Column="1" Classes="column" />
          <TextBlock x:Name="BrowseActionHeader" Grid.Column="2" Classes="column" />
          <TextBlock x:Name="BrowseLatestHeader" Grid.Column="3" Classes="column" />
          <TextBlock x:Name="BrowseTypeHeader" Grid.Column="4" Classes="column" />
          <TextBlock x:Name="BrowseAuthorHeader" Grid.Column="5" Classes="column" />
        </Grid>
        <Grid>
          <ListBox x:Name="BrowseList" Classes="mods" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="52,*,120,110,100,150" Background="Transparent" Tapped="RowTapped" ContextRequested="RowContextRequested">
                  <Border Classes="tile">
                    <TextBlock Text="{Binding Initial}" />
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" Classes="note" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                  </StackPanel>
                  <Button Grid.Column="2" Width="100" VerticalAlignment="Center" HorizontalContentAlignment="Center" Content="{Binding ActionText}"
                          IsEnabled="{Binding CanAct}" Click="InstallFromBrowse" IsVisible="{Binding ShowButton}" />
                  <Border Grid.Column="2" Width="100" Height="30" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="3" BorderThickness="1"
                          BorderBrush="{DynamicResource Shell.Accent}" ClipToBounds="True" IsVisible="{Binding HasJob}">
                    <Panel>
                      <ProgressBar Value="{Binding Job.Percent}" IsIndeterminate="{Binding Job.Indeterminate}" Minimum="0" Maximum="100" MinHeight="0" MinWidth="0"
                                   VerticalAlignment="Stretch" Background="Transparent" Foreground="{DynamicResource Shell.Accent}" Opacity="0.3" CornerRadius="0" />
                      <TextBlock Text="{Binding Job.Text}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="Medium" />
                    </Panel>
                  </Border>
                  <TextBlock Grid.Column="3" Text="{Binding Latest}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="4" Text="{Binding TypeText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="5" Text="{Binding Author}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="BrowseEmpty" Classes="note" IsHitTestVisible="False" TextAlignment="Center" TextWrapping="Wrap"
                     VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="320" Margin="16" />
        </Grid>
      </DockPanel>

      <!-- One mod's page: opened from either list. -->
      <DockPanel x:Name="ModPage" IsVisible="False">
        <Border DockPanel.Dock="Top" Classes="card" Padding="12">
          <DockPanel>
            <Button x:Name="BackButton" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,0,8,0" Background="Transparent" Click="ClosePage">
              <icons:MaterialIcon Kind="ArrowLeft" Width="20" Height="20" />
            </Button>
            <Border DockPanel.Dock="Left" Classes="tile" Width="88" Height="88" VerticalAlignment="Top" Margin="0,0,14,0">
              <TextBlock x:Name="PageInitial" FontSize="40" />
            </Border>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top" Margin="12,0,0,0">
              <CheckBox x:Name="PageEnabled" VerticalAlignment="Center" Margin="0,0,4,0" Click="TogglePage" />
              <Button x:Name="PageMenuButton" Background="Transparent" Click="OpenPageMenu">
                <icons:MaterialIcon Kind="DotsVertical" Width="18" Height="18" />
              </Button>
              <Button x:Name="PageAction" Classes="accent" MinWidth="100" HorizontalContentAlignment="Center" Click="PageActionClicked" />
            </StackPanel>
            <StackPanel>
              <WrapPanel>
                <TextBlock x:Name="PageTitle" FontSize="18" FontWeight="SemiBold" Margin="0,0,10,0" />
                <TextBlock x:Name="PageByline" Classes="note" VerticalAlignment="Bottom" Margin="0,0,0,2" />
              </WrapPanel>
              <TextBlock x:Name="PageDescription" TextWrapping="Wrap" Margin="0,6,0,0" />
              <Border BorderBrush="{DynamicResource Shell.Border}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,8,0,0">
                <DockPanel>
                  <TextBlock x:Name="PageStats" DockPanel.Dock="Right" Classes="note" FontSize="12" Margin="12,0,0,0" />
                  <ItemsControl x:Name="PageTags">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Classes="tag">
                          <TextBlock Text="{Binding}" FontSize="11.5" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </DockPanel>
              </Border>
            </StackPanel>
          </DockPanel>
        </Border>
        <TabControl x:Name="PageTabs" Margin="0,8,0,0">
          <TabItem x:Name="ModOverviewPage">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel x:Name="OverviewPanel" MaxWidth="940" Margin="16,12,16,16" HorizontalAlignment="Left" />
            </ScrollViewer>
          </TabItem>
          <TabItem x:Name="ModSettingsPage">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel MaxWidth="640" Margin="16,12,16,16" HorizontalAlignment="Left">
                <StackPanel x:Name="SettingsPanel" />
                <WrapPanel ItemSpacing="6" Margin="0,8,0,0">
                  <Button x:Name="SaveSettingsButton" Classes="accent" Click="SaveSettings" />
                  <Button x:Name="ResetSettingsButton" Click="ResetSettings" />
                </WrapPanel>
                <TextBlock x:Name="SettingsHint" Classes="note" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0" />
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem x:Name="ModVersionsPage">
            <ListBox x:Name="VersionList" Classes="mods" Margin="0,8,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="120,120,90,*,110" MinHeight="44">
                    <TextBlock Text="{Binding Version}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Date}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Size}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding Notes}" Classes="note" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding Notes}" Margin="0,0,12,0" />
                    <Button Grid.Column="4" Width="100" VerticalAlignment="Center" HorizontalContentAlignment="Center" Content="{Binding ActionText}"
                            IsEnabled="{Binding CanAct}" Click="InstallVersion" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </TabItem>
        </TabControl>
      </DockPanel>
    </Grid>
  </DockPanel>
</UserControl>
