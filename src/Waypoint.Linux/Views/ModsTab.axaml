<UserControl x:Class="Waypoint.ModsTab"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:l="clr-namespace:Waypoint">
    <UserControl.Styles>
        <Style Selector="ListBox.mods"><Setter Property="BorderThickness" Value="0" /><Setter Property="Background" Value="Transparent" /></Style>
        <Style Selector="ListBox.mods ListBoxItem"><Setter Property="Padding" Value="12,10" /><Setter Property="MinHeight" Value="78" /><Setter Property="Margin" Value="0,0,0,7" /><Setter Property="CornerRadius" Value="9" /><Setter Property="Background" Value="{DynamicResource Shell.Panel}" /><Setter Property="BorderBrush" Value="{DynamicResource Shell.Border}" /><Setter Property="BorderThickness" Value="1" /></Style>
        <Style Selector="ListBox.mods ListBoxItem:pointerover"><Setter Property="BorderBrush" Value="{DynamicResource Shell.Accent}" /></Style>
        <Style Selector="Border.tile"><Setter Property="Width" Value="56" /><Setter Property="Height" Value="56" /><Setter Property="CornerRadius" Value="9" /><Setter Property="Margin" Value="0,0,12,0" /><Setter Property="Background" Value="{DynamicResource Shell.Background}" /><Setter Property="BorderBrush" Value="{DynamicResource Shell.Border}" /><Setter Property="BorderThickness" Value="1" /></Style>
        <Style Selector="Button.modLink"><Setter Property="MinHeight" Value="0" /><Setter Property="Padding" Value="2" /><Setter Property="Margin" Value="0,0,14,0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style>
        <Style Selector="Button.rowButton"><Setter Property="Width" Value="104" /><Setter Property="Margin" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Center" /></Style>
        <Style Selector="Button.update"><Setter Property="Background" Value="{DynamicResource Shell.Good}" /><Setter Property="Foreground" Value="White" /></Style>
        <Style Selector="Button.update:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource Shell.UpdateHover}" /><Setter Property="Foreground" Value="White" /></Style>
        <Style Selector="Button.update:pressed /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource Shell.UpdatePressed}" /><Setter Property="Foreground" Value="White" /></Style>
        <Style Selector="Button.icon"><Setter Property="Padding" Value="6" /><Setter Property="Background" Value="Transparent" /></Style>
        <Style Selector="TextBlock.cell"><Setter Property="TextTrimming" Value="CharacterEllipsis" /></Style>
        <Style Selector="Button.sortHeader"><Setter Property="MinHeight" Value="0" /><Setter Property="Padding" Value="2,1" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="FontSize" Value="11" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource Shell.TextSecondary}" /><Setter Property="Cursor" Value="Hand" /></Style>
        <Style Selector="Button.sortHeader:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource Shell.Text}" /></Style>
        <Style Selector="TextBlock.column"><Setter Property="FontSize" Value="11" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource Shell.TextSecondary}" /></Style>
        <Style Selector="TextBlock.description"><Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="{DynamicResource Shell.TextSecondary}" /><Setter Property="TextTrimming" Value="CharacterEllipsis" /><Setter Property="Margin" Value="0,3,0,0" /></Style>
        <Style Selector="Border.tag"><Setter Property="Padding" Value="8,4" /><Setter Property="Background" Value="{DynamicResource Shell.Banner}" /><Setter Property="BorderBrush" Value="{DynamicResource Shell.Border}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="5" /></Style>
    </UserControl.Styles>
    <UserControl.Resources>
        <DataTemplate x:Key="ModIdentity">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Left" Classes="tile"><Grid>
                    <icons:MaterialIcon Kind="{Binding Icon}" IsVisible="{Binding ShowSymbol}" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Shell.TextSecondary}" />
                    <Border Width="52" Height="52" CornerRadius="8" ClipToBounds="True" HorizontalAlignment="Center" VerticalAlignment="Center"><Image Source="{Binding IconImage}" Stretch="Uniform" /></Border>
                </Grid></Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Classes="cell" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Description}" Classes="description" IsVisible="{Binding HasDescription}" ToolTip.Tip="{Binding Description}" />
                    <TextBlock Text="{Binding Metadata}" Classes="note" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                </StackPanel>
            </DockPanel>
        </DataTemplate>
        <DataTemplate x:Key="ClientCell">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip.Tip="{Binding IncompatibleTip}">
                <icons:MaterialIcon Kind="AlertCircle" Width="16" Height="16" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{DynamicResource Shell.Warning}" IsVisible="{Binding Incompatible}" AutomationProperties.Name="{Binding IncompatibleTip}" />
                <TextBlock Text="{Binding ClientText}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource Shell.TextSecondary}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="JobBox">
            <Border Width="104" Height="30" HorizontalAlignment="Right" CornerRadius="4" ClipToBounds="True" Background="{DynamicResource Shell.Background}">
                <Grid>
                    <ProgressBar Value="{Binding Percent, Mode=OneWay}" IsIndeterminate="{Binding Indeterminate, Mode=OneWay}" Minimum="0" Maximum="100" MinHeight="0" VerticalAlignment="Stretch" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Shell.Accent}" Opacity="0.25" />
                    <TextBlock Text="{Binding Text}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" Margin="4,0" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Margin="18,8,18,12">
        <l:OutputPanel x:Name="OutputView" DockPanel.Dock="Bottom" Height="150" Margin="0,8,0,0" IsVisible="False" />
        <TextBlock x:Name="ChoiceScopeHint" DockPanel.Dock="Bottom" Text="{l:Loc 'Saved enable choices do not confirm live load status.'}" Classes="note" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0" />
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Button Click="RefreshInstalled" Margin="0,0,8,0" Content="{l:Loc 'Refresh'}" AutomationProperties.Name="{l:Loc 'Refresh'}" />
                <Button x:Name="OpenModsButton" Click="OpenMods" Margin="0" AutomationProperties.Name="{l:Loc 'Open mods folder'}">
                    <StackPanel Orientation="Horizontal"><icons:MaterialIcon Kind="FolderOpenOutline" Width="17" Height="17" Margin="0,0,7,0" /><TextBlock Text="{l:Loc 'Open folder'}" /></StackPanel>
                </Button>
            </StackPanel>
            <TabControl x:Name="Pages" SelectionChanged="PageChanged" Width="280" HorizontalAlignment="Left">
                <TabItem x:Name="InstalledPage" Header="{l:Loc 'My Mods'}" /><TabItem x:Name="BrowsePage" Header="{l:Loc 'Browse'}" />
            </TabControl>
        </DockPanel>
        <Grid>
            <DockPanel x:Name="InstalledView">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBox x:Name="Search" Width="220" Margin="0,0,8,0" VerticalAlignment="Center" PlaceholderText="{l:Loc 'Search mods'}" AutomationProperties.Name="{l:Loc 'Search mods'}" TextChanged="SearchChanged" />
                        <Button x:Name="MoreButton"  AutomationProperties.Name="{l:Loc 'More mod tools'}">
                            <StackPanel Orientation="Horizontal"><icons:MaterialIcon Kind="DotsVertical" Width="17" Height="17" Margin="0,0,5,0" /><TextBlock Text="{l:Loc 'More'}" /></StackPanel>
                            <Button.Flyout><MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem x:Name="InstallFolderItem" Header="{l:Loc 'Install from folder…'}" Click="InstallFolder" />
                                <MenuItem x:Name="BuildAllItem" Header="{l:Loc 'Build all mods'}" Click="BuildAll" />
                                <MenuItem x:Name="CheckModsItem" Header="{l:Loc 'Check live status'}" Click="CheckMods" />
                                <MenuItem Header="{l:Loc 'Gateway log'}" Click="GatewayLog" /><MenuItem x:Name="ShowLogItem" Header="{l:Loc 'Show operation log'}" ToggleType="CheckBox" Click="ShowLogChanged" />
                                <Separator /><MenuItem x:Name="AutoBackupItem" Header="{l:Loc 'Automatic backup before mod changes'}" ToggleType="CheckBox" Click="BackupChanged" />
                            </MenuFlyout></Button.Flyout>
                        </Button>
                    </StackPanel>
                    <Button x:Name="UpdateAllButton" Classes="update" HorizontalAlignment="Left" Margin="0" Click="UpdateAll">
                        <StackPanel Orientation="Horizontal"><icons:MaterialIcon Kind="Update" Width="16" Height="16" Margin="0,0,6,0" /><TextBlock Text="{l:Loc 'Update all'}" />
                            <Border x:Name="UpdateCountBadge" Margin="7,0,0,0"><TextBlock x:Name="UpdateCount" FontSize="12" /></Border>
                        </StackPanel>
                    </Button>
                </DockPanel>
                <TextBlock x:Name="Notice" DockPanel.Dock="Top" Classes="note" TextWrapping="Wrap" Margin="0,0,0,10" IsVisible="False" />
                <TextBlock x:Name="InstalledCount" DockPanel.Dock="Top" Classes="note" FontSize="12" Margin="0,0,0,10" />
                <Grid x:Name="InstalledHeadings" DockPanel.Dock="Top" Margin="11,0,13,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                    <Button Classes="sortHeader" Click="SortBy" Tag="{x:Static l:ModSort.Enabled}" />
                    <Button Grid.Column="1" Classes="sortHeader" Click="SortBy" Tag="{x:Static l:ModSort.Name}" />
                    <Button Grid.Column="2" Classes="sortHeader" Click="SortBy" Tag="{x:Static l:ModSort.Client}" />
                    <Button Grid.Column="3" Classes="sortHeader" Click="SortBy" Tag="{x:Static l:ModSort.Action}" />
                </Grid>
                <Grid>
                    <ListBox x:Name="ModList" Classes="mods" AutomationProperties.Name="{l:Loc 'Installed mods'}"><ListBox.ItemTemplate><DataTemplate>
                        <Grid Background="Transparent" Tapped="RowTapped" ContextRequested="RowContextRequested"><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                            <CheckBox MinWidth="0" IsChecked="{Binding Enabled, Mode=OneWay}" IsEnabled="{Binding CanToggle}" Click="ToggleFromList" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="0" ToolTip.Tip="{Binding EnabledTip}" AutomationProperties.Name="{Binding EnabledTip}" />
                            <StackPanel Grid.Column="1">
                                <Button Classes="modLink" Click="OpenRowDetails" Content="{Binding}" ContentTemplate="{StaticResource ModIdentity}" AutomationProperties.Name="{Binding Title}" />
                                <TextBlock Text="{Binding Problem}" IsVisible="{Binding HasProblem}" Foreground="{DynamicResource Shell.Error}" FontSize="12" TextWrapping="Wrap" Margin="52,5,12,0" />
                            </StackPanel>
                            <ContentControl Grid.Column="2" Content="{Binding}" ContentTemplate="{StaticResource ClientCell}" VerticalAlignment="Center" />
                            <Button Grid.Column="3" Classes="rowButton" Classes.update="{Binding IsUpdate}" Content="{Binding ActionText}" Click="RowAction" IsEnabled="{Binding CanAct}" IsVisible="{Binding HasButton}" ToolTip.Tip="{Binding ActionTip}"  />
                            <Button Grid.Column="3" Classes="rowButton" Content="{l:Loc 'Details'}" Click="OpenRowDetails" IsVisible="{Binding ShowDetails}" />
                            <ContentControl Grid.Column="3" Content="{Binding Job}" ContentTemplate="{StaticResource JobBox}" VerticalAlignment="Center" IsVisible="{Binding HasJob}" />
                        </Grid>
                    </DataTemplate></ListBox.ItemTemplate></ListBox>
                    <TextBlock x:Name="Empty" Classes="note" IsHitTestVisible="False" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="340" Margin="16" />
                </Grid>
            </DockPanel>

            <DockPanel x:Name="BrowseView" IsVisible="False">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBox x:Name="BrowseSearch" Width="220" Margin="0,0,8,0" VerticalAlignment="Center" PlaceholderText="{l:Loc 'Search mods'}" AutomationProperties.Name="{l:Loc 'Search mods'}" TextChanged="BrowseSearchChanged" />
                        <Button x:Name="RefreshButton" Classes="icon" Click="RefreshBrowse" ToolTip.Tip="{l:Loc 'Refresh repository'}" AutomationProperties.Name="{l:Loc 'Refresh repository'}"><icons:MaterialIcon Kind="Refresh" Width="18" Height="18" /></Button>
                        <Button Classes="icon" ToolTip.Tip="{l:Loc 'More'}" AutomationProperties.Name="{l:Loc 'Repository tools'}"><icons:MaterialIcon Kind="DotsVertical" Width="18" Height="18" />
                            <Button.Flyout><MenuFlyout Placement="BottomEdgeAlignedRight"><MenuItem Header="{l:Loc 'Add repository…'}" Click="ShowAddRepository" /><MenuItem Header="{l:Loc 'Open on GitHub'}" Click="OpenRepository" /><MenuItem x:Name="RemoveRepositoryItem" Header="{l:Loc 'Remove repository'}" Click="RemoveRepository" /></MenuFlyout></Button.Flyout>
                        </Button>
                    </StackPanel>
                    <ComboBox x:Name="SourcePicker" MinWidth="230" MaxWidth="300" HorizontalAlignment="Left" VerticalAlignment="Center" SelectionChanged="SourceChanged" AutomationProperties.Name="{l:Loc 'Mod repository'}" />
                </DockPanel>
                <TextBlock x:Name="BrowseCount" DockPanel.Dock="Top" Classes="note" FontSize="12" Margin="0,0,0,10" />
                <DockPanel x:Name="AddRepositoryRow" DockPanel.Dock="Top" Margin="0,0,0,10" IsVisible="False">
                    <Button DockPanel.Dock="Right" Content="{l:Loc 'Cancel'}" Margin="6,0,0,0" Click="HideAddRepository" /><Button DockPanel.Dock="Right" Content="{l:Loc 'Add'}" Classes="accent" Margin="6,0,0,0" Click="AddRepository" />
                    <TextBox x:Name="RepositoryUrl" PlaceholderText="{l:Loc 'Another mod repository: github.com/owner/name'}" KeyDown="RepositoryUrlKey" />
                </DockPanel>
                <TextBlock x:Name="BrowseStatus" DockPanel.Dock="Top" Classes="note" TextWrapping="Wrap" Margin="0,0,0,10" IsVisible="False" />
                <Grid x:Name="BrowseHeadings" DockPanel.Dock="Top" Margin="11,0,13,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /><ColumnDefinition Width="156" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                    <Button Classes="sortHeader" Click="SortBy" Tag="{x:Static l:ModSort.Name}" />
                    <Button Grid.Column="1" Classes="sortHeader" Click="SortBy" Tag="{x:Static l:ModSort.Client}" />
                    <Button Grid.Column="2" Classes="sortHeader" Click="SortBy" Tag="{x:Static l:ModSort.Status}" />
                    <Button Grid.Column="3" Classes="sortHeader" Click="SortBy" Tag="{x:Static l:ModSort.Action}" />
                </Grid>
                <Grid>
                    <ListBox x:Name="BrowseList" Classes="mods" AutomationProperties.Name="{l:Loc 'Available mods'}"><ListBox.ItemTemplate><DataTemplate>
                        <Grid Background="Transparent" Tapped="RowTapped" ContextRequested="RowContextRequested"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /><ColumnDefinition Width="156" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                            <Button Classes="modLink" Click="OpenRowDetails" Content="{Binding}" ContentTemplate="{StaticResource ModIdentity}" AutomationProperties.Name="{Binding Title}" />
                            <ContentControl Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource ClientCell}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock Text="{Binding PackageStatus}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Shell.TextSecondary}" /><TextBlock Text="{Binding VersionChange}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Shell.TextSecondary}" Margin="0,3,0,0" IsVisible="{Binding HasVersionChange}" /></StackPanel>
                            <Button Grid.Column="3" Classes="rowButton" Classes.update="{Binding IsUpdate}" Content="{Binding ActionText}" IsEnabled="{Binding CanAct}" Click="InstallFromBrowse" IsVisible="{Binding ShowOfferAction}" />
                            <Button Grid.Column="3" Classes="rowButton" Content="{l:Loc 'Details'}" Click="OpenRowDetails" IsVisible="{Binding ShowDetails}" />
                            <ContentControl Grid.Column="3" Content="{Binding Job}" ContentTemplate="{StaticResource JobBox}" VerticalAlignment="Center" IsVisible="{Binding HasJob}" />
                        </Grid>
                    </DataTemplate></ListBox.ItemTemplate></ListBox>
                    <TextBlock x:Name="BrowseEmpty" Classes="note" IsHitTestVisible="False" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="340" Margin="16" />
                </Grid>
            </DockPanel>

            <DockPanel x:Name="ModPage" IsVisible="False">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Button x:Name="BackButton" Click="ClosePage" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal"><icons:MaterialIcon Kind="ArrowLeft" Width="17" Height="17" Margin="0,0,7,0" /><TextBlock x:Name="BackText" /></StackPanel></Button>
                </DockPanel>
                <!-- Stays in view while the page scrolls; shown only on the Settings tab. -->
                <Border x:Name="SettingsFooter" DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Shell.Border}" BorderThickness="1" Background="{DynamicResource Shell.Panel}" CornerRadius="9" Padding="10" Margin="0,12,0,0">
                    <DockPanel><WrapPanel x:Name="SettingsActions" DockPanel.Dock="Right" Margin="12,0,0,0"><Button x:Name="SaveSettingsButton" Margin="0,0,8,0" Classes="accent" Content="{l:Loc 'Save settings'}" Click="SaveSettings" /><Button x:Name="DiscardSettingsButton" Margin="0,0,8,0" Content="{l:Loc 'Discard changes'}" Click="DiscardModSettings" /><Button x:Name="ResetSettingsButton" Margin="0,0,8,0" Content="{l:Loc 'Reset to defaults'}" Click="ResetSettings" /></WrapPanel>
                        <TextBlock x:Name="SettingsHint" Classes="note" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
                <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
                    <Border Background="{DynamicResource Shell.Panel}" BorderBrush="{DynamicResource Shell.Border}" BorderThickness="1" CornerRadius="9" Padding="18" Margin="0,0,0,12">
                        <DockPanel>
                            <!-- A square as tall as the text beside it, whatever that wraps to; the limit leaves the text room in a narrow window. -->
                            <Border DockPanel.Dock="Left" Classes="tile" Width="{Binding #PageInfo.Bounds.Height}" MaxWidth="220" Height="NaN" Margin="0,0,18,0"><Grid>
                                <icons:MaterialIcon x:Name="PageIcon" Width="88" Height="88" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Shell.TextSecondary}" />
                                <Border Margin="2" CornerRadius="8" ClipToBounds="True"><Image x:Name="PageImage" Stretch="Uniform" /></Border>
                            </Grid></Border>
                            <StackPanel x:Name="PageInfo">
                                <TextBlock x:Name="PageTitle" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock x:Name="PageByline" Classes="note" FontSize="12" Margin="0,4,0,0" />
                                <TextBlock x:Name="PageDescription" TextWrapping="Wrap" Foreground="{DynamicResource Shell.TextSecondary}" Margin="0,9,0,0" />
                                <WrapPanel Margin="0,12,0,0">
                                    <CheckBox x:Name="PageEnabled" Content="{l:Loc 'Enabled for this checkout'}" VerticalAlignment="Center" Margin="0,0,14,0" Click="TogglePage" />
                                    <TextBlock x:Name="PagePackageStatus" Classes="note" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <Button x:Name="PageAction" Classes="accent" MinWidth="100" Margin="0,0,8,0" Click="PageActionClicked" />
                                    <Button x:Name="PageMenuButton" Classes="icon" Click="OpenPageMenu" ToolTip.Tip="{l:Loc 'More'}" AutomationProperties.Name="{l:Loc 'More mod actions'}"><icons:MaterialIcon Kind="DotsVertical" Width="18" Height="18" /></Button>
                                </WrapPanel>
                                <TextBlock x:Name="PageStats" Classes="note" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,8" />
                                <StackPanel x:Name="PageIncompatible" Orientation="Horizontal" Margin="0,0,0,8" IsVisible="False">
                                    <icons:MaterialIcon Kind="AlertCircle" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource Shell.Warning}" />
                                    <TextBlock x:Name="PageIncompatibleText" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource Shell.Warning}" />
                                </StackPanel>
                                <ItemsControl x:Name="PageTags"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Classes="tag" Margin="0,0,6,0"><TextBlock Text="{Binding}" FontSize="11" /></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                <TabControl x:Name="PageTabs" SelectionChanged="PageTabChanged">
                    <TabItem x:Name="ModOverviewPage" Header="{l:Loc 'Overview'}"><DockPanel Margin="0,12,0,0">
                        <StackPanel x:Name="OverviewPanel" />
                    </DockPanel></TabItem>
                    <TabItem x:Name="ModSettingsPage" Header="{l:Loc 'Settings'}"><DockPanel Margin="0,12,0,0">
                        <Border Background="{DynamicResource Shell.Panel}" BorderBrush="{DynamicResource Shell.Border}" BorderThickness="1" CornerRadius="9" Padding="16"><StackPanel>
                            <TextBlock Text="{l:Loc 'Mod settings'}" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="{l:Loc 'Shared by every league where this mod runs.'}" Classes="note" FontSize="12" Margin="0,6,0,16" TextWrapping="Wrap" /><StackPanel x:Name="SettingsPanel" />
                        </StackPanel></Border>
                    </DockPanel></TabItem>
                    <TabItem x:Name="ModVersionsPage" Header="{l:Loc 'Versions'}"><ListBox x:Name="VersionList" Classes="mods" ScrollViewer.VerticalScrollBarVisibility="Disabled" Margin="0,12,0,0"><ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate>
                        <Grid Background="Transparent" Tapped="RowTapped" ContextRequested="RowContextRequested"><Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="100" /><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Version}" Classes="cell" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{Binding Date}" Classes="cell" /><TextBlock Grid.Column="2" Text="{Binding Size}" Classes="cell" /><TextBlock Grid.Column="3" Text="{Binding Notes}" Classes="cell" Foreground="{DynamicResource Shell.TextSecondary}" ToolTip.Tip="{Binding Notes}" Margin="0,0,12,0" /><Button Grid.Column="4" Classes="rowButton" Content="{Binding ActionText}" IsEnabled="{Binding CanAct}" Click="InstallVersion" />
                        </Grid>
                    </DataTemplate></ListBox.ItemTemplate></ListBox></TabItem>
                </TabControl>
                </StackPanel></ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
