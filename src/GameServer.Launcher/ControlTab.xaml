<UserControl x:Class="GameServer.Launcher.ControlTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top">
            <WrapPanel x:Name="Actions">
                <Button x:Name="PlayButton" Style="{StaticResource Primary}" Content="▶ Play (servers + game)" Click="Play"
                        ToolTip="live.ps1: builds and restarts the servers, then starts the client (closes a running one)" />
                <Button Content="Start servers" Click="StartServers" ToolTip="live.ps1 -NoClient: restarts the servers, keeps a running client" />
                <Button Content="Start game" Click="StartGame" ToolTip="live.ps1 -ClientOnly: only the client, against the running servers; refuses a second client" />
                <Button Content="■ Stop all" Click="StopAll" ToolTip="live.ps1 -Stop: the client, the walk-map recorder and the servers" />
                <Button Content="Stop game" Click="StopGame" ToolTip="Closes the client; the servers keep running" />
            </WrapPanel>
            <WrapPanel>
                <TextBlock Text="Restart:" VerticalAlignment="Center" Margin="0,0,8,6" />
                <Button Content="Gateway" Click="Restart" Tag="Gateway" ToolTip="live.ps1 -Only Gateway: the client drops to the login screen; log in and Play again" />
                <Button Content="Auth" Click="Restart" Tag="Auth" ToolTip="live.ps1 -Only Auth" />
                <Button Content="Patch" Click="Restart" Tag="Patch" ToolTip="live.ps1 -Only Patch" />
                <Separator Width="16" Visibility="Hidden" />
                <CheckBox x:Name="Walkmaps" Content="Walk maps (-Walkmaps)" ToolTip="Capture each area's walk map with Frida (GettingStarted step 9)" />
                <CheckBox x:Name="NoBuild" Content="Skip build (-NoBuild)" />
                <CheckBox x:Name="NoExtract" Content="Skip data check (-NoExtract)" />
                <CheckBox x:Name="TrayWhileGame" Content="Tray while the game runs" Checked="TrayChanged" Unchecked="TrayChanged"
                          ToolTip="Hide the launcher in the tray when the game client starts, and bring it back when the client closes" />
            </WrapPanel>
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="Services" Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                <ListView x:Name="ServiceList" BorderThickness="0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="26">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="●" FontSize="15" Foreground="{Binding Lamp}" /></DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Service" Width="80" DisplayMemberBinding="{Binding Name}" />
                            <GridViewColumn Header="State" Width="150" DisplayMemberBinding="{Binding State}" />
                            <GridViewColumn Header="Ports" Width="80" DisplayMemberBinding="{Binding Ports}" />
                            <GridViewColumn Header="PID" Width="60" DisplayMemberBinding="{Binding Pid}" />
                            <GridViewColumn Header="Uptime" Width="70" DisplayMemberBinding="{Binding Uptime}" />
                            <GridViewColumn Header="CPU" Width="55" DisplayMemberBinding="{Binding Cpu}" />
                            <GridViewColumn Header="Memory" Width="75" DisplayMemberBinding="{Binding Memory}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </GroupBox>

            <GroupBox Header="Setup" Grid.Row="0" Grid.Column="1" Grid.RowSpan="2">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                        <Button Content="Check again" Click="CheckSetup" />
                        <Button Content="Game data" Click="CheckData" ToolTip="extract-data.ps1 -List: which extracted files are missing or stale" />
                        <Button Content="Open logs folder" Click="OpenLogs" />
                    </WrapPanel>
                    <ItemsControl x:Name="SetupList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,1">
                                    <TextBlock Text="{Binding Glyph}" Foreground="{Binding Brush}" Width="18" FontWeight="Bold" />
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" ToolTip="{Binding Hint}" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </GroupBox>

            <TextBlock x:Name="RunState" Grid.Row="1" Grid.Column="0" Margin="2,0,8,6" FontWeight="SemiBold" Text="Ready." TextWrapping="Wrap" />

            <GroupBox Header="live.ps1 output" Grid.Row="2" Grid.ColumnSpan="2" Margin="0">
                <DockPanel>
                    <Button DockPanel.Dock="Bottom" HorizontalAlignment="Left" Content="Clear" Click="ClearOutput" Margin="0,6,0,0" />
                    <TextBox x:Name="Output" IsReadOnly="True" FontFamily="{StaticResource Mono}" FontSize="12"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
                </DockPanel>
            </GroupBox>
        </Grid>
    </DockPanel>
</UserControl>
