<UserControl x:Class="GameServer.Launcher.ControlTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="10">
        <!-- Servers on the left, the game in the middle, stopping everything on the right. Disabled while live.ps1 runs. -->
        <Grid x:Name="Actions" DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="180" />
            </Grid.ColumnDefinitions>

            <!-- Every card has the same grid: its title, a 40 px row and a 32 px row of buttons (80 px with the gap), then
                 its switches at the bottom, so the buttons line up across the cards. -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="40" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="32" />
                        <RowDefinition Height="*" MinHeight="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock x:Name="ServersLamp" DockPanel.Dock="Right" Text="● stopped" Foreground="Gray" FontWeight="SemiBold" />
                        <TextBlock Text="Servers" Style="{StaticResource CardTitle}" />
                    </DockPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource Go}" Content="▶  Start servers" Click="StartServers"
                                ToolTip="live.ps1 -NoClient: builds and restarts Patch, Auth and Gateway; a running client stays" />
                        <Button Grid.Column="2" Style="{StaticResource Halt}" Content="■  Stop servers" Click="StopServers"
                                ToolTip="live.ps1 -Stop -NoClient: the servers and the walk-map recorder; the client stays (back at the login screen)" />
                    </Grid>
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Restart" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#546E7A" />
                        <Button Grid.Column="1" Style="{StaticResource Quiet}" Content="Gateway" Click="Restart" Tag="Gateway"
                                ToolTip="live.ps1 -Only Gateway: rebuilt and restarted; the client drops to the login screen, log in and Play again" />
                        <Button Grid.Column="3" Style="{StaticResource Quiet}" Content="Auth" Click="Restart" Tag="Auth" ToolTip="live.ps1 -Only Auth" />
                        <Button Grid.Column="5" Style="{StaticResource Quiet}" Content="Patch" Click="Restart" Tag="Patch" ToolTip="live.ps1 -Only Patch" />
                    </Grid>
                    <WrapPanel Grid.Row="5">
                        <CheckBox x:Name="Walkmaps" Content="Walk maps" ToolTip="-Walkmaps: capture each area's walk map with Frida (GettingStarted step 9)" />
                        <CheckBox x:Name="NoBuild" Content="Skip build" ToolTip="-NoBuild" />
                        <CheckBox x:Name="NoExtract" Content="Skip data check" ToolTip="-NoExtract" />
                        <CheckBox x:Name="HotReload" Content="Hot reload"
                                  ToolTip="The Gateway runs under dotnet watch, so saved code edits apply with the game still running; off passes -NoHotReload" />
                    </WrapPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="40" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="32" />
                        <RowDefinition Height="*" MinHeight="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.ColumnSpan="3">
                        <TextBlock x:Name="GameLamp" DockPanel.Dock="Right" Text="● not running" Foreground="Gray" FontWeight="SemiBold" />
                        <TextBlock Text="Game" Style="{StaticResource CardTitle}" />
                    </DockPanel>
                    <Button x:Name="PlayButton" Grid.Row="1" Grid.RowSpan="3" Style="{StaticResource Main}" Click="Play"
                            ToolTip="live.ps1: builds and restarts the servers, then starts the game (closes a running one)">
                        <StackPanel>
                            <TextBlock Text="▶  PLAY" HorizontalAlignment="Center" />
                            <TextBlock Text="servers + game" FontSize="11" FontWeight="Normal" HorizontalAlignment="Center" Opacity="0.85" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource Go}" Content="Start game only" Click="StartGame"
                            ToolTip="live.ps1 -ClientOnly: only the client, against the running servers; refuses a second client" />
                    <Button Grid.Row="3" Grid.Column="2" Style="{StaticResource Halt}" Content="■  Close game" Click="StopGame"
                            ToolTip="Closes the client; the servers keep running" />
                    <CheckBox x:Name="TrayWhileGame" Grid.Row="5" Grid.ColumnSpan="3" Content="Tray while the game runs" Checked="TrayChanged" Unchecked="TrayChanged"
                              ToolTip="Hide the launcher in the tray when the game starts, and bring it back when the game closes" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="80" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Everything" Style="{StaticResource CardTitle}" />
                    <Button Grid.Row="1" Style="{StaticResource Halt}" Click="StopAll"
                            ToolTip="live.ps1 -Stop and the dev host: the game, the walk-map recorder, the servers and the account service">
                        <StackPanel>
                            <TextBlock Text="■  Stop all" FontSize="15" HorizontalAlignment="Center" />
                            <TextBlock Text="game, servers, dev host" FontSize="11" FontWeight="Normal" HorizontalAlignment="Center" Opacity="0.85" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="Services" Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                <ListView x:Name="ServiceList" BorderThickness="0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="26">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="●" FontSize="15" Foreground="{Binding Lamp}" /></DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Service" Width="80" DisplayMemberBinding="{Binding Name}" />
                            <GridViewColumn Header="State" Width="150" DisplayMemberBinding="{Binding State}" />
                            <GridViewColumn Header="Ports" Width="80" DisplayMemberBinding="{Binding Ports}" />
                            <GridViewColumn Header="PID" Width="60" DisplayMemberBinding="{Binding Pid}" />
                            <GridViewColumn Header="Uptime" Width="70" DisplayMemberBinding="{Binding Uptime}" />
                            <GridViewColumn Header="CPU" Width="55" DisplayMemberBinding="{Binding Cpu}" />
                            <GridViewColumn Header="Memory" Width="75" DisplayMemberBinding="{Binding Memory}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </GroupBox>

            <GroupBox Header="Setup" Grid.Row="0" Grid.Column="1" Grid.RowSpan="2">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="Change…" Click="ChangeServer" Margin="6,0,0,0" MinWidth="70"
                                ToolTip="Pick another LocalExile server checkout; the launcher starts again on it" />
                        <TextBlock Text="Server " VerticalAlignment="Center" Foreground="#546E7A" />
                        <TextBlock x:Name="ServerFolder" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                        <Button Content="Check again" Click="CheckSetup" />
                        <Button Content="Game data" Click="CheckData" ToolTip="extract-data.ps1 -List: which extracted files are missing or stale" />
                        <Button Content="Open logs folder" Click="OpenLogs" />
                        <Button Content="Check for updates" Click="CheckUpdates" ToolTip="Look for a newer launcher release on GitHub" />
                        <CheckBox x:Name="CheckAtStart" Content="at start" Checked="CheckAtStartChanged" Unchecked="CheckAtStartChanged"
                                  ToolTip="Look for a newer launcher release whenever the launcher starts (release builds)" />
                    </WrapPanel>
                    <ItemsControl x:Name="SetupList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,1">
                                    <TextBlock Text="{Binding Glyph}" Foreground="{Binding Brush}" Width="18" FontWeight="Bold" />
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" ToolTip="{Binding Hint}" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </GroupBox>

            <TextBlock x:Name="RunState" Grid.Row="1" Grid.Column="0" Margin="2,0,8,6" FontWeight="SemiBold" Text="Ready." TextWrapping="Wrap" />

            <GroupBox Header="live.ps1 output" Grid.Row="2" Grid.ColumnSpan="2" Margin="0">
                <DockPanel>
                    <Button DockPanel.Dock="Bottom" HorizontalAlignment="Left" Content="Clear" Click="ClearOutput" Margin="0,6,0,0" />
                    <TextBox x:Name="Output" IsReadOnly="True" FontFamily="{StaticResource Mono}" FontSize="12"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
                </DockPanel>
            </GroupBox>
        </Grid>
    </DockPanel>
</UserControl>
