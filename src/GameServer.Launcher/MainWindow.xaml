<Window x:Class="GameServer.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:l="clr-namespace:GameServer.Launcher"
        Title="LocalExile Launcher" Width="1280" Height="800" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Shell.Background}"
        TextElement.Foreground="{DynamicResource Shell.Text}"
        FontFamily="Segoe UI" FontSize="12.5">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- The sidebar: the name and the sections. -->
        <Border Background="{DynamicResource Shell.Sidebar}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,14,0,12">
                    <Border Width="30" Height="30" CornerRadius="6" Background="White">
                        <md:PackIcon Kind="ServerNetwork" Width="20" Height="20" Foreground="{DynamicResource Shell.Sidebar}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="LocalExile" FontSize="21" FontWeight="Bold" Foreground="White" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Border DockPanel.Dock="Top" Height="1" Background="#33FFFFFF" Margin="10,0,10,10" />
                <TextBlock x:Name="Version" DockPanel.Dock="Bottom" Foreground="{DynamicResource Shell.SidebarText}" Opacity="0.6"
                           FontSize="11" Margin="18,0,0,12" />
                <ListBox x:Name="Sections" Background="Transparent" BorderThickness="0" Margin="6,0" SelectionChanged="SectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="{DynamicResource Shell.SidebarText}" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Body" CornerRadius="4" Padding="10,8" Margin="0,1" Background="Transparent">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Body" Property="Background" Value="#1AFFFFFF" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Body" Property="Background" Value="{DynamicResource Shell.SidebarSelected}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="{Binding Icon}" Width="17" Height="17" Margin="0,0,12,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <DockPanel Grid.Column="1">
            <!-- The header: the section, the checkout's branch, the theme and the launcher's settings. -->
            <Border DockPanel.Dock="Top" Height="56" BorderBrush="{DynamicResource Shell.Border}" BorderThickness="0,0,0,1">
                <DockPanel Margin="20,0,14,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="BranchChip" BorderBrush="{DynamicResource Shell.Border}" BorderThickness="1" CornerRadius="4"
                                Padding="10,5" Margin="0,0,10,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="SourceBranch" Width="15" Height="15" Margin="0,0,7,0" VerticalAlignment="Center"
                                             Foreground="{DynamicResource Shell.TextSecondary}" />
                                <TextBlock x:Name="BranchName" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Button x:Name="ThemeButton" Style="{StaticResource Shell.IconButton}" Click="CycleTheme">
                            <md:PackIcon x:Name="ThemeIcon" Kind="ThemeLightDark" Width="18" Height="18" />
                        </Button>
                        <md:PopupBox PlacementMode="BottomAndAlignRightEdges" StaysOpen="True" ToolTip="Launcher settings"
                                     Foreground="{DynamicResource Shell.TextSecondary}" Margin="4,0,0,0">
                            <md:PopupBox.ToggleContent>
                                <md:PackIcon Kind="CogOutline" Width="18" Height="18" Margin="7" />
                            </md:PopupBox.ToggleContent>
                            <StackPanel Margin="14,10" MinWidth="250" TextElement.Foreground="{DynamicResource Shell.Text}">
                                <TextBlock Text="LAUNCHER" Style="{StaticResource Shell.ColumnHeader}" Margin="0,0,0,8" />
                                <CheckBox x:Name="TrayWhileGame" Content="Tray while the game runs" Checked="TrayChanged" Unchecked="TrayChanged"
                                          ToolTip="Hide the launcher in the tray when the game starts, and bring it back when the game closes" />
                                <CheckBox x:Name="CheckAtStart" Content="Look for updates at start" Checked="CheckAtStartChanged" Unchecked="CheckAtStartChanged"
                                          ToolTip="Look for a newer launcher release whenever the launcher starts (release builds)" />
                                <Button Content="Check for updates" HorizontalAlignment="Left" Margin="0,6,0,0" Click="CheckUpdatesClicked"
                                        ToolTip="Look for a newer launcher release on GitHub" />
                            </StackPanel>
                        </md:PopupBox>
                    </StackPanel>
                    <TextBlock x:Name="SectionTitle" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- A newer release: shown when the check finds one (Updates.cs). -->
            <Border x:Name="UpdateBar" DockPanel.Dock="Top" Visibility="Collapsed" Background="{DynamicResource Shell.Banner}"
                    BorderBrush="{DynamicResource Shell.Border}" BorderThickness="0,0,0,1" Padding="20,7,14,1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="UpdateNow" Style="{StaticResource Shell.PrimaryButton}" Content="Update now" Click="UpdateClicked" />
                        <Button Content="What's new" Click="ReleasePageClicked" />
                        <Button Content="Later" Click="LaterClicked" />
                    </StackPanel>
                    <md:PackIcon DockPanel.Dock="Left" Kind="ArrowUpCircleOutline" Width="18" Height="18" Margin="0,0,8,6"
                                 VerticalAlignment="Center" Foreground="{DynamicResource Shell.Accent}" />
                    <TextBlock x:Name="UpdateText" VerticalAlignment="Center" Margin="0,0,0,6" TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <!-- What runs, at a glance, on every section. -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource Shell.Banner}" Padding="0,8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Ellipse x:Name="StatusLamp" Width="8" Height="8" Fill="{DynamicResource Shell.Idle}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText" Text="Looking for the services …" />
                    <TextBlock x:Name="StatusDetail" Style="{StaticResource Shell.Secondary}" />
                    <TextBlock Text="  ·  " Style="{StaticResource Shell.Secondary}" />
                    <TextBlock Text="Open logs" Foreground="{DynamicResource Shell.Accent}" Cursor="Hand" MouseLeftButtonUp="OpenLogsSection" />
                </StackPanel>
            </Border>

            <!-- The sections; one shows at a time (SectionChanged). -->
            <Grid>
                <l:ControlTab x:Name="Control" />
                <l:PerformanceTab x:Name="Performance" Visibility="Collapsed" />
                <l:TimingsTab x:Name="Timings" Visibility="Collapsed" />
                <l:LogsTab x:Name="LogsView" Visibility="Collapsed" />
                <l:AccountsTab x:Name="Accounts" Visibility="Collapsed" />
                <l:ConsoleTab x:Name="ConsoleView" Visibility="Collapsed" />
            </Grid>
        </DockPanel>
    </Grid>
</Window>
