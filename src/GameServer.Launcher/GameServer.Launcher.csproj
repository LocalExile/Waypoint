<Project Sdk="Microsoft.NET.Sdk">

  <!-- The desktop launcher for a LocalExile server checkout (docs/launcher.md). `dotnet publish src/GameServer.Launcher -o .`
       puts one LocalExileLauncher.exe in this repository's root. It references no server project: it drives a checkout
       through live.ps1, the Gateway's `commands`/`values` modes, the dev host's protocol and the server's logs. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon (NotifyIcon); its namespaces stay out of the implicit usings, where they clash with WPF's. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>LocalExileLauncher</AssemblyName>
    <RootNamespace>GameServer.Launcher</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <!-- A build from source; the release workflow passes the git tag's version (-p:Version=1.2.3). -->
    <Version>0.0.0-dev</Version>
    <!-- The exe's icon (Explorer, shortcuts). Assets\icon.png is its 1024 px source; the .ico holds the sizes Windows
         uses, 16 to 256 px. -->
    <ApplicationIcon>Assets\LocalExile.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- The window's (title bar, taskbar) and the tray's icon, and the sidebar's logo, read from the assembly. -->
    <Resource Include="Assets\LocalExile.ico" />
    <Resource Include="Assets\logo-128.png" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GameServer.Launcher.Tests" />
    <!-- WPF leaves System.IO out of the implicit usings (its Path clashes with System.Windows.Shapes.Path, unused here). -->
    <Using Include="System.IO" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- The look: Material Design controls, restyled flat and blue in Shell.xaml (Theme.cs switches light and dark). -->
    <PackageReference Include="MaterialDesignThemes" Version="5.4.0" />
    <PackageReference Include="Microsoft.Diagnostics.NETCore.Client" Version="0.2.745401" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.8" />
    <PackageReference Include="System.Management" Version="10.0.12" />
  </ItemGroup>

</Project>
