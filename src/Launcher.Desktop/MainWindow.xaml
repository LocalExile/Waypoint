<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Launcher.Desktop.MainWindow" Title="Launcher" Icon="app.ico" Style="{StaticResource {x:Type Window}}" Width="1240" Height="900" MinWidth="1020" MinHeight="730" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="210"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Border Background="#0C1119" Padding="22,30">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <Border Background="#244338" CornerRadius="9" Width="44" Height="44" HorizontalAlignment="Left" Margin="0,0,0,16">
            <TextBlock Text="↗" FontSize="30" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock x:Name="BrandName" FontSize="24" FontWeight="SemiBold"/>
          <TextBlock x:Name="BrandSubtitle" Style="{StaticResource Caption}" Margin="0,6,0,28"/>
          <TextBlock Text="LOCAL WORKSPACE" FontSize="10" Foreground="{StaticResource Muted}"/>
          <TextBlock Text="LocalExile" FontSize="16" Margin="0,8,0,6"/>
          <TextBlock x:Name="SidebarBranch" Text="No checkout selected" Style="{StaticResource Caption}"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
          <TextBlock Text="Your checkout. Your saves." Foreground="{StaticResource Accent}" FontSize="12"/>
          <TextBlock x:Name="VersionLabel" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
          <TextBlock Text="Closing the launcher leaves services running." Style="{StaticResource Caption}" Margin="0,16,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="30,26,30,20">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid Margin="0,0,0,20">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Make room for the next run." FontSize="27" FontWeight="SemiBold"/>
          <TextBlock x:Name="CheckoutLabel" Text="Select a LocalExile checkout in Settings." Style="{StaticResource Caption}" Margin="0,8,16,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
        </StackPanel>
        <Button Grid.Column="1" Content="Refresh" Click="Refresh_Click" VerticalAlignment="Center" Margin="0"/>
      </Grid>
      <Border Grid.Row="1" Background="#202D39" CornerRadius="7" Padding="14,10" Margin="0,0,0,18">
        <DockPanel>
          <ProgressBar x:Name="BusyProgress" DockPanel.Dock="Right" Width="65" Height="4" IsIndeterminate="True" Visibility="Collapsed" Margin="16,0,0,0"/>
          <TextBlock x:Name="StatusLabel" Text="Choose your checkout to get started." FontSize="13"/>
        </DockPanel>
      </Border>
      <TabControl Grid.Row="2" x:Name="Pages">
        <TabItem Header="Play">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="Ready when you are" FontSize="21" FontWeight="SemiBold"/>
                      <TextBlock x:Name="ReadinessLabel" Text="Check the setup below before starting." Foreground="{StaticResource Muted}" Margin="0,6,20,0"/>
                    </StackPanel>
                    <Button x:Name="PlayButton" Grid.Column="1" Content="▶  Play" Style="{StaticResource Primary}" Click="Play_Click" Padding="32,14" Margin="0"/>
                  </Grid>
                  <WrapPanel Margin="0,20,0,0">
                    <Button Content="Start servers" Click="Start_Click"/>
                    <Button Content="Stop servers" Click="Stop_Click"/>
                    <Button Content="Close game" Click="CloseGame_Click"/>
                    <Button Content="Open logs folder" Click="OpenLogs_Click"/>
                  </WrapPanel>
                </StackPanel>
              </Border>
              <TextBlock Text="SERVICES" Style="{StaticResource Caption}" Margin="0,0,0,10"/>
              <Border Style="{StaticResource Card}" Padding="16,6">
                <ItemsControl x:Name="ServiceList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,12">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="110"/>
                          <ColumnDefinition Width="90"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                          <TextBlock Text="{Binding PortText}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{Binding StateColor}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0,14,0">
                          <TextBlock Text="{Binding Metrics}" Style="{StaticResource Caption}"/>
                          <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                          <Button Content="{Binding Action}" Tag="{Binding Name}" Click="Service_Click" IsEnabled="{Binding CanAct}" Padding="12,7"/>
                          <Button Content="↻" Tag="{Binding Name}" Click="Restart_Click" IsEnabled="{Binding CanRestart}" ToolTip="Restart service" Padding="11,7" Margin="0"/>
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
              <Expander Header="Setup and compatibility" IsExpanded="True" Foreground="#ECF1F8" Margin="0,2,0,12">
                <ItemsControl x:Name="RequirementList" Margin="0,12,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="25"/>
                          <ColumnDefinition Width="165"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Symbol}" Foreground="{Binding Color}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource Caption}"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Expander>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="Builds">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="Know what you’re running" FontSize="21" FontWeight="SemiBold"/>
                  <TextBlock Text="Build the selected checkout without switching or modifying its Git branch." Foreground="{StaticResource Muted}" Margin="0,8,0,20"/>
                  <TextBlock Text="SELECTED SOURCE" Style="{StaticResource Caption}"/>
                  <TextBox x:Name="SourceIdentity" IsReadOnly="True" Margin="0,8,0,18"/>
                  <TextBlock Text="BUILT COMPONENTS · DEBUG" Style="{StaticResource Caption}"/>
                  <TextBox x:Name="BuildIdentity" IsReadOnly="True" TextWrapping="Wrap" Margin="0,8,0,18"/>
                  <WrapPanel>
                    <Button Content="Build checkout" Style="{StaticResource Primary}" Click="Build_Click"/>
                    <Button Content="Open checkout folder" Click="OpenCheckout_Click"/>
                  </WrapPanel>
                  <TextBlock Text="Stop services before rebuilding. Start uses the supported launch script; adding a stopped service beside running services reuses its existing build. Stop all services and build first after changing source." Foreground="{StaticResource Muted}" Margin="0,16,0,0"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="Environment" FontSize="18"/>
                  <TextBlock x:Name="EnvironmentIdentity" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="Performance">
          <StackPanel>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Live process measurements" FontSize="21" FontWeight="SemiBold"/>
                <TextBlock Text="CPU is the share of this machine’s total logical processors between refreshes. A dash means no running process or no second sample yet." Foreground="{StaticResource Muted}" Margin="0,8,0,18"/>
                <ItemsControl x:Name="PerformanceList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,12">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="110"/>
                          <ColumnDefinition Width="120"/>
                          <ColumnDefinition Width="130"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="{Binding Cpu}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Memory}"/>
                        <TextBlock Grid.Column="3" Text="{Binding Uptime}" Foreground="{StaticResource Muted}"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <TextBlock Text="Gateway phase timings exist in LocalExile’s LocalExile.Gateway meter. Collecting those timings and recording benchmark comparisons are planned separately; these process measurements do not represent time spent in game systems." Foreground="{StaticResource Muted}"/>
          </StackPanel>
        </TabItem>
        <TabItem Header="Logs">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <WrapPanel Margin="0,0,0,12">
              <Button Content="Operations" Tag="Operations" Click="LogSource_Click"/>
              <Button Content="Patch" Tag="Patch" Click="LogSource_Click"/>
              <Button Content="Gateway" Tag="Gateway" Click="LogSource_Click"/>
              <Button Content="Auth" Tag="Auth" Click="LogSource_Click"/>
              <Button Content="Open folder" Click="OpenLogs_Click"/>
            </WrapPanel>
            <TextBox x:Name="LogText" Grid.Row="1" IsReadOnly="True" FontFamily="Cascadia Mono,Consolas" FontSize="12" TextWrapping="NoWrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
          </Grid>
        </TabItem>
        <TabItem Header="Settings" x:Name="SettingsPage">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="Connect your checkout" FontSize="21" FontWeight="SemiBold"/>
                  <TextBlock Text="Select the folder containing GameServer.slnx. The launcher keeps its own settings outside the repository." Foreground="{StaticResource Muted}" Margin="0,8,0,18"/>
                  <TextBlock Text="LocalExile repository folder" Margin="0,0,0,8"/>
                  <DockPanel>
                    <Button Content="Browse…" DockPanel.Dock="Right" Click="Browse_Click" Margin="10,0,0,0"/>
                    <TextBox x:Name="RepositoryPathBox" AutomationProperties.Name="LocalExile repository folder"/>
                  </DockPanel>
                  <CheckBox x:Name="UseProfileBox" Content="Use this checkout’s local runtime wrapper when present"/>
                  <TextBlock Text="Preserves the existing saves and runtime settings from config/runtime.local.ps1. Adapter v1 supports literal Game_* assignments and standard local ports. Unsupported profiles fail with an explanation." Style="{StaticResource Caption}" Margin="0,0,0,18"/>
                  <WrapPanel>
                    <Button Content="Save and check" Style="{StaticResource Primary}" Click="Save_Click"/>
                    <Button Content="Open launcher data" Click="OpenData_Click"/>
                    <Button Content="Open setup guide" Click="OpenGuide_Click"/>
                  </WrapPanel>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="What this version manages" FontSize="18"/>
                  <TextBlock Text="Windows · standalone PoE 3.29.3b · .NET 10 · Debug builds · standard localhost ports. Game launch always passes through live.ps1. Services stop through Ctrl+C; the launcher never force-kills a server or game." Foreground="{StaticResource Muted}" Margin="0,10,0,0"/>
                  <TextBlock Text="Product name and subtitle: branding/brand.json. Application icon: branding/app.ico. The internal application identity remains stable when the display name changes." Style="{StaticResource Caption}" Margin="0,16,0,0"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
      <TextBlock Grid.Row="3" x:Name="LastCheckedLabel" Text="Checks run locally. No account or game data is uploaded." Style="{StaticResource Caption}" Margin="0,16,0,0"/>
    </Grid>
  </Grid>
</Window>
