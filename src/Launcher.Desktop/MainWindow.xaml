<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Launcher.Desktop" x:Class="Launcher.Desktop.MainWindow" Title="Launcher" Icon="app.ico" Style="{StaticResource {x:Type Window}}" Width="1240" Height="900" MinWidth="1020" MinHeight="730" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <DataTemplate x:Key="SetupRequirementTemplate">
      <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Symbol}" Foreground="{Binding Color}" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,0,12,0" VerticalAlignment="Center"/>
        <Button Grid.Column="3" Content="{Binding ActionLabel}" Tag="{Binding}" Click="SetupStep_Click" Padding="10,7" FontSize="12" Margin="0"/>
      </Grid>
    </DataTemplate>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="210"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Border Background="#0C1119" Padding="22,30">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <Border Background="#244338" CornerRadius="9" Width="44" Height="44" HorizontalAlignment="Left" Margin="0,0,0,16">
            <TextBlock Text="↗" FontSize="30" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock x:Name="BrandName" FontSize="24" FontWeight="SemiBold"/>
          <TextBlock x:Name="BrandSubtitle" Style="{StaticResource Caption}" Margin="0,6,0,28"/>
          <TextBlock Text="CURRENT SOURCE" FontSize="10" Foreground="{StaticResource Muted}"/>
          <TextBlock x:Name="SidebarBranch" Text="No checkout selected" FontSize="16" Margin="0,8,0,0"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
          <TextBlock Text="Your checkout. Your saves." Foreground="{StaticResource Accent}" FontSize="12"/>
          <TextBlock x:Name="VersionLabel" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
          <TextBlock Text="Closing the launcher leaves services running." Style="{StaticResource Caption}" Margin="0,16,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="30,26,30,20">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid Margin="0,0,0,20">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="WorkspaceTitle" Text="Workspace" FontSize="27" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,16,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
          <TextBlock x:Name="CheckoutLabel" Text="Select a LocalExile checkout in Settings." Style="{StaticResource Caption}" Margin="0,8,16,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Change location" Click="ChangeLocation_Click"/><Button Content="Refresh" Click="Refresh_Click" Margin="0"/></StackPanel>
      </Grid>
      <Border Grid.Row="1" Background="#202D39" CornerRadius="7" Padding="14,10" Margin="0,0,0,18">
        <DockPanel>
          <ProgressBar x:Name="BusyProgress" DockPanel.Dock="Right" Width="65" Height="4" IsIndeterminate="True" Visibility="Collapsed" Margin="16,0,0,0"/>
          <StackPanel>
            <TextBlock x:Name="StatusLabel" Text="Choose your checkout to get started." FontSize="13"/>
            <TextBlock x:Name="OperationDetail" Style="{StaticResource Caption}" Visibility="Collapsed" Margin="0,6,0,0"/>
            <WrapPanel x:Name="FailureActions" Visibility="Collapsed" Margin="0,10,0,0">
              <Button Content="Open failed stage log" Click="OpenOperationLog_Click" Padding="10,6"/>
              <Button Content="View operation output" Click="ViewOperations_Click" Padding="10,6"/>
              <Button Content="Retry operation" Click="Retry_Click" Padding="10,6"/>
            </WrapPanel>
          </StackPanel>
        </DockPanel>
      </Border>
      <TabControl Grid.Row="2" x:Name="Pages">
        <TabItem Header="Play">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="Ready when you are" FontSize="21" FontWeight="SemiBold"/>
                      <TextBlock x:Name="ReadinessLabel" Text="Check the setup below before starting." Foreground="{StaticResource Muted}" Margin="0,6,20,0"/>
                    </StackPanel>
                    <Button x:Name="PlayButton" Grid.Column="1" Content="▶  Play" Style="{StaticResource Primary}" Click="Play_Click" Padding="32,14" Margin="0"/>
                  </Grid>
                  <WrapPanel Margin="0,20,0,0">
                    <Button Content="Start servers" Click="Start_Click"/>
                    <Button Content="Stop servers" Click="Stop_Click"/>
                    <Button Content="Close game" Click="CloseGame_Click"/>
                    <Button Content="Open logs folder" Click="OpenLogs_Click"/>
                    <Button Content="Setup" Click="ShowSetup_Click"/>
                  </WrapPanel>
                </StackPanel>
              </Border>
              <TextBlock Text="SERVICES" Style="{StaticResource Caption}" Margin="0,0,0,10"/>
              <Border Style="{StaticResource Card}" Padding="16,6">
                <ItemsControl x:Name="ServiceList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,12">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="110"/>
                          <ColumnDefinition Width="90"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                          <TextBlock Text="{Binding PortText}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{Binding StateColor}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0,14,0">
                          <TextBlock Text="{Binding Metrics}" Style="{StaticResource Caption}"/>
                          <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                          <Button Content="{Binding Action}" Tag="{Binding Name}" Click="Service_Click" IsEnabled="{Binding CanAct}" Padding="12,7"/>
                          <Button Content="↻" Tag="{Binding Name}" Click="Restart_Click" IsEnabled="{Binding CanRestart}" ToolTip="Restart service" Padding="11,7" Margin="0"/>
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
              <Expander Header="Setup and compatibility" IsExpanded="True" Foreground="#ECF1F8" Margin="0,2,0,12">
                <ItemsControl x:Name="RequirementList" Margin="0,12,0,0" ItemTemplate="{StaticResource SetupRequirementTemplate}"/>
              </Expander>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="Setup" x:Name="SetupPage">
          <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="Choose how to get ready" FontSize="21"/>
              <TextBlock Text="Use an existing prepared checkout, or prepare a separate client copy in the selected checkout. The supported client is standalone PoE 3.29.3b." Foreground="{StaticResource Muted}" Margin="0,10,0,16"/>
              <WrapPanel><Button Content="Find LocalExile" Click="FindRepository_Click"/><Button Content="Choose installation" Click="ShowSettings_Click"/><Button Content="Open client folder" Click="OpenClient_Click"/><Button Content="Open setup guide" Click="OpenGuide_Click"/></WrapPanel>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="Prepare this checkout" FontSize="18"/>
              <TextBlock Text="Copy the complete client into its Client folder first. Preparation creates missing local keys and a prepared executable, then selects the local gateway in that copy. Close the game and stop services before making setup changes." Foreground="{StaticResource Muted}" Margin="0,10,0,16"/>
              <WrapPanel><Button Content="Prepare local client" Click="Prepare_Click"/><Button Content="Install extraction dependency" Click="Dependencies_Click"/><Button Content="Recheck setup" Click="Refresh_Click"/></WrapPanel>
            </StackPanel></Border>
            <ItemsControl x:Name="SetupRequirementList" ItemTemplate="{StaticResource SetupRequirementTemplate}"/>
            <Border Style="{StaticResource Card}" Margin="0,12,0,16"><StackPanel>
              <TextBlock Text="First local account" FontSize="18"/>
              <TextBlock Text="An account belongs to this LocalExile installation. Create one here, then sign in and create your character inside the game. The launcher does not store your password." Foreground="{StaticResource Muted}" Margin="0,10,0,16"/>
              <Button Content="Create local account" Click="CreateAccount_Click" HorizontalAlignment="Left"/>
            </StackPanel></Border>
          </StackPanel></ScrollViewer>
        </TabItem>
        <TabItem Header="Builds" x:Name="BuildsPage">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock Text="Branches and pull requests" FontSize="21" FontWeight="SemiBold"/>
                <TextBlock Text="Choose a local branch, a fetched remote branch or an upstream PR. Switching stops owned servers, backs up saves and builds the revision. Close the game first; press Play afterward." Foreground="{StaticResource Muted}" Margin="0,8,0,12"/>
                <WrapPanel Margin="0,0,0,12"><Button Content="Load / refresh list" Click="RefreshSources_Click"/><Button Content="Fetch remote branches" Click="FetchSources_Click"/></WrapPanel>
                <TextBlock x:Name="SourcesStatus" Text="Load the list to browse branches and open LocalExile PRs. Switching reuses the existing client copy." Style="{StaticResource Caption}" Margin="0,0,0,10"/>
                <TextBlock Text="Search branches and PRs" Style="{StaticResource Caption}" Margin="0,0,0,5"/>
                <TextBox x:Name="SourceSearch" AutomationProperties.Name="Search branches and pull requests" ToolTip="Search branch names, PR titles, authors or commit hashes" TextChanged="SourceSearch_Changed" Margin="0,0,0,8"/>
                <ListBox x:Name="SourcesList" Height="200" Background="#10151E" Foreground="#ECF1F8" BorderBrush="#38465B" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="SourceSelection_Changed">
                  <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="8"/><Setter Property="Foreground" Value="#ECF1F8"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#354A63"/></Trigger></Style.Triggers></Style></ListBox.ItemContainerStyle>
                  <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Label}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}"/><local:CommitText Value="{Binding Commit}" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <local:CommitText x:Name="SelectedSourceIdentity" Margin="0,10,0,0"/>
                <CheckBox x:Name="FreshSavesBox" Content="Start fresh (replace accounts and characters)"/>
                <CheckBox x:Name="AutoBackupBox" Content="Automatic save backups" Checked="BackupPreference_Changed" Unchecked="BackupPreference_Changed" Margin="0,0,0,10"/>
                <TextBlock x:Name="BackupModeDetail" Style="{StaticResource Caption}" Margin="0,0,0,12"/>
                <WrapPanel><Button x:Name="SwitchSourceButton" Content="Switch and build" Style="{StaticResource Primary}" Click="SwitchSource_Click" IsEnabled="False"/><Button Content="Manage backups" Click="ShowBackups_Click"/></WrapPanel>
                <DockPanel Margin="0,16,0,0"><Button Content="Use PR number" DockPanel.Dock="Right" Click="SwitchPrNumber_Click" Margin="10,0,0,0"/><TextBox x:Name="PrNumberBox" AutomationProperties.Name="Upstream PR number" ToolTip="Enter a positive LocalExile PR number, including closed PRs"/></DockPanel>
              </StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock Text="Hot reload" FontSize="21" FontWeight="SemiBold"/>
                <CheckBox x:Name="HotReloadBox" Content="Watch Gateway code while playing" Checked="HotReloadPreference_Changed" Unchecked="HotReloadPreference_Changed"/>
                <TextBlock x:Name="HotReloadStateLabel" FontSize="16" Foreground="{StaticResource Accent}"/>
                <TextBlock x:Name="HotReloadDetail" Style="{StaticResource Caption}" Margin="0,8,0,12"/>
                <TextBlock Text="Compatible saved code edits apply in game. Compile errors keep old code running. Incompatible edits restart Gateway and return you to login. Static data and Auth/Patch changes can need a restart. Branch/PR switching always stops services first." Foreground="{StaticResource Muted}"/>
                <WrapPanel Margin="0,14,0,0"><Button Content="Gateway output" Click="GatewayLog_Click"/><Button Content="Restart Gateway" Click="RestartGateway_Click"/><Button Content="Reload game-data overrides" Click="ReloadData_Click"/></WrapPanel>
                <TextBlock Text="Game-data reload uses /game_data reload through the checkout’s optional native helper (Python + Frida, client in game). It reloads SQLite overrides; it does not reload extracted files or rebuild source. The launcher waits for a revision confirmation." Style="{StaticResource Caption}" Margin="0,10,0,0"/>
              </StackPanel></Border>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="Know what you’re running" FontSize="21" FontWeight="SemiBold"/>
                  <TextBlock Text="Source and built component identities are separate. Hot reload can apply uncommitted code edits; a build hash identifies the original compiled revision." Foreground="{StaticResource Muted}" Margin="0,8,0,20"/>
                  <TextBlock Text="SELECTED SOURCE" Style="{StaticResource Caption}"/>
                  <local:CommitText x:Name="SourceIdentity" Margin="0,8,0,18"/>
                  <TextBlock Text="BUILT COMPONENTS · DEBUG" Style="{StaticResource Caption}"/>
                  <local:CommitText x:Name="BuildIdentity" TextWrapping="Wrap" Margin="0,8,0,18"/>
                  <WrapPanel>
                    <Button Content="Build checkout" Style="{StaticResource Primary}" Click="Build_Click"/>
                    <Button Content="Open checkout folder" Click="OpenCheckout_Click"/>
                  </WrapPanel>
                  <TextBlock Text="Stop services before rebuilding. Starting a stopped service beside running services reuses its existing build. Stop all services and build first after changing source. Game launch uses the supported upstream script." Foreground="{StaticResource Muted}" Margin="0,16,0,0"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="Environment" FontSize="18"/>
                  <TextBlock x:Name="EnvironmentIdentity" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="Mods" x:Name="ModsPage">
          <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="Mods" FontSize="21" FontWeight="SemiBold"/>
              <TextBlock x:Name="ModsStatus" Text="Select a checkout to inspect its mods." Foreground="{StaticResource Muted}" Margin="0,8,0,12"/>
              <CheckBox x:Name="ModsAutoBackupBox" Content="Automatic save backups before mod changes" Checked="ModsBackupPreference_Changed" Unchecked="ModsBackupPreference_Changed"/>
              <WrapPanel Margin="0,12,0,10"><Button x:Name="CheckModsButton" Content="Check live status" Click="CheckMods_Click" IsEnabled="False"/><Button x:Name="BuildAllModsButton" Content="Build source mods" Click="BuildAllMods_Click" IsEnabled="False"/><Button x:Name="OpenModsButton" Content="Open mods folder" Click="OpenMods_Click" IsEnabled="False"/><Button Content="Manage backups" Click="ShowBackups_Click"/></WrapPanel>
              <TextBlock Text="Search mods" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
              <TextBox x:Name="ModSearch" AutomationProperties.Name="Search mods" TextChanged="ModSearch_Changed" ToolTip="Search mod ID, version, kind, status or error" Margin="0,0,0,10"/>
              <ListBox x:Name="ModsList" Height="190" SelectionChanged="ModSelection_Changed" Background="#10151E" Foreground="#ECF1F8" BorderBrush="#38465B" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="8"/></Style></ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Id}" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
              <TextBlock x:Name="ModDetails" Text="Select a mod to view its dependencies and controls." Foreground="{StaticResource Muted}" Margin="0,12,0,12"/>
              <WrapPanel><Button x:Name="ToggleModButton" Content="Enable mod" Click="ToggleMod_Click" IsEnabled="False"/><Button x:Name="BuildModButton" Content="Build selected" Click="BuildMod_Click" IsEnabled="False"/><Button x:Name="ReloadModButton" Content="Reload selected" Click="ReloadMod_Click" IsEnabled="False"/><Button x:Name="OpenSelectedModButton" Content="Open selected folder" Click="OpenSelectedMod_Click" IsEnabled="False"/><Button Content="Gateway output" Click="GatewayLog_Click"/></WrapPanel>
              <TextBlock x:Name="ModCommandHint" Style="{StaticResource Caption}" Margin="0,12,0,0"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="Changes while playing" FontSize="17" FontWeight="SemiBold"/>
              <TextBlock Text="LocalExile watches built mod files independently of Gateway code hot reload. A build or reload resets the mod’s in-memory state and can reload its dependents. Disabling a dependency can unload other mods. These changes apply to this Gateway and all connected characters." Foreground="{StaticResource Muted}" Margin="0,8,0,10"/>
              <TextBlock Text="Live buttons use LocalExile’s optional native helper (Python + Frida, client in a playable area). With Gateway stopped, enable choices are saved for its next start. While Gateway runs without a usable helper, use the shown command in game or stop Gateway first. Loaded status is the last confirmed /mod reply and expires after two minutes or a binary/configuration change." Style="{StaticResource Caption}"/>
            </StackPanel></Border>
          </StackPanel></ScrollViewer>
        </TabItem>
        <TabItem Header="Backups" x:Name="BackupsPage">
          <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="Save backups" FontSize="21" FontWeight="SemiBold"/>
              <TextBlock Text="Backups belong to the selected save database. They include accounts, characters and other saved progress. Restoring does not switch source, client files, login keys or game-data overrides." Foreground="{StaticResource Muted}" Margin="0,8,0,12"/>
              <CheckBox x:Name="ManagerAutoBackupBox" Content="Automatic save backups" Checked="ManagerBackupPreference_Changed" Unchecked="ManagerBackupPreference_Changed"/>
              <WrapPanel Margin="0,0,0,12"><Button Content="Back up now" Click="BackupNow_Click"/><Button Content="Refresh backups" Click="RefreshBackups_Click"/><Button Content="Open backup folder" Click="OpenBackupFolder_Click"/></WrapPanel>
              <TextBlock x:Name="BackupsStatus" Style="{StaticResource Caption}" Margin="0,0,0,12"/>
              <ListBox x:Name="BackupsList" Height="230" Background="#10151E" Foreground="#ECF1F8" BorderBrush="#38465B" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="BackupSelection_Changed">
                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="8"/><Setter Property="Foreground" Value="#ECF1F8"/></Style></ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Summary}" FontWeight="SemiBold"/><local:CommitText Value="{Binding Identity}" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
              <local:CommitText x:Name="BackupDetails" TextWrapping="Wrap" Margin="0,12,0,12"/>
              <WrapPanel><Button x:Name="RestoreBackupButton" Content="Restore selected…" Click="RestoreBackup_Click" IsEnabled="False"/><Button x:Name="DeleteBackupButton" Content="Delete selected…" Click="DeleteBackup_Click" IsEnabled="False"/></WrapPanel>
              <Button x:Name="RestoreModChoicesButton" Content="Restore recorded mod choices…" Click="RestoreModChoices_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/>
              <TextBlock Text="Automatic backups run before branch/PR activation, builds, Gateway startup/restart, game-data reload, mod changes and save restore. Failed backups block those changes. Mod history includes saved choices, manifest versions, DLL fingerprints and the last confirmed runtime list when available. Restoring mod choices is separate from restoring saves and never installs DLLs. Last launched Gateway is recorded by this launcher; it does not track every code edit or launches made elsewhere." Style="{StaticResource Caption}" Margin="0,14,0,0"/>
            </StackPanel></Border>
          </StackPanel></ScrollViewer>
        </TabItem>
        <TabItem Header="Performance">
          <StackPanel>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Live process measurements" FontSize="21" FontWeight="SemiBold"/>
                <TextBlock Text="CPU is the share of this machine’s total logical processors between refreshes. A dash means no running process or no second sample yet." Foreground="{StaticResource Muted}" Margin="0,8,0,18"/>
                <ItemsControl x:Name="PerformanceList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,12">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="110"/>
                          <ColumnDefinition Width="120"/>
                          <ColumnDefinition Width="130"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="{Binding Cpu}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Memory}"/>
                        <TextBlock Grid.Column="3" Text="{Binding Uptime}" Foreground="{StaticResource Muted}"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <TextBlock Text="Gateway phase timings exist in LocalExile’s LocalExile.Gateway meter. Collecting those timings and recording benchmark comparisons are planned separately; these process measurements do not represent time spent in game systems." Foreground="{StaticResource Muted}"/>
          </StackPanel>
        </TabItem>
        <TabItem Header="Logs" x:Name="LogsPage">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <WrapPanel Margin="0,0,0,12">
              <Button Content="Operations" Tag="Operations" Click="LogSource_Click"/>
              <Button Content="Patch" Tag="Patch" Click="LogSource_Click"/>
              <Button Content="Gateway" Tag="Gateway" Click="LogSource_Click"/>
              <Button Content="Auth" Tag="Auth" Click="LogSource_Click"/>
              <Button Content="Game" Tag="Game" Click="LogSource_Click"/>
              <Button Content="Open folder" Click="OpenLogs_Click"/>
              <Button Content="Diagnostic report…" Click="DiagnosticReport_Click"/>
            </WrapPanel>
            <DockPanel Grid.Row="1" Margin="0,0,0,12"><TextBlock Text="Search" Margin="0,0,10,0" VerticalAlignment="Center"/><CheckBox x:Name="WarningsOnlyBox" DockPanel.Dock="Right" Content="Warnings / errors" Margin="14,0,0,0" Checked="LogFilter_Changed" Unchecked="LogFilter_Changed" VerticalAlignment="Center"/><TextBox x:Name="LogSearchBox" AutomationProperties.Name="Search selected log" TextChanged="LogSearch_Changed" ToolTip="Search selected log (case insensitive)"/></DockPanel>
            <TextBox x:Name="LogText" Grid.Row="2" IsReadOnly="True" FontFamily="Cascadia Mono,Consolas" FontSize="12" TextWrapping="NoWrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
          </Grid>
        </TabItem>
        <TabItem Header="Settings" x:Name="SettingsPage">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock Text="Find your LocalExile checkout" FontSize="21"/>
                <TextBlock Text="We check the latest upstream commit and look in common local folders. You can always choose a different location. Your saved checkout stays selected." Foreground="{StaticResource Muted}" Margin="0,8,0,14"/>
                <WrapPanel><Button x:Name="FindRepositoryButton" Content="Find LocalExile" Click="FindRepository_Click"/><Button Content="Browse for a different location…" Click="Browse_Click"/></WrapPanel>
                <TextBlock x:Name="DiscoveryStatus" Text="Automatic lookup runs on first use. You can also search again here." Margin="0,14,0,0"/>
                <local:CommitText x:Name="UpstreamIdentity" Visibility="Collapsed" Margin="0,8,0,0"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="250" Margin="0,12,0,0">
                  <ItemsControl x:Name="DiscoveredRepositories"><ItemsControl.ItemTemplate><DataTemplate>
                    <Border BorderBrush="#354254" BorderThickness="0,0,0,1" Padding="0,12"><StackPanel>
                      <TextBlock Text="{Binding Summary}" Foreground="{StaticResource Accent}"/>
                      <TextBlock Text="{Binding Root}" Margin="0,6,0,6" TextWrapping="Wrap"/>
                      <local:CommitText Value="{Binding CommitLabel}" Style="{StaticResource Caption}"/>
                      <Button Content="Use this checkout" Tag="{Binding}" Click="UseDiscoveredRepository_Click" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="12,7"/>
                    </StackPanel></Border>
                  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </ScrollViewer>
              </StackPanel></Border>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="Connect your checkout" FontSize="21" FontWeight="SemiBold"/>
                  <TextBlock Text="Select the folder containing GameServer.slnx. The launcher keeps its own settings outside the repository." Foreground="{StaticResource Muted}" Margin="0,8,0,18"/>
                  <TextBlock Text="LocalExile repository folder" Margin="0,0,0,8"/>
                  <DockPanel>
                    <Button Content="Browse…" DockPanel.Dock="Right" Click="Browse_Click" Margin="10,0,0,0"/>
                    <TextBox x:Name="RepositoryPathBox" AutomationProperties.Name="LocalExile repository folder" TextChanged="RepositoryPath_Changed"/>
                  </DockPanel>
                  <CheckBox x:Name="UseProfileBox" Content="Use this checkout’s local runtime wrapper when present"/>
                  <TextBlock Text="Preserves the existing saves and runtime settings from config/runtime.local.ps1. Adapter v1 supports literal Game_* assignments and standard local ports. Unsupported profiles fail with an explanation." Style="{StaticResource Caption}" Margin="0,0,0,18"/>
                  <WrapPanel>
                    <Button Content="Save and check" Style="{StaticResource Primary}" Click="Save_Click"/>
                    <Button Content="Open launcher data" Click="OpenData_Click"/>
                    <Button Content="Open setup guide" Click="OpenGuide_Click"/>
                  </WrapPanel>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="What this version manages" FontSize="18"/>
                  <TextBlock Text="Windows · standalone PoE 3.29.3b · .NET 10 · Debug builds · standard localhost ports. Game launch always passes through live.ps1. Services stop through Ctrl+C; the launcher never force-kills a server or game." Foreground="{StaticResource Muted}" Margin="0,10,0,0"/>
                  <TextBlock Text="Product name and subtitle: branding/brand.json. Application icon: branding/app.ico. The internal application identity remains stable when the display name changes." Style="{StaticResource Caption}" Margin="0,16,0,0"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
      <TextBlock Grid.Row="3" x:Name="LastCheckedLabel" Text="Checks run locally. No account or game data is uploaded." Style="{StaticResource Caption}" Margin="0,16,0,0"/>
    </Grid>
  </Grid>
</Window>
