<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Launcher.Desktop</RootNamespace>
    <AssemblyName Condition="'$(LauncherExecutableName)' != ''">$(LauncherExecutableName)</AssemblyName>
    <Product Condition="'$(LauncherExecutableName)' != ''">$(LauncherExecutableName)</Product>
    <ApplicationIcon>../../branding/app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Launcher.Core/Launcher.Core.csproj" />
    <Content Include="../../branding/brand.json" Link="brand.json" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="../../branding/app.ico" Link="app.ico" />
  </ItemGroup>
</Project>
