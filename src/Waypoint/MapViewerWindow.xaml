<l:FormWindow x:Class="Waypoint.MapViewerWindow"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
              xmlns:l="clr-namespace:Waypoint"
              Title="{l:Loc 'Map viewer'}" Width="1280" Height="800" MinWidth="900" MinHeight="560"
              WindowStartupLocation="CenterScreen" ShowInTaskbar="True">
    <Grid Margin="14">
        <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Margin="0,0,12,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel><DockPanel><ComboBox x:Name="AreaSort" DockPanel.Dock="Right" Width="110" SelectedIndex="0" SelectionChanged="AreaSortChanged" ToolTip="{l:Loc 'Sort areas'}"><ComboBoxItem Content="ID"/><ComboBoxItem Content="{l:Loc 'Name'}"/></ComboBox><md:PackIcon DockPanel.Dock="Right" Kind="SortVariant" Width="18" Height="18" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{DynamicResource Shell.TextSecondary}" ToolTip="{l:Loc 'Sort areas'}"/><TextBlock Text="{l:Loc 'Area'}" VerticalAlignment="Center"/></DockPanel><ComboBox x:Name="Areas" IsEditable="True" IsTextSearchEnabled="False" DisplayMemberPath="Display" Margin="0,3,0,8" SelectionChanged="AreaSelected" PreviewKeyDown="AreaKeyDown" DropDownClosed="AreaDropDownClosed"/></StackPanel>
            <StackPanel Grid.Row="1" x:Name="SeedInputs" Orientation="Horizontal"><StackPanel Width="165" Margin="0,0,8,0"><TextBlock Text="{l:Loc 'Seed'}"/><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource Shell.IconButton}" Click="RandomSeed" ToolTip="{l:Loc 'Random seed'}"><md:PackIcon Kind="DiceMultiple" Width="19" Height="19"/></Button><TextBox x:Name="Seed" Text="1" PreviewKeyDown="GenerateKeyDown"/></DockPanel></StackPanel><StackPanel Width="100" ToolTip="{l:Loc 'Area level can affect map generation. Leave blank to use the default level.'}"><TextBlock Text="{l:Loc 'Area level'}"/><TextBox x:Name="Level" PreviewKeyDown="GenerateKeyDown"/></StackPanel></StackPanel>
            <Button Grid.Row="2" x:Name="Generate" Content="{l:Loc 'Generate map'}" Style="{StaticResource Shell.PrimaryButton}" Click="GenerateClicked" Margin="0,12,0,10"/>
            <TabControl Grid.Row="3" x:Name="Tabs" SelectionChanged="FilterChanged"><TabItem Header="{l:Loc 'Tiles'}"/><TabItem Header="{l:Loc 'Objects and exits'}"/></TabControl>
            <Grid Grid.Row="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBox x:Name="Filter" TextChanged="FilterChanged" Margin="0,8"/><ListBox Grid.Row="1" x:Name="Entries" SelectionChanged="EntrySelected" DisplayMemberPath="Label"/></Grid>
        </Grid>
        <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,10">
                <Button DockPanel.Dock="Right" Content="{l:Loc 'Fit'}" Margin="0" VerticalAlignment="Center" Click="FitClicked" PreviewMouseLeftButtonDown="FitMouseDown" PreviewKeyDown="FitKeyDown"/>
                <Button x:Name="BackMap" DockPanel.Dock="Right" Style="{StaticResource Shell.IconButton}" VerticalAlignment="Center" Margin="0,0,4,0" IsEnabled="False" Click="BackMapClicked" ToolTip="{l:Loc 'Previous map'}"><md:PackIcon Kind="ArrowLeft" Width="18" Height="18"/></Button>
                <Button x:Name="CopyMapDetails" DockPanel.Dock="Right" IsEnabled="False" Style="{StaticResource Shell.IconButton}" VerticalAlignment="Center" Margin="0,0,8,0" Click="CopyMapDetailsClicked" ToolTip="{l:Loc 'Copy map details'}"><md:PackIcon Kind="ContentCopy" Width="17" Height="17"/></Button>
                <Button x:Name="DisplayOptions" DockPanel.Dock="Right" Margin="0,0,8,0" VerticalAlignment="Center" Click="DisplayOptionsClicked" Content="{l:Loc 'Display'}">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="WalkLayer" Header="{l:Loc 'Walkability'}" IsCheckable="True" IsChecked="True" StaysOpenOnClick="True" Checked="LayersChanged" Unchecked="LayersChanged"/>
                            <MenuItem x:Name="GridLayer" Header="{l:Loc 'Grid'}" IsCheckable="True" StaysOpenOnClick="True" Checked="LayersChanged" Unchecked="LayersChanged"/>
                            <MenuItem x:Name="ObjectLayer" Header="{l:Loc 'Landmarks'}" IsCheckable="True" IsChecked="True" StaysOpenOnClick="True" Checked="LayersChanged" Unchecked="LayersChanged"/>
                            <MenuItem x:Name="LinksLayer" Header="{l:Loc 'Teleport links'}" IsCheckable="True" StaysOpenOnClick="True" Checked="LayersChanged" Unchecked="LayersChanged"/>
                            <Separator/>
                            <MenuItem x:Name="MonsterLayer" Header="{l:Loc 'Monster packs'}" ToolTip="{l:Loc 'Show room-authored pack anchors, not individual or scattered monster positions.'}" IsCheckable="True" StaysOpenOnClick="True" Checked="LayersChanged" Unchecked="LayersChanged"/>
                            <MenuItem x:Name="EncounterLayer" Header="{l:Loc 'Encounters'}" ToolTip="{l:Loc 'Show encounter objects and explicit anchors in the generated layout.'}" IsCheckable="True" StaysOpenOnClick="True" Checked="LayersChanged" Unchecked="LayersChanged"/>
                            <Separator/>
                            <MenuItem x:Name="InternalLayer" Header="{l:Loc 'Internal markers'}" ToolTip="{l:Loc 'Include environment helpers, critters and unused exits.'}" IsCheckable="True" StaysOpenOnClick="True" Checked="LayersChanged" Unchecked="LayersChanged"/>
                            <MenuItem x:Name="AllTiles" Header="{l:Loc 'Full tile catalog'}" ToolTip="{l:Loc 'Include unused and blank tiles in the list.'}" IsCheckable="True" StaysOpenOnClick="True" Checked="LayersChanged" Unchecked="LayersChanged"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </DockPanel>
            <l:MapCanvas Grid.Row="1" x:Name="Map" ClipToBounds="True"/>
            <Border Grid.Row="1" x:Name="MarkerPanel" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Width="300" Margin="12" Padding="12" CornerRadius="4" Background="{DynamicResource Shell.Panel}" BorderBrush="{DynamicResource Shell.Border}" BorderThickness="1">
                <StackPanel>
                    <DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource Shell.IconButton}" Click="CloseMarkerClicked" ToolTip="{l:Loc 'Close'}"><md:PackIcon Kind="Close" Width="17" Height="17"/></Button><Button x:Name="CopyMarkerId" DockPanel.Dock="Right" Style="{StaticResource Shell.IconButton}" Click="CopyMarkerIdClicked" ToolTip="{l:Loc 'Copy ID'}"><md:PackIcon Kind="ContentCopy" Width="16" Height="16"/></Button><TextBox x:Name="MarkerHeading" IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="0" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel>
                    <TextBox x:Name="MarkerCoordinates" IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,4,0,0"/>
                    <TextBox x:Name="MarkerDetails" IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="0" MaxHeight="220" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    <Button x:Name="OpenDestination" HorizontalAlignment="Left" Margin="0,10,0,0" Click="OpenDestinationClicked" Visibility="Collapsed"><StackPanel Orientation="Horizontal"><md:PackIcon Kind="ArrowRight" Width="17" Height="17" Margin="0,0,6,0"/><TextBlock Text="{l:Loc 'Open connected area'}"/></StackPanel></Button>
                </StackPanel>
            </Border>
            <StackPanel Grid.Row="1" x:Name="Busy" Visibility="Collapsed" IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Center">
                <md:PackIcon Kind="Loading" Width="38" Height="38" Foreground="{DynamicResource Shell.Accent}" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <md:PackIcon.RenderTransform><RotateTransform x:Name="SpinnerRotation"/></md:PackIcon.RenderTransform>
                    <md:PackIcon.Triggers><EventTrigger RoutedEvent="FrameworkElement.Loaded"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="SpinnerRotation" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever"/></Storyboard></BeginStoryboard></EventTrigger></md:PackIcon.Triggers>
                </md:PackIcon>
                <TextBlock x:Name="BusyText" Margin="0,10,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Margin="0,8,0,0"><WrapPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,15,0"><md:PackIcon Kind="CubeOutline" Width="16" Height="16" Foreground="{DynamicResource Shell.Accent}"/><TextBlock Text="{l:Loc 'Object'}" Margin="4,0,0,0"/></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,15,0"><md:PackIcon Kind="MapMarker" Width="16" Height="16" Foreground="{DynamicResource Shell.Warning}"/><TextBlock Text="{l:Loc 'Waypoint'}" Margin="4,0,0,0"/></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,15,0"><md:PackIcon Kind="BookOpenPageVariant" Width="16" Height="16" Foreground="{DynamicResource Shell.Accent}"/><TextBlock Text="{l:Loc 'Crafting unlock'}" Margin="4,0,0,0"/></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,15,0"><Border Width="18" Height="18" CornerRadius="9" BorderThickness="1" BorderBrush="{DynamicResource Shell.Good}"><md:PackIcon Kind="Account" Width="14" Height="14" Foreground="{DynamicResource Shell.Good}"/></Border><TextBlock Text="{l:Loc 'NPC'}" Margin="4,0,0,0"/></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,15,0"><md:PackIcon Kind="Skull" Width="16" Height="16" Foreground="{DynamicResource Shell.Error}"/><TextBlock Text="{l:Loc 'Boss'}" Margin="4,0,0,0"/></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,15,0"><md:PackIcon Kind="DoorOpen" Width="16" Height="16" Foreground="{DynamicResource Shell.Warning}"/><TextBlock Text="{l:Loc 'Entrance and exit'}" Margin="4,0,0,0"/></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,15,0"><md:PackIcon Kind="SwapHorizontal" Width="16" Height="16" Foreground="{DynamicResource Shell.Warning}"/><TextBlock Text="{l:Loc 'Area teleport'}" Margin="4,0,0,0"/></StackPanel>
                <StackPanel x:Name="MonsterLegend" Visibility="Collapsed" Orientation="Horizontal" Margin="0,0,15,0"><md:PackIcon Kind="AccountGroup" Width="16" Height="16" Foreground="{DynamicResource Shell.Accent}"/><TextBlock Text="{l:Loc 'Monster pack'}" Margin="4,0,0,0"/></StackPanel>
                <StackPanel x:Name="EncounterLegend" Visibility="Collapsed" Orientation="Horizontal"><md:PackIcon Kind="DiamondOutline" Width="16" Height="16" Foreground="{DynamicResource Shell.Good}"/><TextBlock Text="{l:Loc 'Encounter'}" Margin="4,0,0,0"/></StackPanel>
            </WrapPanel><TextBlock x:Name="ContentNotice" Visibility="Collapsed" Margin="0,5,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Shell.TextSecondary}"/><TextBlock x:Name="SeedNotice" Visibility="Collapsed" Foreground="{DynamicResource Shell.Warning}" Margin="0,5,0,0" TextWrapping="Wrap"/><TextBlock x:Name="Status" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
        </Grid>
    </Grid>
</l:FormWindow>
