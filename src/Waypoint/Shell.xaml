<!-- Waypoint's look: Material Design's controls recoloured and restyled, and the Shell.* colours (the default scheme's
     light ones; Theme.cs replaces them with the chosen palette). App.xaml merges it; a tool that shows the windows on their
     own can load it alone. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
                    xmlns:l="clr-namespace:Waypoint">
    <!-- Material Design's controls, recoloured: a blue primary, the base theme switched by Theme.cs. -->
    <ResourceDictionary.MergedDictionaries>
        <md:CustomColorTheme BaseTheme="Light" PrimaryColor="#2442C8" SecondaryColor="#2442C8" />
        <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Waypoint's own colours, the default scheme's light ones; Theme.cs replaces every Shell.* brush with the chosen
         palette's. Use them through DynamicResource so a switch reaches everything. -->
    <SolidColorBrush x:Key="Shell.Sidebar" Color="#1D2F9F" />
    <SolidColorBrush x:Key="Shell.SidebarSelected" Color="#3550D4" />
    <SolidColorBrush x:Key="Shell.SidebarText" Color="#DDE3FF" />
    <SolidColorBrush x:Key="Shell.SidebarStrong" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Shell.SidebarDivider" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="Shell.SidebarHover" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="Shell.Background" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Shell.RowAlt" Color="#F6F7F9" />
    <SolidColorBrush x:Key="Shell.RowHover" Color="#EEF1FB" />
    <SolidColorBrush x:Key="Shell.Border" Color="#E4E7EC" />
    <SolidColorBrush x:Key="Shell.Text" Color="#1F2328" />
    <SolidColorBrush x:Key="Shell.TextSecondary" Color="#6B7280" />
    <SolidColorBrush x:Key="Shell.Banner" Color="#E9EDFB" />
    <SolidColorBrush x:Key="Shell.Accent" Color="#2442C8" />
    <SolidColorBrush x:Key="Shell.Primary" Color="#2442C8" />
    <SolidColorBrush x:Key="Shell.OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Shell.Panel" Color="#F6F7F9" />
    <SolidColorBrush x:Key="Shell.Good" Color="#2E9E4F" />
    <SolidColorBrush x:Key="Shell.Warning" Color="#C77700" />
    <SolidColorBrush x:Key="Shell.Error" Color="#C62828" />
    <SolidColorBrush x:Key="Shell.Idle" Color="#9AA1AD" />
    <!-- The new-release card: green, so it stands out from the blue status strip. -->
    <SolidColorBrush x:Key="Shell.UpdateBack" Color="#E3F5E8" />
    <SolidColorBrush x:Key="Shell.UpdateBorder" Color="#7CC995" />
    <SolidColorBrush x:Key="Shell.UpdateText" Color="#14532D" />
    <SolidColorBrush x:Key="Shell.UpdateAccent" Color="#1E8E3E" />

    <FontFamily x:Key="Mono">Consolas, Courier New</FontFamily>

    <!-- Keyboard focus: FocusThickness grows with Stronger keyboard focus borders (Theme.cs). -->
    <Style x:Key="Shell.Focus">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-1" RadiusX="4" RadiusY="4" SnapsToDevicePixels="True"
                               Stroke="{DynamicResource Shell.Accent}" StrokeThickness="{DynamicResource FocusStroke}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Buttons: 30 px, 4 px corners, flat, no capitals. An outlined one by default; Shell.PrimaryButton for the one
         main action of a view. -->
    <Style x:Key="Shell.Button" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="md:ButtonAssist.CornerRadius" Value="4" />
        <Setter Property="Foreground" Value="{DynamicResource Shell.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Shell.Border}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Shell.Focus}" />
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource Shell.Button}" />
    <Style x:Key="Shell.PrimaryButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatMidBgButton}">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="md:ButtonAssist.CornerRadius" Value="4" />
        <Setter Property="md:ElevationAssist.Elevation" Value="Dp0" />
        <Setter Property="Background" Value="{DynamicResource Shell.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Shell.Primary}" />
        <Setter Property="Foreground" Value="{DynamicResource Shell.OnAccent}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Shell.Focus}" />
    </Style>
    <Style x:Key="Shell.IconButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Foreground" Value="{DynamicResource Shell.TextSecondary}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Shell.Focus}" />
    </Style>

    <Style TargetType="CheckBox" BasedOn="{StaticResource MaterialDesignCheckBox}">
        <Setter Property="Margin" Value="0,0,16,6" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource Shell.Text}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Shell.Focus}" />
    </Style>

    <Style TargetType="DataGrid" BasedOn="{StaticResource MaterialDesignDataGrid}">
        <Setter Property="Background" Value="{DynamicResource Shell.Background}" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Shell.Border}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style TargetType="ListView" BasedOn="{StaticResource {x:Type ListView}}">
        <Setter Property="Background" Value="{DynamicResource Shell.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Shell.Border}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <!-- Table titles as on the Control section: small, grey, close to the column's edge, over a thin line; the column's edge
         still resizes it. -->
    <Style TargetType="GridViewColumnHeader">
        <Setter Property="Padding" Value="8,8" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Shell.TextSecondary}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewColumnHeader">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Shell.Border}" BorderThickness="0,0,0,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right" Width="8" Margin="0,0,-4,0" Cursor="SizeWE">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A titled section: a small capitalised title over a thin-bordered panel (Material's GroupBox is a coloured bar). -->
    <Style TargetType="GroupBox">
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <DockPanel>
                        <ContentPresenter DockPanel.Dock="Top" ContentSource="Header" Margin="2,0,0,6" TextElement.FontSize="11"
                                          TextElement.FontWeight="SemiBold" TextElement.Foreground="{DynamicResource Shell.TextSecondary}"
                                          Typography.Capitals="AllSmallCaps" />
                        <Border BorderBrush="{DynamicResource Shell.Border}" BorderThickness="1" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The capitalised grey column titles of the launcher's own tables. -->
    <Style x:Key="Shell.ColumnHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Shell.TextSecondary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- The launcher's own tables: a ListBox of 44 px rows, every other one shaded, the hovered one tinted; no
         selection (a row acts through its buttons). -->
    <Style x:Key="Shell.Table" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
        <Setter Property="AlternationCount" Value="2" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Row" Height="44" Padding="10,0" CornerRadius="3" Background="Transparent">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource Shell.RowAlt}" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource Shell.RowHover}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- A small rounded label in a table cell (draft, fork, current). -->
    <Style x:Key="Shell.Badge" TargetType="Border">
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="7,0,7,1" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="BorderBrush" Value="{DynamicResource Shell.Border}" />
        <Setter Property="TextElement.FontSize" Value="11" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Shell.TextSecondary}" />
    </Style>
    <Style x:Key="Shell.Cell" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="Shell.Secondary" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Shell.TextSecondary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Scrollbars: a thin rounded thumb in the theme, no arrows. -->
    <Style x:Key="Shell.ScrollThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Body" CornerRadius="3" Background="{DynamicResource Shell.Idle}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource Shell.TextSecondary}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource Shell.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Shell.ScrollPage" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2,2">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Style="{StaticResource Shell.ScrollPage}" Command="ScrollBar.PageUpCommand" />
                        </Track.DecreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Style="{StaticResource Shell.ScrollThumb}" />
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Style="{StaticResource Shell.ScrollPage}" Command="ScrollBar.PageDownCommand" />
                        </Track.IncreaseRepeatButton>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="10" />
                <Setter Property="MinHeight" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" Margin="2,2">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource Shell.ScrollPage}" Command="ScrollBar.PageLeftCommand" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource Shell.ScrollThumb}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource Shell.ScrollPage}" Command="ScrollBar.PageRightCommand" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The title bar's buttons, drawn in the theme on every window. -->
    <Style x:Key="Shell.CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource CaptionIcon}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="{DynamicResource FocusThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource HoverSurface}" />
                            <Setter Property="Foreground" Value="{DynamicResource SelectedText}" />
                        </Trigger>
                        <Trigger Property="l:SnapCaption.IsHovered" Value="True">
                            <Setter Property="Background" Value="{DynamicResource HoverSurface}" />
                            <Setter Property="Foreground" Value="{DynamicResource SelectedText}" />
                        </Trigger>
                        <Trigger Property="l:SnapCaption.IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.65" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.65" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Focus}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Shell.CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource Shell.CaptionButton}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource CloseHover}" />
                <Setter Property="Foreground" Value="{DynamicResource CloseText}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A dialog with fields (FormWindow.cs): the theme's own title bar over a thin border, with the title and a close button. -->
    <Style x:Key="Shell.FormWindow" TargetType="Window">
        <Setter Property="WindowStyle" Value="None" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Window">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Shell.Border}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid x:Name="DialogCaption" MinHeight="32" Background="{TemplateBinding Background}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="DialogTitle" Text="{TemplateBinding Title}" Foreground="{DynamicResource Shell.Text}" FontSize="{DynamicResource Font12}"
                                           Margin="16,6,12,6" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                           ToolTip="{TemplateBinding Title}" IsHitTestVisible="False" />
                                <Button x:Name="DialogCloseButton" Grid.Column="1" Content="&#xE8BB;" Style="{StaticResource Shell.CaptionCloseButton}"
                                        Height="Auto" VerticalAlignment="Stretch" WindowChrome.IsHitTestVisibleInChrome="True"
                                        Command="{x:Static SystemCommands.CloseWindowCommand}" />
                            </Grid>
                            <AdornerDecorator Grid.Row="1">
                                <ContentPresenter />
                            </AdornerDecorator>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsActive" Value="False">
                            <Setter TargetName="DialogTitle" Property="Foreground" Value="{DynamicResource Shell.TextSecondary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The settings' dialogs (FormWindow.cs): a primary button, small grey text, a labelled choice. -->
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Shell.PrimaryButton}" />
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        <Setter Property="FontSize" Value="{DynamicResource Font12}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="ChoiceRadio" TargetType="RadioButton" BasedOn="{StaticResource MaterialDesignRadioButton}">
        <Setter Property="Margin" Value="0,2,0,4" />
        <Setter Property="Foreground" Value="{DynamicResource Shell.Text}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Shell.Focus}" />
    </Style>
</ResourceDictionary>
