<UserControl x:Class="Waypoint.TimingsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Waypoint">
    <DockPanel Margin="20,12,20,12">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <TextBlock Text="{l:Loc 'Window'}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="WindowPicker" Width="90" SelectionChanged="Changed" Margin="0,0,20,0">
                <ComboBoxItem Content="{l:Loc '30 s'}" Tag="30" />
                <ComboBoxItem Content="{l:Loc '1 min'}" Tag="60" IsSelected="True" />
                <ComboBoxItem Content="{l:Loc '5 min'}" Tag="300" />
                <ComboBoxItem Content="{l:Loc '15 min'}" Tag="900" />
            </ComboBox>
            <TextBlock Text="{l:Loc 'Show'}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="KindPicker" Width="140" SelectionChanged="Changed" Margin="0,0,12,0">
                <ComboBoxItem Content="{l:Loc 'Everything'}" Tag="" IsSelected="True" />
                <ComboBoxItem Content="{l:Loc 'Client messages'}" Tag="Client messages" />
                <ComboBoxItem Content="{l:Loc 'Server phases'}" Tag="Server phases" />
                <ComboBoxItem Content="{l:Loc 'Level generation'}" Tag="Level generation" />
            </ComboBox>
            <TextBlock x:Name="State" VerticalAlignment="Center" Foreground="{DynamicResource Shell.TextSecondary}" />
        </WrapPanel>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="1.3*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- The five operations with the most server time in the window, the same colour on both charts. -->
            <l:LineChart x:Name="SlowChart" Title="{l:Loc 'p95 per second, busiest operations'}" Unit="{l:Loc 'ms'}" Format="0.##" Margin="4" />
            <l:LineChart x:Name="LoadChart" Grid.Column="1" Title="{l:Loc 'Server time'}" Unit="{l:Loc 'ms per second'}" Format="0.#" Margin="4" />
            <ListView x:Name="Table" Grid.Row="1" Grid.ColumnSpan="2" Margin="4">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="{l:Loc 'Operation'}" Width="200" DisplayMemberBinding="{Binding Label}" />
                        <GridViewColumn Header="{l:Loc 'Kind'}" Width="120" DisplayMemberBinding="{Binding KindText}" />
                        <GridViewColumn Width="80" DisplayMemberBinding="{Binding PerSecond, StringFormat=0.##}">
                            <GridViewColumnHeader Content="{l:Loc 'Calls/s'}" ToolTip="{l:Loc 'Calls per second over the window'}" />
                        </GridViewColumn>
                        <GridViewColumn Width="80" DisplayMemberBinding="{Binding Average, StringFormat=0.###}">
                            <GridViewColumnHeader Content="{l:Loc 'Avg ms'}" ToolTip="{l:Loc 'Total time divided by the calls in the window'}" />
                        </GridViewColumn>
                        <GridViewColumn Width="80" DisplayMemberBinding="{Binding P95, StringFormat=0.###}">
                            <GridViewColumnHeader Content="{l:Loc 'p95 ms'}" ToolTip="{l:Loc 'The worst second\'s 95th percentile in the window (the server publishes quantiles per second)'}" />
                        </GridViewColumn>
                        <GridViewColumn Width="80" DisplayMemberBinding="{Binding P99, StringFormat=0.###}">
                            <GridViewColumnHeader Content="{l:Loc 'p99 ms'}" ToolTip="{l:Loc 'The worst second\'s 99th percentile in the window'}" />
                        </GridViewColumn>
                        <GridViewColumn Width="90" DisplayMemberBinding="{Binding MsPerSecond, StringFormat=0.##}">
                            <GridViewColumnHeader Content="{l:Loc 'ms/s'}" ToolTip="{l:Loc 'Server time per second, all connections together; waits (queues, gates, locks) count their waiting time'}" />
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>
    </DockPanel>
</UserControl>
