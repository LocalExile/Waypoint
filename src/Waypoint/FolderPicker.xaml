<UserControl x:Class="Waypoint.FolderPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:l="clr-namespace:Waypoint">
    <UserControl.Resources>
        <!-- The folder in use, in the sidebar: the whole box is the button that opens the list. -->
        <Style x:Key="CurrentFolder" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource Shell.SidebarText}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Body" CornerRadius="6" Padding="10,7,8,8" Background="Transparent" BorderThickness="1"
                                BorderBrush="{DynamicResource Shell.SidebarDivider}" SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Background" Value="{DynamicResource Shell.SidebarHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Body" Property="Background" Value="{DynamicResource Shell.SidebarHover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource Shell.SidebarStrong}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A row of the list, or an action under it: the whole row is the button. -->
        <Style x:Key="FolderRow" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Shell.Text}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <!-- The focus frame of every button here: it shows when the keyboard is in use, not after a click. -->
            <Setter Property="FocusVisualStyle" Value="{StaticResource Shell.Focus}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body" CornerRadius="6" Padding="10,8" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Background" Value="{DynamicResource Shell.RowHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A folder's row: the one in use is shaded, as well as labelled. -->
        <Style x:Key="KnownFolderRow" TargetType="Button" BasedOn="{StaticResource FolderRow}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding InUse}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Shell.RowAlt}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- "Take it off the list", at the end of a row: it shows while the mouse is on the row or the keyboard is on it,
             and keeps its place meanwhile, so that no row changes width. -->
        <Style x:Key="ForgetButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Shell.TextSecondary}" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Shell.Focus}" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="6,0,-4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body" CornerRadius="4" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Background" Value="{DynamicResource Shell.Border}" />
                                <Setter Property="Foreground" Value="{DynamicResource Shell.Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Opacity" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Opacity" Value="1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <ToggleButton x:Name="Current" Style="{StaticResource CurrentFolder}" Checked="OpenList">
            <DockPanel>
                <md:PackIcon DockPanel.Dock="Right" Kind="ChevronDown" Width="16" Height="16" Margin="4,0,0,0" VerticalAlignment="Center" Opacity="0.75" />
                <md:PackIcon x:Name="CurrentIcon" DockPanel.Dock="Left" Kind="PackageVariantClosed" Width="17" Height="17" Margin="0,0,10,0" VerticalAlignment="Center" />
                <StackPanel>
                    <TextBlock x:Name="CurrentTitle" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Shell.SidebarStrong}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="CurrentPath" FontSize="11" Opacity="0.72" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                    <!-- The version of the folder's game client, once it is read; with a warning sign when the folder's
                         LocalExile does not run that version. -->
                    <DockPanel x:Name="CurrentClientLine" Margin="0,1,0,0" Visibility="Collapsed">
                        <md:PackIcon x:Name="CurrentClientAlert" DockPanel.Dock="Left" Kind="AlertOutline" Width="12" Height="12" Margin="0,0,4,0"
                                     VerticalAlignment="Center" Foreground="{DynamicResource Shell.Warning}" Visibility="Collapsed" />
                        <TextBlock x:Name="CurrentClient" FontSize="11" Opacity="0.72" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </StackPanel>
            </DockPanel>
        </ToggleButton>
        <!-- The list: a card over the window, as the update cards are. It closes on a click anywhere else and on Escape. -->
        <Popup x:Name="List" PlacementTarget="{Binding ElementName=Current}" Placement="Bottom" VerticalOffset="4"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Opened="ListOpened" Closed="ListClosed">
            <Border x:Name="Card" Margin="8,0,18,20" MinWidth="330" MaxWidth="460" Padding="6" CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource Shell.Background}" BorderBrush="{DynamicResource Shell.Border}"
                    TextElement.Foreground="{DynamicResource Shell.Text}" TextElement.FontFamily="{DynamicResource AppFont}" TextElement.FontSize="12.5"
                    KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle" PreviewKeyDown="ListKey">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.3" />
                </Border.Effect>
                <StackPanel>
                    <ItemsControl x:Name="Rows" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource KnownFolderRow}" Click="RowClicked" ToolTip="{Binding Tip}" Opacity="{Binding Strength}" Margin="0,1"
                                        AutomationProperties.Name="{Binding Spoken}">
                                    <DockPanel>
                                        <md:PackIcon DockPanel.Dock="Left" Kind="{Binding Icon}" Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center"
                                                     Foreground="{DynamicResource Shell.TextSecondary}" />
                                        <Button DockPanel.Dock="Right" Style="{StaticResource ForgetButton}" Click="ForgetClicked" Visibility="{Binding ForgetShown}"
                                                ToolTip="{l:Loc 'Take this folder off the list. The folder and its files stay where they are.'}"
                                                AutomationProperties.Name="{l:Loc 'Take it off the list'}">
                                            <md:PackIcon Kind="Close" Width="14" Height="14" />
                                        </Button>
                                        <Border DockPanel.Dock="Right" Style="{StaticResource Shell.Badge}" Visibility="{Binding InUseShown}"
                                                BorderBrush="{DynamicResource Shell.Accent}">
                                            <TextBlock Text="{l:Loc 'In use'}" Foreground="{DynamicResource Shell.Accent}" />
                                        </Border>
                                        <Border DockPanel.Dock="Right" Style="{StaticResource Shell.Badge}" Visibility="{Binding MissingShown}"
                                                BorderBrush="{DynamicResource Shell.Warning}">
                                            <TextBlock Text="{l:Loc 'Not found'}" Foreground="{DynamicResource Shell.Warning}" />
                                        </Border>
                                        <StackPanel>
                                            <TextBlock FontSize="13" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Client, Mode=OneWay}" Foreground="{Binding ClientBrush, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding ShortPath}" FontSize="11.5" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource Shell.TextSecondary}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Height="1" Margin="6,6,6,6" Background="{DynamicResource Shell.Border}" />
                    <!-- The clients of the folder in use (ClientVersionsWindow): here in every mode, for a release and a source copy. -->
                    <Button Style="{StaticResource FolderRow}" Click="GameClientClicked"
                            ToolTip="{l:Loc 'The game clients of this LocalExile folder: which version it uses, and the way to another'}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="GamepadVariantOutline" Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center"
                                         Foreground="{DynamicResource Shell.TextSecondary}" />
                            <TextBlock Text="{l:Loc 'Game client…'}" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FolderRow}" Click="AddClicked"
                            ToolTip="{l:Loc 'Choose a LocalExile folder that is already on this PC: a release, or a copy of its source. Waypoint opens it and keeps it in this list.'}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="FolderPlusOutline" Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center"
                                         Foreground="{DynamicResource Shell.TextSecondary}" />
                            <TextBlock Text="{l:Loc 'Add a folder you already have…'}" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NewCopy" Style="{StaticResource FolderRow}" Click="NewCopyClicked">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Download" Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center"
                                         Foreground="{DynamicResource Shell.TextSecondary}" />
                            <TextBlock Text="{l:Loc 'Set up a new copy…'}" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
