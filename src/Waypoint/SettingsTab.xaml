<UserControl x:Class="Waypoint.SettingsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Waypoint">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,14,20,14" MaxWidth="820" HorizontalAlignment="Left">
            <GroupBox Header="{l:Loc 'Appearance'}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{l:Loc 'Change appearance…'}" Click="ChangeAppearance" Margin="12,0,0,0" />
                    <StackPanel>
                        <TextBlock x:Name="AppearanceSummary" FontWeight="SemiBold" />
                        <TextBlock Text="{l:Loc 'Color schemes, custom colors, reading fonts, text size and accessibility preferences.'}"
                                   Style="{StaticResource Shell.Secondary}" TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>
            </GroupBox>

            <GroupBox Header="{l:Loc 'Language'}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <RadioButton x:Name="English" Content="English" GroupName="Language" Style="{StaticResource ChoiceRadio}" Margin="0,0,20,0" Checked="LanguageChanged" />
                        <RadioButton x:Name="Russian" Content="Русский" GroupName="Language" Style="{StaticResource ChoiceRadio}" Checked="LanguageChanged" />
                    </StackPanel>
                    <TextBlock Text="{l:Loc 'This changes Waypoint\'s interface. Repository names, paths, commit hashes, in-game commands and raw logs keep their original text.'}"
                               Style="{StaticResource Shell.Secondary}" TextWrapping="Wrap" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="{l:Loc 'Window behavior'}">
                <StackPanel>
                    <l:WindowBehaviorChoices x:Name="WindowChoices" ChoiceChanged="WindowChoicesChanged" />
                    <Border Height="1" Background="{DynamicResource Shell.Border}" Margin="0,4,0,10" />
                    <CheckBox x:Name="AlwaysAsk" Content="{l:Loc 'Always ask when I close the window'}" Checked="AlwaysAskChanged" Unchecked="AlwaysAskChanged" />
                    <CheckBox x:Name="TrayWhileGame" Content="{l:Loc 'Tray while the game runs'}" Checked="TrayChanged" Unchecked="TrayChanged"
                              ToolTip="{l:Loc 'Hide Waypoint in the tray when the game starts, and bring it back when the game closes'}" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="{l:Loc 'Updates'}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{l:Loc 'Check for updates'}" Click="CheckUpdates" Margin="12,0,0,0"
                            ToolTip="{l:Loc 'Look for a newer Waypoint release on GitHub'}" />
                    <StackPanel>
                        <CheckBox x:Name="CheckAtStart" Content="{l:Loc 'Look for updates at start'}" Checked="CheckAtStartChanged" Unchecked="CheckAtStartChanged"
                                  ToolTip="{l:Loc 'Look for a newer Waypoint release whenever it starts (release builds)'}" />
                        <CheckBox x:Name="KeepUpToDate" Content="{l:Loc 'Keep LocalExile up to date'}" Checked="KeepUpToDateChanged" Unchecked="KeepUpToDateChanged"
                                  ToolTip="{l:Loc 'Play gets the newest LocalExile at most once a day, after backing up your saves. A copy with your own changes is left alone.'}" />
                    </StackPanel>
                </DockPanel>
            </GroupBox>

            <GroupBox x:Name="CheckoutGroup" Header="{l:Loc 'Server checkout'}">
                <StackPanel>
                    <TextBlock x:Name="ServerFolder" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,0,6" />
                    <CheckBox x:Name="UseProfile" Content="{l:Loc 'Use the checkout\'s local launch profile when it has one'}" Checked="ProfileChanged" Unchecked="ProfileChanged"
                              ToolTip="scripts/dev/live.local.ps1, config/runtime.local.ps1" />
                    <WrapPanel Margin="0,4,0,-6">
                        <Button Content="{l:Loc 'Find automatically…'}" Click="FindCheckout" />
                        <Button Content="{l:Loc 'Change…'}" Click="ChangeCheckout"
                                ToolTip="{l:Loc 'Pick another LocalExile server checkout; Waypoint starts again on it'}" />
                        <Button Content="{l:Loc 'Open Waypoint\'s data folder'}" Click="OpenData"
                                ToolTip="{l:Loc 'Operation logs and save backups'}" />
                    </WrapPanel>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
