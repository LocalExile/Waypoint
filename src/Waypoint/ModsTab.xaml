<UserControl x:Class="Waypoint.ModsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:l="clr-namespace:Waypoint">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="ModLink" TargetType="Button" BasedOn="{StaticResource Shell.Button}">
            <Setter Property="Height" Value="Auto" /><Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,14,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Focus" BorderThickness="1" BorderBrush="Transparent" CornerRadius="4" Padding="2">
                    <ContentPresenter />
                </Border>
                <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="BorderBrush" Value="{DynamicResource Shell.Accent}" /></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ModTable" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
            <Setter Property="BorderThickness" Value="0" /><Setter Property="Background" Value="Transparent" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ListBoxItem">
                <Setter Property="Focusable" Value="False" /><Setter Property="Cursor" Value="Hand" />
                <Setter Property="Margin" Value="0,0,0,7" />
                <EventSetter Event="MouseLeftButtonUp" Handler="RowClicked" /><EventSetter Event="ContextMenuOpening" Handler="RowMenuOpening" />
                <Setter Property="ContextMenu"><Setter.Value><ContextMenu /></Setter.Value></Setter>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Row" MinHeight="78" Padding="12,10" CornerRadius="8" Background="{DynamicResource Shell.Panel}" BorderBrush="{DynamicResource Shell.Border}" BorderThickness="1">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Shell.Accent}" /></Trigger></ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style></Setter.Value></Setter>
        </Style>
        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="Width" Value="38" /><Setter Property="Height" Value="40" /><Setter Property="CornerRadius" Value="7" />
            <Setter Property="Margin" Value="0,0,12,0" /><Setter Property="Background" Value="{DynamicResource Shell.Background}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Shell.Border}" /><Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource Shell.Button}">
            <Setter Property="Width" Value="104" /><Setter Property="Margin" Value="0" />
        </Style>
        <Style x:Key="ModDescription" TargetType="TextBlock" BasedOn="{StaticResource Shell.Cell}">
            <Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="{DynamicResource Shell.TextSecondary}" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Style.Triggers><DataTrigger Binding="{Binding HasDescription}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
        </Style>
        <DataTemplate x:Key="ModIdentity">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Left" Style="{StaticResource Tile}"><md:PackIcon Kind="{Binding Icon}" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Shell.TextSecondary}" /></Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Shell.Cell}" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Description}" Style="{StaticResource ModDescription}" ToolTip="{Binding Description}" />
                    <TextBlock Text="{Binding Metadata}" Style="{StaticResource Shell.Secondary}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                </StackPanel>
            </DockPanel>
        </DataTemplate>
        <DataTemplate x:Key="JobBox">
            <Border Width="104" Height="30" HorizontalAlignment="Right" CornerRadius="4" ClipToBounds="True" Background="{DynamicResource Shell.Background}">
                <Grid>
                    <ProgressBar Value="{Binding Percent, Mode=OneWay}" IsIndeterminate="{Binding Indeterminate, Mode=OneWay}" Minimum="0" Maximum="100" Height="Auto" VerticalAlignment="Stretch" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Shell.Accent}" Opacity="0.25" />
                    <TextBlock Text="{Binding Text}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" Margin="4,0" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Margin="18,8,18,12">
        <l:OutputPanel x:Name="OutputView" DockPanel.Dock="Bottom" Height="150" Margin="0,8,0,0" Visibility="Collapsed" />
        <TextBlock DockPanel.Dock="Bottom" Text="{l:Loc 'Saved enable choices are separate from live load status. League module choices are managed in Leagues.'}" Style="{StaticResource Shell.Secondary}" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0" />
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <Button x:Name="OpenModsButton" DockPanel.Dock="Right" Click="OpenMods" Style="{StaticResource Shell.Button}" VerticalAlignment="Top" AutomationProperties.Name="{l:Loc 'Open mods folder'}">
                <StackPanel Orientation="Horizontal"><md:PackIcon Kind="FolderOpenOutline" Width="17" Height="17" Margin="0,0,7,0" /><TextBlock Text="{l:Loc 'Open folder'}" /></StackPanel>
            </Button>
            <StackPanel><TextBlock Text="{l:Loc 'Mods'}" FontSize="26" FontWeight="SemiBold" /><TextBlock Text="{l:Loc 'Install, update and configure your modifications.'}" Style="{StaticResource Shell.Secondary}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel>
        </DockPanel>
        <TabControl x:Name="Pages" DockPanel.Dock="Top" SelectionChanged="PageChanged" Width="280" HorizontalAlignment="Left" Margin="0,0,0,12">
            <TabItem x:Name="InstalledPage" Header="{l:Loc 'My Mods'}" /><TabItem x:Name="BrowsePage" Header="{l:Loc 'Browse'}" />
        </TabControl>
        <Grid>
            <DockPanel x:Name="InstalledView">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBox x:Name="Search" Width="220" Margin="0,0,8,0" VerticalAlignment="Center" md:HintAssist.Hint="{l:Loc 'Search mods'}" AutomationProperties.Name="{l:Loc 'Search mods'}" md:TextFieldAssist.HasLeadingIcon="True" md:TextFieldAssist.LeadingIcon="Magnify" TextChanged="SearchChanged" />
                        <Button Style="{StaticResource Shell.IconButton}" Click="RefreshInstalled" ToolTip="{l:Loc 'Refresh'}" AutomationProperties.Name="{l:Loc 'Refresh'}"><md:PackIcon Kind="Refresh" Width="18" Height="18" /></Button>
                        <Button x:Name="MoreButton" Style="{StaticResource Shell.Button}" Click="OpenMenu" AutomationProperties.Name="{l:Loc 'More mod tools'}">
                            <StackPanel Orientation="Horizontal"><md:PackIcon Kind="DotsVertical" Width="17" Height="17" Margin="0,0,5,0" /><TextBlock Text="{l:Loc 'More'}" /></StackPanel>
                            <Button.ContextMenu><ContextMenu>
                                <MenuItem x:Name="InstallFolderItem" Header="{l:Loc 'Install from folder…'}" Click="InstallFolder" />
                                <MenuItem x:Name="BuildAllItem" Header="{l:Loc 'Build all mods'}" Click="BuildAll" />
                                <MenuItem x:Name="CheckModsItem" Header="{l:Loc 'Check live status'}" Click="CheckMods" />
                                <MenuItem Header="{l:Loc 'Gateway log'}" Click="GatewayLog" /><MenuItem x:Name="ShowLogItem" Header="{l:Loc 'Show operation log'}" IsCheckable="True" Click="ShowLogChanged" />
                                <Separator /><MenuItem x:Name="AutoBackupItem" Header="{l:Loc 'Automatic backup before mod changes'}" IsCheckable="True" Click="BackupChanged" />
                            </ContextMenu></Button.ContextMenu>
                        </Button>
                    </StackPanel>
                    <Button x:Name="UpdateAllButton" Style="{StaticResource Shell.PrimaryButton}" HorizontalAlignment="Left" Margin="0" Click="UpdateAll">
                        <StackPanel Orientation="Horizontal"><md:PackIcon Kind="Update" Width="16" Height="16" Margin="0,0,6,0" /><TextBlock Text="{l:Loc 'Update all'}" />
                            <Border x:Name="UpdateCountBadge" Margin="7,0,0,0"><TextBlock x:Name="UpdateCount" FontSize="12" Foreground="{DynamicResource Shell.OnAccent}" /></Border>
                        </StackPanel>
                    </Button>
                </DockPanel>
                <TextBlock x:Name="Notice" DockPanel.Dock="Top" Style="{StaticResource Shell.Secondary}" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed" />
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock Text="{l:Loc 'Sort by'}" Style="{StaticResource Shell.Secondary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox x:Name="SortPicker" Width="160" SelectionChanged="SortChoiceChanged" AutomationProperties.Name="{l:Loc 'Sort mods by'}" />
                        <Button x:Name="SortDirection" Click="ReverseSort" Style="{StaticResource Shell.IconButton}" ToolTip="{l:Loc 'Reverse sort order'}" AutomationProperties.Name="{l:Loc 'Reverse sort order'}" />
                    </StackPanel>
                    <TextBlock x:Name="InstalledCount" Style="{StaticResource Shell.Secondary}" FontSize="12" VerticalAlignment="Center" />
                </DockPanel>
                <Grid DockPanel.Dock="Top" Margin="13,0,13,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="156" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{l:Loc 'Use'}" Style="{StaticResource Shell.ColumnHeader}" /><TextBlock Grid.Column="1" Text="{l:Loc 'Mod'}" Style="{StaticResource Shell.ColumnHeader}" />
                    <TextBlock Grid.Column="2" Text="{l:Loc 'Package status'}" Style="{StaticResource Shell.ColumnHeader}" /><TextBlock Grid.Column="3" Text="{l:Loc 'Action'}" Style="{StaticResource Shell.ColumnHeader}" />
                </Grid>
                <Grid>
                    <ListBox x:Name="ModList" Style="{StaticResource ModTable}" AutomationProperties.Name="{l:Loc 'Installed mods'}"><ListBox.ItemTemplate><DataTemplate>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="156" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}" IsEnabled="{Binding CanToggle}" Click="ToggleFromList" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="0" ToolTip="{Binding EnabledTip}" AutomationProperties.Name="{Binding EnabledTip}" />
                            <StackPanel Grid.Column="1">
                                <Button Style="{StaticResource ModLink}" Click="OpenRowDetails" Content="{Binding}" ContentTemplate="{StaticResource ModIdentity}" AutomationProperties.Name="{Binding Title}" />
                                <TextBlock Text="{Binding Problem}" Visibility="{Binding HasProblem, Converter={StaticResource BooleanToVisibilityConverter}}" Foreground="{DynamicResource Shell.Error}" FontSize="12" TextWrapping="Wrap" Margin="52,5,12,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{Binding PackageStatus}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Shell.TextSecondary}" />
                                <TextBlock Text="{Binding VersionChange}" FontSize="11" Foreground="{DynamicResource Shell.TextSecondary}" Margin="0,3,0,0" Visibility="{Binding HasUpdate, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                            <Button Grid.Column="3" Style="{StaticResource RowButton}" Content="{Binding ActionText}" Click="RowAction" IsEnabled="{Binding CanAct}" Visibility="{Binding HasButton, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="{Binding ActionTip}" ToolTipService.ShowOnDisabled="True" />
                            <Button Grid.Column="3" Style="{StaticResource RowButton}" Content="{l:Loc 'Details'}" Click="OpenRowDetails" Visibility="{Binding ShowDetails, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ContentControl Grid.Column="3" Content="{Binding Job}" ContentTemplate="{StaticResource JobBox}" VerticalAlignment="Center" Visibility="{Binding HasJob, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </DataTemplate></ListBox.ItemTemplate></ListBox>
                    <TextBlock x:Name="Empty" Style="{StaticResource Shell.Secondary}" IsHitTestVisible="False" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="340" Margin="16" />
                </Grid>
            </DockPanel>

            <DockPanel x:Name="BrowseView" Visibility="Collapsed">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBox x:Name="BrowseSearch" Width="220" Margin="0,0,8,0" VerticalAlignment="Center" md:HintAssist.Hint="{l:Loc 'Search mods'}" AutomationProperties.Name="{l:Loc 'Search mods'}" md:TextFieldAssist.HasLeadingIcon="True" md:TextFieldAssist.LeadingIcon="Magnify" TextChanged="BrowseSearchChanged" />
                        <Button x:Name="RefreshButton" Style="{StaticResource Shell.IconButton}" Click="RefreshBrowse" ToolTip="{l:Loc 'Refresh'}" AutomationProperties.Name="{l:Loc 'Refresh'}"><md:PackIcon Kind="Refresh" Width="18" Height="18" /></Button>
                        <Button Style="{StaticResource Shell.IconButton}" Click="OpenMenu" ToolTip="{l:Loc 'More'}" AutomationProperties.Name="{l:Loc 'Repository tools'}"><md:PackIcon Kind="DotsVertical" Width="18" Height="18" />
                            <Button.ContextMenu><ContextMenu><MenuItem Header="{l:Loc 'Add repository…'}" Click="ShowAddRepository" /><MenuItem Header="{l:Loc 'Open on GitHub'}" Click="OpenRepository" /><MenuItem x:Name="RemoveRepositoryItem" Header="{l:Loc 'Remove repository'}" Click="RemoveRepository" /></ContextMenu></Button.ContextMenu>
                        </Button>
                    </StackPanel>
                    <ComboBox x:Name="SourcePicker" MinWidth="230" MaxWidth="300" HorizontalAlignment="Left" VerticalAlignment="Center" SelectionChanged="SourceChanged" AutomationProperties.Name="{l:Loc 'Mod repository'}" />
                </DockPanel>
                <TextBlock x:Name="BrowseCount" DockPanel.Dock="Top" Style="{StaticResource Shell.Secondary}" FontSize="12" Margin="0,0,0,10" />
                <DockPanel x:Name="AddRepositoryRow" DockPanel.Dock="Top" Margin="0,0,0,10" Visibility="Collapsed">
                    <Button DockPanel.Dock="Right" Content="{l:Loc 'Cancel'}" Margin="6,0,0,0" Click="HideAddRepository" /><Button DockPanel.Dock="Right" Content="{l:Loc 'Add'}" Style="{StaticResource Shell.PrimaryButton}" Margin="6,0,0,0" Click="AddRepository" />
                    <TextBox x:Name="RepositoryUrl" md:HintAssist.Hint="{l:Loc 'Another mod repository: github.com/owner/name'}" KeyDown="RepositoryUrlKey" />
                </DockPanel>
                <TextBlock x:Name="BrowseStatus" DockPanel.Dock="Top" Style="{StaticResource Shell.Secondary}" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed" />
                <Grid DockPanel.Dock="Top" Margin="13,0,13,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="156" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{l:Loc 'Mod'}" Style="{StaticResource Shell.ColumnHeader}" /><TextBlock Grid.Column="1" Text="{l:Loc 'Package'}" Style="{StaticResource Shell.ColumnHeader}" /><TextBlock Grid.Column="2" Text="{l:Loc 'Action'}" Style="{StaticResource Shell.ColumnHeader}" />
                </Grid>
                <Grid>
                    <ListBox x:Name="BrowseList" Style="{StaticResource ModTable}" AutomationProperties.Name="{l:Loc 'Available mods'}"><ListBox.ItemTemplate><DataTemplate>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="156" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                            <Button Style="{StaticResource ModLink}" Click="OpenRowDetails" Content="{Binding}" ContentTemplate="{StaticResource ModIdentity}" AutomationProperties.Name="{Binding Title}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock Text="{Binding PackageStatus}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Shell.TextSecondary}" /><TextBlock Text="{Binding VersionText}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Shell.TextSecondary}" Margin="0,3,0,0" /></StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource RowButton}" Content="{Binding ActionText}" IsEnabled="{Binding CanAct}" Click="InstallFromBrowse" Visibility="{Binding ShowOfferAction, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Grid.Column="2" Style="{StaticResource RowButton}" Content="{l:Loc 'Details'}" Click="OpenRowDetails" Visibility="{Binding ShowDetails, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ContentControl Grid.Column="2" Content="{Binding Job}" ContentTemplate="{StaticResource JobBox}" VerticalAlignment="Center" Visibility="{Binding HasJob, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </DataTemplate></ListBox.ItemTemplate></ListBox>
                    <TextBlock x:Name="BrowseEmpty" Style="{StaticResource Shell.Secondary}" IsHitTestVisible="False" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="340" Margin="16" />
                </Grid>
            </DockPanel>

            <DockPanel x:Name="ModPage" Visibility="Collapsed">
                <StackPanel DockPanel.Dock="Top">
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Click="RefreshInstalled" Style="{StaticResource Shell.IconButton}" HorizontalAlignment="Right" ToolTip="{l:Loc 'Refresh mod details'}" AutomationProperties.Name="{l:Loc 'Refresh mod details'}"><md:PackIcon Kind="Refresh" Width="18" Height="18" /></Button>
                        <Button x:Name="BackButton" Click="ClosePage" Style="{StaticResource Shell.Button}" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal"><md:PackIcon Kind="ArrowLeft" Width="17" Height="17" Margin="0,0,7,0" /><TextBlock x:Name="BackText" /></StackPanel></Button>
                    </DockPanel>
                    <Border Background="{DynamicResource Shell.Panel}" BorderBrush="{DynamicResource Shell.Border}" BorderThickness="1" CornerRadius="9" Padding="18" Margin="0,0,0,12">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Style="{StaticResource Tile}" Width="64" Height="66" VerticalAlignment="Top" Margin="0,0,18,0"><md:PackIcon x:Name="PageIcon" Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Shell.TextSecondary}" /></Border>
                            <StackPanel>
                                <TextBlock x:Name="PageTitle" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock x:Name="PageByline" Style="{StaticResource Shell.Secondary}" FontSize="12" Margin="0,4,0,0" />
                                <TextBlock x:Name="PageDescription" TextWrapping="Wrap" Foreground="{DynamicResource Shell.TextSecondary}" Margin="0,9,0,0" />
                                <WrapPanel Margin="0,12,0,0">
                                    <CheckBox x:Name="PageEnabled" Content="{l:Loc 'Enabled for this checkout'}" VerticalAlignment="Center" Margin="0,0,14,0" Click="TogglePage" />
                                    <TextBlock x:Name="PagePackageStatus" Style="{StaticResource Shell.Secondary}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <Button x:Name="PageAction" Style="{StaticResource Shell.PrimaryButton}" MinWidth="100" Margin="0,0,8,0" Click="PageActionClicked" />
                                    <Button x:Name="PageMenuButton" Style="{StaticResource Shell.IconButton}" Click="OpenPageMenu" ToolTip="{l:Loc 'More'}" AutomationProperties.Name="{l:Loc 'More mod actions'}"><md:PackIcon Kind="DotsVertical" Width="18" Height="18" /></Button>
                                </WrapPanel>
                                <TextBlock x:Name="PageStats" Style="{StaticResource Shell.Secondary}" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,8" />
                                <ItemsControl x:Name="PageTags"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Shell.Badge}" Margin="0,0,6,0"><TextBlock Text="{Binding}" FontSize="11" /></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
                <TabControl x:Name="PageTabs">
                    <TabItem x:Name="ModOverviewPage" Header="{l:Loc 'Overview'}"><DockPanel>
                        <Border x:Name="RuntimeCard" DockPanel.Dock="Top" Background="{DynamicResource Shell.Panel}" BorderBrush="{DynamicResource Shell.Border}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,12,0,10">
                            <DockPanel><Button x:Name="PageCheckStatus" DockPanel.Dock="Right" Content="{l:Loc 'Check live status'}" Click="CheckMods" Style="{StaticResource Shell.Button}" VerticalAlignment="Top" Margin="14,0,0,0" />
                                <StackPanel><TextBlock Text="{l:Loc 'Saved choice and live status'}" FontSize="14" FontWeight="SemiBold" /><TextBlock x:Name="SavedChoiceText" Margin="0,8,0,0" TextWrapping="Wrap" /><TextBlock x:Name="RuntimeStatusText" Margin="0,4,0,0" TextWrapping="Wrap" /><TextBlock Text="{l:Loc 'A saved checkmark does not confirm that the mod is loaded in the running game.'}" Style="{StaticResource Shell.Secondary}" FontSize="12" TextWrapping="Wrap" Margin="0,7,0,0" /></StackPanel>
                            </DockPanel>
                        </Border>
                        <FlowDocumentScrollViewer x:Name="Overview" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsToolBarVisible="False" />
                    </DockPanel></TabItem>
                    <TabItem x:Name="ModSettingsPage" Header="{l:Loc 'Settings'}"><DockPanel Margin="0,12,0,0">
                        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Shell.Border}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,10,0,0">
                            <StackPanel><TextBlock x:Name="SettingsHint" Style="{StaticResource Shell.Secondary}" FontSize="12" TextWrapping="Wrap" />
                                <WrapPanel x:Name="SettingsActions" Margin="0,8,0,0"><Button x:Name="SaveSettingsButton" Style="{StaticResource Shell.PrimaryButton}" Content="{l:Loc 'Save settings'}" Click="SaveSettings" /><Button x:Name="DiscardSettingsButton" Content="{l:Loc 'Discard changes'}" Click="DiscardModSettings" /><Button x:Name="ResetSettingsButton" Content="{l:Loc 'Reset to defaults'}" Click="ResetSettings" /></WrapPanel>
                            </StackPanel>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel MaxWidth="680" HorizontalAlignment="Left" Margin="16,12,16,0">
                            <TextBlock Text="{l:Loc 'Mod settings'}" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="{l:Loc 'Shared by every league where this mod runs.'}" Style="{StaticResource Shell.Secondary}" FontSize="12" Margin="0,6,0,16" TextWrapping="Wrap" /><StackPanel x:Name="SettingsPanel" />
                        </StackPanel></ScrollViewer>
                    </DockPanel></TabItem>
                    <TabItem x:Name="ModVersionsPage" Header="{l:Loc 'Versions'}"><ListBox x:Name="VersionList" Style="{StaticResource ModTable}" Margin="0,12,0,0"><ListBox.ItemTemplate><DataTemplate>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="100" /><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Version}" Style="{StaticResource Shell.Cell}" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{Binding Date}" Style="{StaticResource Shell.Cell}" /><TextBlock Grid.Column="2" Text="{Binding Size}" Style="{StaticResource Shell.Cell}" /><TextBlock Grid.Column="3" Text="{Binding Notes}" Style="{StaticResource Shell.Cell}" Foreground="{DynamicResource Shell.TextSecondary}" ToolTip="{Binding Notes}" Margin="0,0,12,0" /><Button Grid.Column="4" Style="{StaticResource RowButton}" Content="{Binding ActionText}" IsEnabled="{Binding CanAct}" Click="InstallVersion" />
                        </Grid>
                    </DataTemplate></ListBox.ItemTemplate></ListBox></TabItem>
                </TabControl>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
