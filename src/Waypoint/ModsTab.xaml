<UserControl x:Class="Waypoint.ModsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:l="clr-namespace:Waypoint">
    <DockPanel>
        <Border x:Name="Toolbar" DockPanel.Dock="Top" Padding="20,10,14,4" BorderBrush="{DynamicResource Shell.Border}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="OpenModsButton" Content="{l:Loc 'Open mods folder'}" Click="OpenMods" IsEnabled="False" />
                    <Button x:Name="CheckModsButton" Content="{l:Loc 'Check live status'}" Click="CheckMods" IsEnabled="False"
                            ToolTipService.ShowOnDisabled="True" />
                    <Button x:Name="BuildAllButton" Style="{StaticResource Shell.PrimaryButton}" Content="{l:Loc 'Build all mods'}" Click="BuildAll" IsEnabled="False"
                            Margin="0,0,0,6" />
                </StackPanel>
                <TextBlock x:Name="Status" Style="{StaticResource Shell.Secondary}" Margin="0,0,12,6" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <l:OutputPanel x:Name="OutputView" DockPanel.Dock="Bottom" Height="170" Margin="20,8,20,12" />

        <Grid Margin="20,10,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <DockPanel>
                <TextBox x:Name="Search" DockPanel.Dock="Top" Margin="0,0,0,6" md:HintAssist.Hint="{l:Loc 'Search'}"
                         md:TextFieldAssist.HasLeadingIcon="True" md:TextFieldAssist.LeadingIcon="Magnify" TextChanged="SearchChanged" />
                <Grid>
                    <ListBox x:Name="ModList" SelectionChanged="SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,2">
                                    <TextBlock Text="{Binding Id}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Shell.Secondary}" FontSize="11.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="Empty" Style="{StaticResource Shell.Secondary}" IsHitTestVisible="False" TextWrapping="Wrap" TextAlignment="Center"
                               VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="240" Margin="16" />
                </Grid>
            </DockPanel>
            <GroupBox Grid.Column="2" Margin="0">
                <GroupBox.Header>
                    <TextBlock x:Name="Selected" Text="{l:Loc 'Mod details'}" />
                </GroupBox.Header>
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top">
                        <Button x:Name="ToggleButton" Style="{StaticResource Shell.PrimaryButton}" Content="{l:Loc 'Enable mod'}" Click="Toggle" IsEnabled="False"
                                ToolTipService.ShowOnDisabled="True" />
                        <Button x:Name="BuildButton" Content="{l:Loc 'Build selected'}" Click="BuildSelected" IsEnabled="False" ToolTipService.ShowOnDisabled="True" />
                        <Button x:Name="ReloadButton" Content="{l:Loc 'Reload mod'}" Click="Reload" IsEnabled="False" ToolTipService.ShowOnDisabled="True" />
                        <Button x:Name="OpenButton" Content="{l:Loc 'Open folder'}" Click="OpenSelected" IsEnabled="False" />
                        <Button Content="{l:Loc 'Gateway log'}" Click="GatewayLog" />
                    </WrapPanel>
                    <TextBlock x:Name="Hint" DockPanel.Dock="Top" Style="{StaticResource Shell.Secondary}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <CheckBox x:Name="AutoBackup" DockPanel.Dock="Bottom" Content="{l:Loc 'Automatic backup before mod changes'}" Margin="0,6,0,0"
                              Checked="BackupChanged" Unchecked="BackupChanged" />
                    <TextBlock x:Name="CommandHint" DockPanel.Dock="Bottom" Style="{StaticResource Shell.Secondary}" FontSize="11.5" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="Details" TextWrapping="Wrap" />
                    </ScrollViewer>
                </DockPanel>
            </GroupBox>
        </Grid>
    </DockPanel>
</UserControl>
