<UserControl x:Class="Waypoint.ReleasesTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Waypoint">
    <!-- A release install's Versions section: what it runs, and what each release brought. -->
    <DockPanel Margin="20,14,20,16">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="{l:Loc 'Check for updates'}" Click="CheckClicked" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" Content="{l:Loc 'Refresh'}" Click="RefreshClicked" Margin="8,0,0,0" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="Installed" FontSize="15" FontWeight="SemiBold" />
                <TextBlock x:Name="Status" Style="{StaticResource Shell.Secondary}" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>
        <Border DockPanel.Dock="Top" Margin="0,0,0,10" Padding="14,10" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Shell.Border}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{l:Loc 'Set up a new copy…'}" Click="NewCopyClicked" Margin="8,0,0,0" />
                <Button DockPanel.Dock="Right" Content="{l:Loc 'Change folder…'}" Click="ChangeFolderClicked" Margin="8,0,0,0" />
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                           Text="{l:Loc 'Switching branches and pull requests needs a copy of LocalExile with git. This folder is a release. Open a git folder, or set up a new copy.'}" />
            </DockPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="List">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,10" Padding="16,12" CornerRadius="8" BorderThickness="1"
                                Background="{DynamicResource Shell.Panel}" BorderBrush="{DynamicResource Shell.Border}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" VerticalAlignment="Top" Content="{l:Loc 'Open page'}" Click="OpenClicked" Margin="12,0,0,0" />
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Tag}" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Badge}" Foreground="{DynamicResource Shell.Accent}" FontWeight="SemiBold" Margin="10,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Published}" Style="{StaticResource Shell.Secondary}" Margin="0,1,0,6" />
                                    <TextBox Text="{Binding Notes, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
