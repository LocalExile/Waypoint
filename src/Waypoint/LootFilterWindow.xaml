<l:FormWindow x:Class="Waypoint.LootFilterWindow"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:l="clr-namespace:Waypoint"
              Title="{l:Loc 'Loot filter fixer'}" Width="760" Height="600" MinWidth="560" MinHeight="460"
              ShowInTaskbar="True">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource Shell.Secondary}" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="{l:Loc 'Makes a loot filter written for a newer patch, such as FilterBlade\'s and NeverSink\'s 3.30 filters, load in this client. Only the item names and rules the client does not have are taken out; styles, sounds and your FilterBlade changes stay.'}" />

        <DockPanel Grid.Row="1" Margin="0,0,0,6">
            <Button DockPanel.Dock="Right" Click="ChooseFile" Content="{l:Loc 'Other file…'}" />
            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{l:Loc 'Filter'}" />
        </DockPanel>
        <ListBox x:Name="Filters" Grid.Row="2" MinHeight="120" Background="{DynamicResource Shell.Panel}"
                 BorderBrush="{DynamicResource Shell.Border}" BorderThickness="1" />

        <TextBlock Grid.Row="3" FontWeight="SemiBold" Margin="0,14,0,6" Text="{l:Loc 'Saves to (the game reads loot filters only from this folder)'}" />
        <DockPanel Grid.Row="4">
            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Click="OpenFolder" Content="{l:Loc 'Open folder'}" />
            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Click="ChooseFolder" Content="{l:Loc 'Change…'}" />
            <TextBlock x:Name="Folder" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <Button x:Name="ConvertButton" Grid.Row="5" HorizontalAlignment="Left" Margin="0,16,0,0"
                Style="{StaticResource Shell.PrimaryButton}" Click="ConvertClicked" Content="{l:Loc 'Convert'}" />

        <TextBlock x:Name="Result" Grid.Row="6" Margin="0,12,0,0" TextWrapping="Wrap" />
    </Grid>
</l:FormWindow>
