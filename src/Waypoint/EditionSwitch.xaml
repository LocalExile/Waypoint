<UserControl x:Class="Waypoint.EditionSwitch"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Waypoint">
    <UserControl.Resources>
        <!-- One half of the Release | Latest switch. -->
        <Style x:Key="EditionChoice" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Shell.Text}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Body" CornerRadius="3" Padding="18,6" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Background" Value="{DynamicResource Shell.RowHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Body" Property="Background" Value="{DynamicResource Shell.Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource Shell.OnAccent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource Shell.Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <!-- Simple mode's Release | Latest switch (Editions): which LocalExile Play runs. -->
    <StackPanel HorizontalAlignment="Center" Margin="0,0,0,28">
        <Border HorizontalAlignment="Center" Padding="2" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource Shell.Border}">
            <UniformGrid Rows="1">
                <RadioButton x:Name="ReleaseChoice" GroupName="Edition" Content="{l:Loc 'Release'}" Style="{StaticResource EditionChoice}" Click="Chosen"
                             ToolTip="{l:Loc 'The published release of LocalExile, updated when you accept a new one.'}" />
                <RadioButton x:Name="LatestChoice" GroupName="Edition" Content="{l:Loc 'Latest'}" Style="{StaticResource EditionChoice}" Click="Chosen"
                             ToolTip="{l:Loc 'LocalExile as it is being made: the newest changes, from its source, in Advanced mode.'}" />
            </UniformGrid>
        </Border>
        <TextBlock x:Name="Caption" Style="{StaticResource Shell.Secondary}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" />
        <!-- A copy on the tested version: the way onto the newest changes. -->
        <Button x:Name="NewestLink" Content="{l:Loc 'Get the newest changes'}" Click="NewestClicked" Visibility="Collapsed" HorizontalAlignment="Center"
                Margin="0,4,0,0" Cursor="Hand" Foreground="{DynamicResource Shell.Accent}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter />
                </ControlTemplate>
            </Button.Template>
        </Button>
    </StackPanel>
</UserControl>
