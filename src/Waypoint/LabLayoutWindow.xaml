<l:FormWindow x:Class="Waypoint.LabLayoutWindow"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
              xmlns:l="clr-namespace:Waypoint"
              Title="{l:Loc 'Lab layout'}" Width="1280" Height="640" MinWidth="900" MinHeight="460"
              ShowInTaskbar="True">
    <l:FormWindow.Resources>
        <Style x:Key="Lab.Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Shell.TextSecondary}" />
            <Setter Property="Margin" Value="0,12,0,4" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
    </l:FormWindow.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>

        <!-- The day and the tier. -->
        <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,10">
            <StackPanel x:Name="DayControls" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource Shell.IconButton}" Click="PreviousDay" ToolTip="{l:Loc 'Previous day'}"><md:PackIcon Kind="ChevronLeft" Width="20" Height="20" /></Button>
                <DatePicker x:Name="Day" Width="130" Margin="4,0" VerticalAlignment="Center" SelectedDateChanged="DayChanged" />
                <Button Style="{StaticResource Shell.IconButton}" Click="NextDay" ToolTip="{l:Loc 'Next day'}"><md:PackIcon Kind="ChevronRight" Width="20" Height="20" /></Button>
                <Button x:Name="TodayButton" Margin="8,0,0,0" VerticalAlignment="Center" Click="TodayClicked" Content="{l:Loc 'Today'}" />
            </StackPanel>
            <TabControl x:Name="Tiers" SelectionChanged="TierChanged" VerticalAlignment="Center">
                <TabItem Header="{l:Loc 'Normal'}" />
                <TabItem Header="{l:Loc 'Cruel'}" />
                <TabItem Header="{l:Loc 'Merciless'}" />
                <TabItem Header="{l:Loc 'Eternal'}" />
            </TabControl>
        </DockPanel>

        <!-- The map. -->
        <Border Grid.Row="1" CornerRadius="8" BorderThickness="1" Background="{DynamicResource Shell.Panel}" BorderBrush="{DynamicResource Shell.Border}"
                Padding="4">
            <Grid>
                <!-- The wheel zooms at the pointer, a drag moves the map, a double-click or Fit fits it again. -->
                <Border x:Name="MapHost" ClipToBounds="True" Background="Transparent" SizeChanged="MapHostSizeChanged"
                        MouseWheel="MapWheel" MouseLeftButtonDown="MapPress" MouseMove="MapDrag" MouseLeftButtonUp="MapRelease">
                    <Canvas x:Name="Map" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Canvas.RenderTransform><MatrixTransform x:Name="MapView" /></Canvas.RenderTransform>
                    </Canvas>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource Shell.IconButton}" Click="ZoomInClicked" ToolTip="{l:Loc 'Zoom in'}"><md:PackIcon Kind="MagnifyPlusOutline" Width="18" Height="18" /></Button>
                    <Button Style="{StaticResource Shell.IconButton}" Click="ZoomOutClicked" ToolTip="{l:Loc 'Zoom out'}"><md:PackIcon Kind="MagnifyMinusOutline" Width="18" Height="18" /></Button>
                    <Button Style="{StaticResource Shell.IconButton}" Click="FitClicked" ToolTip="{l:Loc 'Fit the map'}"><md:PackIcon Kind="FitToScreenOutline" Width="18" Height="18" /></Button>
                </StackPanel>
                <StackPanel x:Name="Busy" Visibility="Collapsed" IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <md:PackIcon Kind="Loading" Width="38" Height="38" Foreground="{DynamicResource Shell.Accent}" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <md:PackIcon.RenderTransform><RotateTransform x:Name="SpinnerRotation" /></md:PackIcon.RenderTransform>
                        <md:PackIcon.Triggers><EventTrigger RoutedEvent="FrameworkElement.Loaded"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="SpinnerRotation" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever" /></Storyboard></BeginStoryboard></EventTrigger></md:PackIcon.Triggers>
                    </md:PackIcon>
                </StackPanel>
                <TextBlock x:Name="Problem" Visibility="Collapsed" MaxWidth="520" VerticalAlignment="Center" HorizontalAlignment="Center"
                           TextAlignment="Center" Foreground="{DynamicResource Shell.Error}" />
            </Grid>
        </Border>

        <!-- What the day holds, as poelab.com's notes. -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" Margin="12,0,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock x:Name="TierTitle" FontSize="15" FontWeight="SemiBold" />
                <TextBlock x:Name="DayText" Style="{StaticResource Shell.Secondary}" Margin="0,2,0,0" />
                <TextBlock x:Name="ResetText" Style="{StaticResource Shell.Secondary}" Margin="0,2,0,0" />
                <StackPanel x:Name="Notes" />
            </StackPanel>
        </ScrollViewer>

        <!-- The legend: what each mark means. -->
        <WrapPanel x:Name="Legend" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0" />
    </Grid>
</l:FormWindow>
