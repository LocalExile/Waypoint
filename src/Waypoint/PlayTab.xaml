<UserControl x:Class="Waypoint.PlayTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Waypoint">
    <UserControl.Resources>
        <!-- A quiet action: reads as a link, and takes the keyboard as a button does. -->
        <Style x:Key="QuietLink" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Shell.Accent}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <!-- Simple mode's home: one sentence, one button. Everything else appears only when there is something to say. -->
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
            <l:EditionSwitch x:Name="Edition" />
            <!-- Latest behind LocalExile's main: how far, and the update without waiting for tomorrow's Play. -->
            <StackPanel x:Name="BehindPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,-16,0,24" Visibility="Collapsed">
                <TextBlock x:Name="BehindText" Style="{StaticResource Shell.Secondary}" Margin="0,0,10,0" />
                <Button x:Name="UpdateNowLink" Style="{StaticResource QuietLink}" Visibility="Visible" Content="{l:Loc 'Update now'}" Click="UpdateNowClicked" />
            </StackPanel>
            <l:ProfilePicker x:Name="Profile" />
            <TextBlock x:Name="Headline" FontSize="24" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,24" />
            <Button x:Name="MainButton" Style="{StaticResource Shell.PrimaryButton}" Click="MainClicked" HorizontalAlignment="Center"
                    Height="52" MinWidth="200" Padding="40,0" Margin="0" FontSize="18" />
            <ProgressBar x:Name="Working" Height="4" Width="260" IsIndeterminate="True" Visibility="Collapsed" />
            <TextBlock x:Name="Note" Style="{StaticResource Shell.Secondary}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,18,0,0" Visibility="Collapsed" />
            <Button x:Name="DetailsLink" Style="{StaticResource QuietLink}" Content="{l:Loc 'See what happened'}" Margin="0,8,0,0" Click="DetailsClicked" />
            <Button x:Name="StopLink" Style="{StaticResource QuietLink}" Content="{l:Loc 'Stop playing'}" Margin="0,18,0,0" Click="StopClicked" />
            <Button x:Name="GoBackLink" Style="{StaticResource QuietLink}" Content="{l:Loc 'Go back to the version you had'}" Margin="0,18,0,0" Click="GoBackClicked" />
            <Border x:Name="RemoveOldCard" Visibility="Collapsed" Margin="0,18,0,0" Padding="14,10" CornerRadius="6" BorderThickness="1"
                    Background="{DynamicResource Shell.Panel}" BorderBrush="{DynamicResource Shell.Border}">
                <StackPanel>
                    <TextBlock x:Name="RemoveOldText" TextAlignment="Center" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Button Content="{l:Loc 'Delete the old one…'}" Click="RemoveOldClicked" Margin="0,0,8,0" />
                        <Button Content="{l:Loc 'Keep it'}" Click="KeepOldClicked" Margin="0" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <!-- Simple mode on a source copy: in place of Play, the release or Advanced mode (Editions.MustChoose). -->
            <Border x:Name="LatestCard" Visibility="Collapsed" Margin="0,18,0,0" Padding="14,10" CornerRadius="6" BorderThickness="1"
                    Background="{DynamicResource Shell.Panel}" BorderBrush="{DynamicResource Shell.Border}">
                <StackPanel>
                    <TextBlock TextAlignment="Center" TextWrapping="Wrap"
                               Text="{l:Loc 'This folder is Latest: LocalExile\'s newest changes, from its source. Switch to the release to keep Simple mode, or use Advanced mode to play this copy and pick branches and pull requests.'}" />
                    <WrapPanel HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Button Content="{l:Loc 'Switch to the release…'}" Click="GuideReleaseClicked" Margin="0,0,8,6"
                                ToolTip="{l:Loc 'Sets up or opens LocalExile\'s published release. It has its own characters; the ones you have here stay in this folder.'}" />
                        <Button Content="{l:Loc 'Use Advanced mode'}" Click="GuideAdvancedClicked" Margin="0,0,0,6"
                                ToolTip="{l:Loc 'Turns on Developer Mode and Advanced mode: every section, with branches and pull requests under Versions. Waypoint then no longer updates LocalExile by itself.'}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
            <l:SettingsOffer x:Name="Offer" />
            <TextBlock x:Name="FolderText" Style="{StaticResource Shell.Secondary}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,24,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                <Button Style="{StaticResource QuietLink}" Visibility="Visible" Content="{l:Loc 'Change folder…'}" Margin="0,0,16,0" Click="ChangeFolderClicked" />
                <Button Style="{StaticResource QuietLink}" Visibility="Visible" Content="{l:Loc 'Set up a new copy…'}" Click="NewCopyClicked"
                        ToolTip="{l:Loc 'Clones LocalExile with git into a folder you choose and sets it up, for branches and pull requests'}" />
            </StackPanel>
            <Button x:Name="RunSetupLink" Style="{StaticResource QuietLink}" Visibility="Visible" FontSize="12.5" Margin="0,10,0,0"
                    Content="{l:Loc 'Run setup guide…'}" Click="RunSetupClicked" ToolTipService.ShowOnDisabled="True"
                    ToolTip="{l:Loc 'Recheck requirements and refresh this setup, including client preparation. Close the game and stop servers first.'}" />
        </StackPanel>
    </Grid>
</UserControl>
