<UserControl x:Class="Waypoint.ControlTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:l="clr-namespace:Waypoint">
    <DockPanel>
        <!-- The toolbar: live.ps1's switches on the left, everything at once on the right. Disabled while live.ps1 runs. -->
        <Border x:Name="Toolbar" DockPanel.Dock="Top" Padding="20,10,14,4" BorderBrush="{DynamicResource Shell.Border}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Click="StopAll" ToolTip="{l:Loc 'live.ps1 -Stop and the dev host: the game, the walk-map recorder, the servers and the account service'}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Stop" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource Shell.Error}" />
                            <TextBlock Text="{l:Loc 'Stop all'}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="StopServersButton" Click="StopServers" ToolTip="{l:Loc 'live.ps1 -Stop -NoClient: the servers and the walk-map recorder; the client stays (back at the login screen)'}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Stop" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource Shell.Error}" />
                            <TextBlock Text="{l:Loc 'Stop servers'}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="StartServersButton" Click="StartServers">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon x:Name="StartServersIcon" Kind="Play" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center"
                                         Foreground="{DynamicResource Shell.Good}" />
                            <TextBlock x:Name="StartServersText" Text="{l:Loc 'Start servers'}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="PlayButton" Style="{StaticResource Shell.PrimaryButton}" Click="Play" Margin="0,0,0,6"
                            ToolTip="{l:Loc 'live.ps1: builds and starts the servers, then the game (closes a running one)'}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Play" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{l:Loc 'Play'}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <WrapPanel x:Name="RunOptions" VerticalAlignment="Center">
                    <CheckBox x:Name="HotReload" Content="{l:Loc 'Hot reload'}"
                              ToolTip="{l:Loc 'The Gateway runs under dotnet watch, so saved code edits apply with the game still running; off passes -NoHotReload'}" />
                    <CheckBox x:Name="NoBuild" Content="{l:Loc 'Skip build'}" ToolTip="-NoBuild" />
                    <CheckBox x:Name="NoExtract" Content="{l:Loc 'Skip data check'}" ToolTip="-NoExtract" />
                    <CheckBox x:Name="Walkmaps" Content="{l:Loc 'Walk maps'}" ToolTip="{l:Loc '-Walkmaps: capture each area\'s walk map with Frida (GettingStarted step 9)'}" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- Below the table: live.ps1's output and the setup checks. -->
        <Grid DockPanel.Dock="Bottom" Height="230" Margin="20,8,20,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <GroupBox Header="{l:Loc 'live.ps1 output'}" Margin="0" Padding="0">
                <DockPanel Background="{DynamicResource Shell.Panel}">
                    <DockPanel DockPanel.Dock="Top" Margin="10,6,6,0">
                        <Button DockPanel.Dock="Right" Content="{l:Loc 'Clear'}" Click="ClearOutput" Height="24" Padding="10,0" Margin="0" />
                        <TextBlock x:Name="RunState" Text="{l:Loc 'Ready.'}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <TextBox x:Name="Output" IsReadOnly="True" FontFamily="{StaticResource Mono}" FontSize="12" Margin="8,2,8,6"
                             BorderThickness="0" md:TextFieldAssist.DecorationVisibility="Hidden" Background="Transparent"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
                </DockPanel>
            </GroupBox>
            <GroupBox Grid.Column="2" Header="{l:Loc 'Setup'}" Margin="0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="{l:Loc 'Change…'}" Click="ChangeServer" Height="24" Padding="10,0" Margin="6,0,0,0"
                                ToolTip="{l:Loc 'Pick another LocalExile server checkout; the launcher starts again on it'}" />
                        <TextBlock Text="{l:Loc 'Server  '}" Style="{StaticResource Shell.Secondary}" />
                        <TextBlock x:Name="ServerFolder" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,-6">
                        <Button Content="{l:Loc 'Guided setup'}" Click="OpenGuidedSetup" Height="26" Padding="10,0"
                                ToolTip="{l:Loc 'The Setup section: every requirement with its next step'}" />
                        <Button Content="{l:Loc 'Set up a new copy…'}" Click="NewCopyClicked" Height="26" Padding="10,0"
                                ToolTip="{l:Loc 'Clones LocalExile with git into a folder you choose and sets it up, for branches and pull requests'}" />
                        <Button x:Name="CheckAgainButton" Content="{l:Loc 'Check again'}" Click="CheckSetup" Height="26" Padding="10,0" />
                        <Button x:Name="GameDataButton" Content="{l:Loc 'Game data'}" Click="CheckData" Height="26" Padding="10,0"
                                ToolTip="{l:Loc 'extract-data.ps1 -List: which extracted files are missing or stale'}" />
                        <Button Content="{l:Loc 'Logs folder'}" Click="OpenLogs" Height="26" Padding="10,0" />
                    </WrapPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="SetupList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,1">
                                        <md:PackIcon Kind="{Binding Icon}" Foreground="{Binding Brush}" Width="15" Height="15" Margin="0,1,6,0" />
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" ToolTip="{Binding Hint}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </GroupBox>
        </Grid>

        <!-- The services as a table: one row each, with one Start/Stop button that follows its state. -->
        <Grid Margin="20,4,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Height="34" Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="240" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="122" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{l:Loc 'SERVICE'}" Style="{StaticResource Shell.ColumnHeader}" />
                <TextBlock Grid.Column="1" Text="{l:Loc 'STATUS'}" Style="{StaticResource Shell.ColumnHeader}" />
                <TextBlock Grid.Column="2" Text="{l:Loc 'PORTS'}" Style="{StaticResource Shell.ColumnHeader}" />
                <TextBlock Grid.Column="3" Text="PID" Style="{StaticResource Shell.ColumnHeader}" />
                <TextBlock Grid.Column="4" Text="{l:Loc 'UPTIME'}" Style="{StaticResource Shell.ColumnHeader}" />
                <TextBlock Grid.Column="5" Text="{l:Loc 'CPU'}" Style="{StaticResource Shell.ColumnHeader}" />
                <TextBlock Grid.Column="6" Text="{l:Loc 'MEMORY'}" Style="{StaticResource Shell.ColumnHeader}" />
            </Grid>
            <ListBox x:Name="ServiceList" Grid.Row="1" Style="{StaticResource Shell.Table}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="240" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="122" />
                            </Grid.ColumnDefinitions>
                            <DockPanel ToolTip="{Binding Description}" Margin="0,0,12,0">
                                <md:PackIcon DockPanel.Dock="Left" Kind="{Binding Icon}" Width="17" Height="17" Margin="0,0,10,0" VerticalAlignment="Center"
                                             Foreground="{DynamicResource Shell.TextSecondary}" />
                                <TextBlock DockPanel.Dock="Left" Text="{Binding DisplayName}" Style="{StaticResource Shell.Cell}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Description}" Style="{StaticResource Shell.Cell}" Margin="10,0,0,0"
                                           Foreground="{DynamicResource Shell.TextSecondary}" />
                            </DockPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" ToolTip="{Binding StateTip}">
                                <Ellipse Width="8" Height="8" Fill="{Binding Lamp}" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding State}" Style="{StaticResource Shell.Cell}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Ports}" Style="{StaticResource Shell.Cell}" />
                            <TextBlock Grid.Column="3" Text="{Binding Pid}" Style="{StaticResource Shell.Cell}" />
                            <TextBlock Grid.Column="4" Text="{Binding Uptime}" Style="{StaticResource Shell.Cell}" />
                            <TextBlock Grid.Column="5" Text="{Binding Cpu}" Style="{StaticResource Shell.Cell}" />
                            <TextBlock Grid.Column="6" Text="{Binding Memory}" Style="{StaticResource Shell.Cell}" />
                            <StackPanel Grid.Column="7" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Width="84" Height="28" Margin="0" Click="Toggle" IsEnabled="{Binding CanAct}" Visibility="{Binding ActionShown}" ToolTip="{Binding ActionTip}"
                                        ToolTipService.ShowOnDisabled="True">
                                    <StackPanel Orientation="Horizontal">
                                        <md:PackIcon Kind="{Binding ActionIcon}" Width="14" Height="14" Margin="0,0,5,0"
                                                     VerticalAlignment="Center" Foreground="{Binding ActionBrush}" />
                                        <TextBlock Text="{Binding ActionText}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Shell.IconButton}" Width="28" Height="28" Margin="4,0,0,0" Click="RowMenu"
                                        ToolTip="{l:Loc 'More: restart, log'}">
                                    <md:PackIcon Kind="DotsVertical" Width="16" Height="16" />
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{l:Loc 'Restart'}" Click="RestartRow" IsEnabled="{Binding CanRestart}" />
                                            <MenuItem Header="{l:Loc 'Show log'}" Click="ShowRowLog" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DockPanel>
</UserControl>
