<UserControl x:Class="Waypoint.PerformanceTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Waypoint">
    <DockPanel Margin="20,12,20,12">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <TextBlock Text="{l:Loc 'Window'}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="WindowPicker" Width="90" SelectionChanged="WindowChanged" Margin="0,0,20,0">
                <ComboBoxItem Content="{l:Loc '1 min'}" Tag="60" />
                <ComboBoxItem Content="{l:Loc '5 min'}" Tag="300" IsSelected="True" />
                <ComboBoxItem Content="{l:Loc '15 min'}" Tag="900" />
                <ComboBoxItem Content="{l:Loc '60 min'}" Tag="3600" />
            </ComboBox>
            <TextBlock Text="{l:Loc '.NET counters of'}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="Server" Width="110" SelectionChanged="ServerChanged" Margin="0,0,12,0" />
            <TextBlock x:Name="CounterState" VerticalAlignment="Center" Foreground="{DynamicResource Shell.TextSecondary}" />
        </WrapPanel>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <l:LineChart x:Name="CpuChart" Title="{l:Loc 'CPU'}" Unit="{l:Loc '% of the machine'}" Margin="4" />
            <l:LineChart x:Name="MemoryChart" Grid.Column="1" Title="{l:Loc 'Memory'}" Unit="{l:Loc 'MB, working set'}" Format="0" Margin="4" />
            <l:LineChart x:Name="HeapChart" Grid.Row="1" Title="{l:Loc 'GC heap and allocation'}" Unit="{l:Loc 'MB, MB/s'}" Margin="4" />
            <l:LineChart x:Name="GcChart" Grid.Row="1" Grid.Column="1" Title="GC" Unit="{l:Loc 'collections/s, % time'}" Margin="4" />
            <l:LineChart x:Name="PoolChart" Grid.Row="2" Title="{l:Loc 'Thread pool'}" Unit="{l:Loc 'threads, queued work items'}" Format="0" Margin="4" />
            <l:LineChart x:Name="ContentionChart" Grid.Row="2" Grid.Column="1" Title="{l:Loc 'Contention and exceptions'}" Unit="{l:Loc 'per s'}" Format="0" Margin="4" />
        </Grid>
    </DockPanel>
</UserControl>
