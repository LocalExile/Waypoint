<UserControl x:Class="Waypoint.ToolsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:l="clr-namespace:Waypoint">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,16,20,16">
            <WrapPanel>
                <Border Width="340" Margin="0,0,14,14" Padding="18,16" CornerRadius="8" BorderThickness="1"
                        Background="{DynamicResource Shell.Panel}" BorderBrush="{DynamicResource Shell.Border}">
                    <DockPanel>
                        <Button x:Name="MapButton" DockPanel.Dock="Bottom" HorizontalAlignment="Left" Style="{StaticResource Shell.PrimaryButton}"
                                Click="OpenMapViewer" Content="{l:Loc 'Open map viewer'}" Margin="0,12,0,0" />
                        <md:PackIcon DockPanel.Dock="Left" Kind="MapOutline" Width="36" Height="36" Margin="0,0,14,0" VerticalAlignment="Top"
                                     Foreground="{DynamicResource Shell.Accent}" />
                        <StackPanel>
                            <TextBlock Text="{l:Loc 'Map viewer'}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Shell.Secondary}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="{l:Loc 'Inspect generated maps, tiles, walkability and points of interest.'}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <!-- One card per tool. -->
                <Border Width="340" Margin="0,0,14,14" Padding="18,16" CornerRadius="8" BorderThickness="1"
                        Background="{DynamicResource Shell.Panel}" BorderBrush="{DynamicResource Shell.Border}">
                    <DockPanel>
                        <Button x:Name="CrafterButton" DockPanel.Dock="Bottom" HorizontalAlignment="Left" Style="{StaticResource Shell.PrimaryButton}" Click="OpenItemCrafter"
                                Content="{l:Loc 'Open item crafter'}" Margin="0,12,0,0" />
                        <md:PackIcon DockPanel.Dock="Left" Kind="Anvil" Width="36" Height="36" Margin="0,0,14,0" VerticalAlignment="Top"
                                     Foreground="{DynamicResource Shell.Accent}" />
                        <StackPanel>
                            <TextBlock Text="{l:Loc 'Item crafter'}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Shell.Secondary}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="{l:Loc 'Make any item: a base, its rarity, modifiers with their values, sockets and influences. Save it to come back to it, and give it to the character in game.'}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Width="340" Margin="0,0,14,14" Padding="18,16" CornerRadius="8" BorderThickness="1"
                        Background="{DynamicResource Shell.Panel}" BorderBrush="{DynamicResource Shell.Border}">
                    <DockPanel>
                        <Button DockPanel.Dock="Bottom" HorizontalAlignment="Left" Style="{StaticResource Shell.PrimaryButton}" Click="OpenLabLayout"
                                Content="{l:Loc 'Open lab layout'}" Margin="0,12,0,0" />
                        <md:PackIcon DockPanel.Dock="Left" Kind="Sitemap" Width="36" Height="36" Margin="0,0,14,0" VerticalAlignment="Top"
                                     Foreground="{DynamicResource Shell.Accent}" />
                        <StackPanel>
                            <TextBlock Text="{l:Loc 'Lab layout'}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Shell.Secondary}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="{l:Loc 'The day\'s Labyrinth of every tier as a map: its rooms, the shortest way to Izaro, gauntlets, puzzles, Darkshrines, keys and doors.'}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <!-- Simple mode's list has neither Console nor Logs: they open from here. Advanced mode lists both. -->
                <Border x:Name="ConsoleCard" Visibility="Collapsed" Width="340" Margin="0,0,14,14" Padding="18,16" CornerRadius="8" BorderThickness="1"
                        Background="{DynamicResource Shell.Panel}" BorderBrush="{DynamicResource Shell.Border}">
                    <DockPanel>
                        <Button DockPanel.Dock="Bottom" HorizontalAlignment="Left" Click="OpenConsole" Content="{l:Loc 'Open console'}" Margin="0,12,0,0" />
                        <md:PackIcon DockPanel.Dock="Left" Kind="Console" Width="36" Height="36" Margin="0,0,14,0" VerticalAlignment="Top"
                                     Foreground="{DynamicResource Shell.Accent}" />
                        <StackPanel>
                            <TextBlock Text="{l:Loc 'Console'}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Shell.Secondary}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="{l:Loc 'Look up the server\'s commands and use one in the game.'}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border x:Name="LogsCard" Visibility="Collapsed" Width="340" Margin="0,0,14,14" Padding="18,16" CornerRadius="8" BorderThickness="1"
                        Background="{DynamicResource Shell.Panel}" BorderBrush="{DynamicResource Shell.Border}">
                    <DockPanel>
                        <Button DockPanel.Dock="Bottom" HorizontalAlignment="Left" Click="OpenLogs" Content="{l:Loc 'Open logs'}" Margin="0,12,0,0" />
                        <md:PackIcon DockPanel.Dock="Left" Kind="TextBoxOutline" Width="36" Height="36" Margin="0,0,14,0" VerticalAlignment="Top"
                                     Foreground="{DynamicResource Shell.Accent}" />
                        <StackPanel>
                            <TextBlock Text="{l:Loc 'Logs'}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Shell.Secondary}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="{l:Loc 'What Waypoint, the servers and the game wrote down: where to look when something went wrong.'}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
