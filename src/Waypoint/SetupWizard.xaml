<l:FormWindow x:Class="Waypoint.SetupWizard"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
              xmlns:l="clr-namespace:Waypoint">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- The steps of the guide, with where the player is. -->
        <Border Background="{DynamicResource Shell.Sidebar}" Padding="16,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,18">
                    <Image Source="{DynamicResource BrandArtwork}" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Waypoint" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource Shell.SidebarStrong}" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel x:Name="Rail" />
            </DockPanel>
        </Border>

        <DockPanel Grid.Column="1" Margin="24,12,24,16">
            <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <Button x:Name="SkipButton" DockPanel.Dock="Left" Content="{l:Loc 'Skip setup'}" Click="SkipClicked" Margin="0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BackButton" Content="{l:Loc 'Back'}" Click="BackClicked" Margin="0,0,6,0" />
                    <Button x:Name="NextButton" Style="{StaticResource Shell.PrimaryButton}" Content="{l:Loc 'Next'}" Click="NextClicked" Margin="0" />
                </StackPanel>
            </DockPanel>

            <Grid>
                <!-- Welcome -->
                <StackPanel x:Name="WelcomePage">
                    <TextBlock Text="{l:Loc 'Welcome to Waypoint'}" FontSize="{DynamicResource Font22}" FontWeight="SemiBold" />
                    <TextBlock Text="{l:Loc 'This guide gets LocalExile ready to play. It looks for what you already have, and asks before it downloads or copies anything.'}"
                               Margin="0,10,0,14" />
                    <TextBlock Text="{l:Loc '1.  Gets LocalExile to a folder you choose, or finds the copy you have'}" Margin="0,0,0,6" />
                    <TextBlock Text="{l:Loc '2.  Finds your game client, or lets you point to it'}" Margin="0,0,0,6" />
                    <TextBlock Text="{l:Loc '3.  Copies the client and prepares it'}" Margin="0,0,0,14" />
                    <TextBlock Text="{l:Loc 'You can stop at any point: what is finished stays finished, and the guide continues from there next time. Setup never changes your own Path of Exile install.'}"
                               Style="{StaticResource Caption}" />
                    <TextBlock Text="{l:Loc 'Waypoint does not download the game. You need your own standalone copy of Path of Exile 3.29.3b.'}"
                               Style="{StaticResource Caption}" Margin="0,8,0,0" />
                </StackPanel>

                <!-- Which LocalExile: the release, or a source checkout -->
                <StackPanel x:Name="SourcePage" Visibility="Collapsed">
                    <TextBlock Text="{l:Loc 'How do you want LocalExile?'}" FontSize="{DynamicResource Font18}" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <RadioButton x:Name="ReleaseChoice" GroupName="Source" Style="{StaticResource ChoiceRadio}" Content="{l:Loc 'The ready-to-play release (recommended)'}" Checked="SourceChanged" />
                    <TextBlock Text="{l:Loc 'Nothing else to install. Waypoint tells you when a newer release is out and installs it for you.'}" Style="{StaticResource Caption}" Margin="27,0,0,14" />
                    <RadioButton x:Name="SourceChoice" GroupName="Source" Style="{StaticResource ChoiceRadio}" Content="{l:Loc 'The source code, for working on LocalExile'}" Checked="SourceChanged" />
                    <TextBlock Text="{l:Loc 'Needs .NET, Git, Python and Node. Adds branches, pull requests, mods, accounts and the console.'}" Style="{StaticResource Caption}" Margin="27,0,0,0" />
                </StackPanel>

                <!-- Where the release goes -->
                <StackPanel x:Name="InstallPage" Visibility="Collapsed">
                    <TextBlock Text="{l:Loc 'Where should LocalExile go?'}" FontSize="{DynamicResource Font18}" FontWeight="SemiBold" />
                    <TextBlock Text="{l:Loc 'Choose a new or empty folder, or a release you already installed. Your game client is copied here too.'}" Margin="0,6,0,10" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{l:Loc 'Choose…'}" Click="ChooseInstallFolder" Margin="8,0,0,0" />
                        <TextBox x:Name="InstallFolder" TextChanged="InstallFolderChanged" />
                    </DockPanel>
                    <TextBlock x:Name="InstallNote" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Requirements -->
                <DockPanel x:Name="RequirementsPage" Visibility="Collapsed">
                    <TextBlock DockPanel.Dock="Top" Text="{l:Loc 'Tools LocalExile needs'}" FontSize="{DynamicResource Font18}" FontWeight="SemiBold" />
                    <TextBlock DockPanel.Dock="Top" x:Name="RequirementsStatus" Margin="0,6,0,10" />
                    <Button DockPanel.Dock="Bottom" Content="{l:Loc 'Check again'}" Click="CheckRequirements" HorizontalAlignment="Left" Margin="0,8,0,0" />
                    <ItemsControl x:Name="RequirementList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,10">
                                    <md:PackIcon DockPanel.Dock="Left" Kind="{Binding Icon}" Foreground="{Binding Brush}" Width="18" Height="18" Margin="0,2,10,0" />
                                    <Button DockPanel.Dock="Right" Content="{Binding Action}" Visibility="{Binding ActionShown}" Click="GetRequirement" Margin="10,0,0,0" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>

                <!-- The checkout -->
                <DockPanel x:Name="CheckoutPage" Visibility="Collapsed">
                    <TextBlock DockPanel.Dock="Top" Text="{l:Loc 'Your LocalExile folder'}" FontSize="{DynamicResource Font18}" FontWeight="SemiBold" />
                    <TextBlock DockPanel.Dock="Top" x:Name="CheckoutStatus" Margin="0,6,0,8" />
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <RadioButton x:Name="DownloadChoice" GroupName="Checkout" Style="{StaticResource ChoiceRadio}" Content="{l:Loc 'Download LocalExile from GitHub into this folder'}"
                                     Checked="CheckoutChoiceChanged" />
                        <DockPanel Margin="27,2,0,0">
                            <Button DockPanel.Dock="Right" Content="{l:Loc 'Choose…'}" Click="ChooseDownloadFolder" Margin="8,0,0,0" />
                            <TextBox x:Name="DownloadFolder" TextChanged="DownloadFolderChanged" />
                        </DockPanel>
                        <TextBlock x:Name="DownloadNote" Style="{StaticResource Caption}" Margin="27,4,0,0" />
                    </StackPanel>
                    <RadioButton DockPanel.Dock="Top" x:Name="ExistingChoice" GroupName="Checkout" Style="{StaticResource ChoiceRadio}" Content="{l:Loc 'Use a LocalExile folder I already have'}"
                                 Checked="CheckoutChoiceChanged" />
                    <Button DockPanel.Dock="Bottom" Content="{l:Loc 'Browse…'}" Click="BrowseCheckout" HorizontalAlignment="Left" Margin="27,6,0,0" />
                    <ListBox x:Name="CheckoutList" Margin="27,4,0,0" SelectionChanged="CheckoutSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,1">
                                    <TextBlock Text="{Binding Root}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <!-- The client -->
                <DockPanel x:Name="ClientPage" Visibility="Collapsed">
                    <TextBlock DockPanel.Dock="Top" Text="{l:Loc 'Your game client'}" FontSize="{DynamicResource Font18}" FontWeight="SemiBold" />
                    <TextBlock DockPanel.Dock="Top" x:Name="ClientStatus" Margin="0,6,0,8" />
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <TextBlock x:Name="ClientNote" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                        <CheckBox x:Name="ShareClient" Visibility="Collapsed" Margin="0,0,0,6" Checked="ShareChanged" Unchecked="ShareChanged" />
                        <CheckBox x:Name="LinkClient" Visibility="Collapsed" Margin="0,0,0,6" Checked="ShareChanged" Unchecked="ShareChanged">
                            <TextBlock TextWrapping="Wrap" Text="{l:Loc 'Use this folder itself instead of a copy. It saves the space, but LocalExile then changes that client.'}" />
                        </CheckBox>
                        <WrapPanel>
                            <Button Content="{l:Loc 'Browse…'}" Click="BrowseClient" />
                            <Button x:Name="SearchAgain" Content="{l:Loc 'Search again'}" Click="SearchClientsClicked" />
                        </WrapPanel>
                        <CheckBox x:Name="NoClient" Content="{l:Loc 'Set up the rest now, and add the client later'}" Checked="NoClientChanged" Unchecked="NoClientChanged" />
                    </StackPanel>
                    <ListBox x:Name="ClientList" SelectionChanged="ClientSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Usable}" Value="False">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,1">
                                    <TextBlock x:Name="Folder" Text="{Binding Folder}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" />
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Usable}" Value="False">
                                        <Setter TargetName="Folder" Property="TextDecorations" Value="Strikethrough" />
                                        <Setter TargetName="Folder" Property="FontWeight" Value="Normal" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <!-- What a player on a release wants done with what they have -->
                <ScrollViewer x:Name="SwitchPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,8,0">
                        <StackPanel x:Name="CharactersChoice">
                            <TextBlock Text="{l:Loc 'Your characters'}" FontSize="{DynamicResource Font18}" FontWeight="SemiBold" />
                            <TextBlock x:Name="OldHolds" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                            <RadioButton x:Name="BringCharacters" GroupName="Characters" Style="{StaticResource ChoiceRadio}" Content="{l:Loc 'Bring my characters (recommended)'}" IsChecked="True" Margin="0,8,0,4" />
                            <TextBlock Text="{l:Loc 'Copies your accounts, characters and stash. Your current LocalExile keeps its own copy.'}" Style="{StaticResource Caption}" Margin="27,0,0,8" />
                            <RadioButton x:Name="NewCharacters" GroupName="Characters" Style="{StaticResource ChoiceRadio}" Content="{l:Loc 'Start with a new database'}" />
                            <TextBlock Text="{l:Loc 'No accounts or characters yet. You create an account at the end.'}" Style="{StaticResource Caption}" Margin="27,0,0,14" />
                        </StackPanel>
                        <TextBlock Text="{l:Loc 'Your current LocalExile'}" FontSize="{DynamicResource Font18}" FontWeight="SemiBold" />
                        <TextBlock x:Name="OldFolder" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        <TextBlock Text="{l:Loc 'Setup installs a new copy of LocalExile that has the item crafter. What should happen to the one you have now?'}" TextWrapping="Wrap" Margin="0,6,0,6" />
                        <RadioButton x:Name="KeepBoth" GroupName="Old" Style="{StaticResource ChoiceRadio}" Content="{l:Loc 'Keep both (recommended)'}" IsChecked="True" />
                        <TextBlock Text="{l:Loc 'You can go back to your current one at any time. Each has its own characters and progress.'}" Style="{StaticResource Caption}" Margin="27,0,0,8" />
                        <RadioButton x:Name="RemoveOldLater" GroupName="Old" Style="{StaticResource ChoiceRadio}" Content="{l:Loc 'Remove the old one later'}" />
                        <TextBlock Text="{l:Loc 'Once the new copy has worked for you, Waypoint will ask before deleting the old one.'}" Style="{StaticResource Caption}" Margin="27,0,0,14" />
                        <StackPanel x:Name="UpdatesChoice">
                            <TextBlock Text="{l:Loc 'Updates'}" FontSize="{DynamicResource Font18}" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <RadioButton x:Name="TestedVersion" GroupName="Updates" Style="{StaticResource ChoiceRadio}" Content="{l:Loc 'Stay on a tested version (recommended)'}" IsChecked="True" />
                            <TextBlock Text="{l:Loc 'A version we have checked. It does not change by itself.'}" Style="{StaticResource Caption}" Margin="27,0,0,8" />
                            <RadioButton x:Name="NewestVersion" GroupName="Updates" Style="{StaticResource ChoiceRadio}" Content="{l:Loc 'Get the newest changes'}" />
                            <TextBlock Text="{l:Loc 'Updates itself each day, and things can break.'}" Style="{StaticResource Caption}" Margin="27,0,0,14" />
                        </StackPanel>
                        <StackPanel x:Name="GiveItemChoice">
                            <TextBlock Text="{l:Loc 'Giving items'}" FontSize="{DynamicResource Font18}" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <CheckBox x:Name="GiveItem" Content="{l:Loc 'Set up Give item (recommended)'}" IsChecked="True" />
                            <TextBlock Text="{l:Loc 'Installs Frida, a tool that talks to the running game. It takes about 180 MB, and some antivirus programs flag it. The game\'s chat box is too short for most items, so Give item needs it.'}"
                                       Style="{StaticResource Caption}" Margin="27,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- The account of a release install -->
                <StackPanel x:Name="AccountPage" Visibility="Collapsed">
                    <TextBlock Text="{l:Loc 'Your local account'}" FontSize="{DynamicResource Font18}" FontWeight="SemiBold" />
                    <TextBlock Text="{l:Loc 'You log in to the game with this. It stays on this PC, so do not reuse a real password.'}" Margin="0,6,0,12" />
                    <TextBlock Text="{l:Loc 'Account name'}" />
                    <TextBox x:Name="AccountName" MaxLength="32" Margin="0,2,0,8" TextChanged="AccountChanged" ToolTip="{l:Loc '3–32 letters, digits, _ or -'}" />
                    <TextBlock Text="{l:Loc 'Password'}" />
                    <PasswordBox x:Name="AccountPassword" MaxLength="1024" Margin="0,2,0,8" PasswordChanged="AccountChanged" ToolTip="{l:Loc 'at least 4 characters'}" />
                    <TextBlock Text="{l:Loc 'Password again'}" />
                    <PasswordBox x:Name="AccountAgain" MaxLength="1024" Margin="0,2,0,8" PasswordChanged="AccountChanged" />
                    <TextBlock x:Name="AccountNote" Style="{StaticResource Caption}" />
                </StackPanel>

                <!-- Setting up -->
                <DockPanel x:Name="RunPage" Visibility="Collapsed">
                    <TextBlock DockPanel.Dock="Top" x:Name="RunTitle" Text="{l:Loc 'Ready to set up'}" FontSize="{DynamicResource Font18}" FontWeight="SemiBold" />
                    <TextBlock DockPanel.Dock="Top" x:Name="RunStatus" Margin="0,6,0,10" />
                    <Expander DockPanel.Dock="Bottom" Header="{l:Loc 'Details'}" Margin="0,8,0,0">
                        <TextBox x:Name="Log" Height="120" IsReadOnly="True" FontFamily="{StaticResource Mono}" FontSize="11.5" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                    </Expander>
                    <ProgressBar DockPanel.Dock="Bottom" x:Name="Progress" Height="4" Margin="0,6,0,0" Visibility="Hidden" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                        <!-- Instead of the steps until Start, for a player leaving a release: what the choices will do. -->
                        <StackPanel x:Name="SwitchSummaryPanel" Visibility="Collapsed">
                            <TextBlock Text="{l:Loc 'What will happen'}" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <ItemsControl x:Name="SwitchSummary">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,7">
                                            <md:PackIcon DockPanel.Dock="Left" Kind="{Binding Icon}" Foreground="{Binding Brush}" Width="18" Height="18" Margin="0,1,10,0" />
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <ItemsControl x:Name="StepList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,9">
                                        <md:PackIcon DockPanel.Dock="Left" Kind="{Binding Icon}" Foreground="{Binding Brush}" Width="18" Height="18" Margin="0,1,10,0" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Visibility="{Binding DetailShown}" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>

                <!-- Done -->
                <StackPanel x:Name="DonePage" Visibility="Collapsed">
                    <TextBlock Text="{l:Loc 'LocalExile is ready'}" FontSize="{DynamicResource Font22}" FontWeight="SemiBold" />
                    <TextBlock x:Name="DoneText" TextWrapping="Wrap" Margin="0,10,0,14" />
                    <CheckBox x:Name="CreateAccount" Content="{l:Loc 'Create my first account next'}" IsChecked="True" />
                </StackPanel>
            </Grid>
        </DockPanel>
    </Grid>
</l:FormWindow>
