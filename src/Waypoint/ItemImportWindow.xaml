<l:FormWindow x:Class="Waypoint.ItemImportWindow"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
              xmlns:l="clr-namespace:Waypoint"
              Title="{l:Loc 'Import item'}" Width="860" Height="720" MinWidth="560" MinHeight="460" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="20,12,20,16">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Shell.Secondary}" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="{l:Loc 'Paste an item copied with Ctrl+C in Path of Building or in the game (Ctrl+Alt+C in the game also gives each modifier and its tier). Below, each line shows what it becomes; the red ones are left out. Click a line to find it in the text.'}" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Right">
            <Button x:Name="AddButton" Style="{StaticResource Shell.PrimaryButton}" Click="AddClicked" IsEnabled="False" Margin="0,0,8,0"
                    AutomationProperties.Name="{l:Loc 'Add'}">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="Plus" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="{l:Loc 'Add'}" />
                </StackPanel>
            </Button>
            <Button Content="{l:Loc 'Cancel'}" IsCancel="True" Margin="0" />
        </StackPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <md:PackIcon x:Name="SummaryIcon" DockPanel.Dock="Left" Kind="InformationOutline" Margin="0,0,8,0" VerticalAlignment="Top" />
            <TextBlock x:Name="Summary" TextWrapping="Wrap" />
        </DockPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" MinHeight="120" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="3*" MinHeight="120" />
            </Grid.RowDefinitions>
            <TextBox x:Name="Source" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12.5"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                     IsInactiveSelectionHighlightEnabled="True" TextChanged="SourceChanged"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="8" md:HintAssist.Hint="{l:Loc 'The item as text'}" />
            <TextBlock Grid.Row="1" Text="{l:Loc 'WHAT EACH LINE BECOMES'}" FontSize="11" FontWeight="SemiBold" Margin="0,12,0,4"
                       Foreground="{DynamicResource Shell.TextSecondary}" />
            <ListBox x:Name="Result" Grid.Row="2" HorizontalContentAlignment="Stretch" SelectionChanged="ResultChosen"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderThickness="1" BorderBrush="{DynamicResource Shell.Border}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{Binding Back}" CornerRadius="3" Padding="6,2">
                            <DockPanel>
                                <md:PackIcon DockPanel.Dock="Left" Kind="{Binding Icon}" Foreground="{Binding Brush}" Width="16" Height="16"
                                             Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Number}" Width="30" FontFamily="Consolas" FontSize="11.5"
                                           Foreground="{DynamicResource Shell.TextSecondary}" VerticalAlignment="Center" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Note}" Foreground="{Binding Brush}" MaxWidth="340" FontSize="11.5"
                                           Margin="12,0,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" ToolTip="{Binding Note}" />
                                <TextBlock Text="{Binding Text}" FontFamily="Consolas" FontSize="12" Opacity="{Binding Opacity}" TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap" VerticalAlignment="Center" ToolTip="{Binding Text}" />
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DockPanel>
</l:FormWindow>
